//! Tests for std.net. These open real sockets, but only ever on loopback and only
//! ever on an OS-assigned port (bind to `:0`, read the real port back with
//! `local_addr`), so they need no network and can't collide with a parallel run.
//! The one exception is the live TLS smoke at the bottom, which is off unless
//! `THERA_NET_TESTS` is set.

import std.testing;
import std.env;
import std.io;
import std.fiber;

import 'net' as _;

/// A listener on loopback, on an OS-assigned port. Dial it at `local_addr()`.
fn loopback() -> Result<net.TcpListener, Error> {
    return Result.Ok(net.listen('127.0.0.1:0')?);
}

@test
fn connect_and_echo() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    // The server half: accept one connection, echo what it sends, then close.
    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        let got = conn.read(max: 64)?;
        io.write_all(to: conn, got)?;
        conn.close()?;
        return Result.Ok(void);
    });

    let client = net.connect('127.0.0.1', port_of(addr)?)?;
    io.write_all(to: client, 'ping'.bytes())?;
    let echoed = io.read_all(client)?;
    testing.assert_eq(actual: echoed.to_string()?, expected: 'ping')?;

    client.close()?;
    server.join()?;
    listener.close()?;
    return Result.Ok(void);
}

/// The read half sees EOF (an empty read) once the peer closes — the normal end of
/// a stream, not an error.
@test
fn read_returns_empty_at_eof() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        conn.close()?; // close immediately, without sending
        return Result.Ok(void);
    });

    let client = net.connect_addr(addr)?;
    let got = io.read_all(client)?;
    testing.assert_eq(actual: got.len(), expected: 0)?;

    client.close()?;
    server.join()?;
    listener.close()?;
    return Result.Ok(void);
}

/// The point of parking on readiness rather than blocking the thread: many
/// connections are in flight at once over a single OS thread. With a blocking
/// accept on the four-thread worker pool, this would deadlock.
@test
fn many_concurrent_connections() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    let count = 20;

    let server = fiber.spawn(() => {
        let mut accepted = 0;
        while accepted < count {
            let conn = listener.accept()?;
            // One fiber per connection — the shape `std.http.server` will use.
            fiber.spawn(() => {
                let got = conn.read(max: 64)?;
                io.write_all(to: conn, got)?;
                return conn.close();
            });
            accepted = accepted + 1;
        }
        return Result.Ok(void);
    });

    let mut clients = [];
    for i in 0..count {
        let c = net.connect_addr(addr)?;
        io.write_all(to: c, ('hello ' + i.to_string()).bytes())?;
        clients.push(c);
    }
    for p in clients.enumerate() {
        let reply = p.value.read(max: 64)?;
        testing.assert_eq(actual: reply.to_string()?, expected: 'hello ' + p.index.to_string())?;
        p.value.close()?;
    }

    server.join()?;
    listener.close()?;
    return Result.Ok(void);
}

/// A short write must not lose the tail: push far more than a send buffer holds and
/// read it all back. This is what `io.write_all`'s loop exists for, and it also
/// drives `socket_write`'s park path — the payload has to outrun the buffer by
/// enough that the writer blocks, not merely writes short (macOS auto-tunes
/// loopback buffers into the hundreds of KB, so 400 KB was not enough).
///
/// The payload is periodic rather than uniform so that a chunk delivered out of
/// order, or twice, changes the bytes and not just the length.
@test
fn large_transfer_survives_short_writes() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    let payload = 'abcdefghij'.repeat(400000); // 4 MB

    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        io.write_all(to: conn, payload.bytes())?;
        return conn.close();
    });

    let client = net.connect_addr(addr)?;
    let got = io.read_all(client)?;
    testing.assert_eq(actual: got.len(), expected: payload.len())?;
    testing.assert_eq(actual: got.to_string()?, expected: payload)?;

    client.close()?;
    server.join()?;
    listener.close()?;
    return Result.Ok(void);
}

@test
fn connect_to_a_closed_port_is_refused() -> Result<Void, Error> {
    // Bind then immediately close, so the port is real but unserved.
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    listener.close()?;

    let refused = match net.connect_addr(addr) {
        Ok(_) => false,
        Err(e) => match e {
            Refused(_) => true,
            _ => false,
        },
    };
    return testing.assert(refused, message: 'expected NetError.Refused');
}

@test
fn a_bad_address_is_an_addr_error() -> Result<Void, Error> {
    let bad = match net.listen('not-an-address') {
        Ok(_) => false,
        Err(e) => match e {
            Addr(_) => true,
            _ => false,
        },
    };
    return testing.assert(bad, message: 'expected NetError.Addr');
}

@test
fn resolving_a_bogus_host_is_a_dns_error() -> Result<Void, Error> {
    let failed = match net.resolve('no.such.host.invalid', 80) {
        Ok(_) => false,
        Err(e) => match e {
            Dns(_) => true,
            _ => false,
        },
    };
    return testing.assert(failed, message: 'expected NetError.Dns');
}

@test
fn localhost_resolves_to_loopback() -> Result<Void, Error> {
    let addrs = net.resolve('localhost', 8080)?;
    return testing.assert(addrs.len() > 0, message: 'localhost should resolve');
}

@test
fn using_a_closed_socket_is_an_error() -> Result<Void, Error> {
    let listener = net.listen('127.0.0.1:0')?;
    listener.close()?;
    let closed = match listener.local_addr() {
        Ok(_) => false,
        Err(e) => match e {
            Closed(_) => true,
            _ => false,
        },
    };
    return testing.assert(closed, message: 'expected NetError.Closed');
}

/// The port half of an `<ip>:<port>`.
fn port_of(_ addr: String) -> Result<Int, Error> {
    let parts = addr.split(':');
    let last = parts.get(parts.len() - 1).unwrap_or('');
    return match last.to_int() {
        Some(n) => Result.Ok(n),
        None => Result.Err(error('no port in ' + addr)),
    };
}

/// Closing a socket must wake a fiber parked reading it — a hang otherwise, not an
/// error. Readiness events are routed per handle, and a closed socket produces no
/// more of them, so nothing else would ever wake that fiber.
///
/// This is also, until `select` lands, the only way to cancel a blocked read, which
/// is why it is a supported pattern and not merely a tidy edge case.
@test
fn closing_a_socket_wakes_a_fiber_parked_on_it() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    let acceptor = fiber.spawn(() => listener.accept());
    let client = net.connect_addr(addr)?;
    let conn = acceptor.join()?;

    // The peer sends nothing, so this parks on the poller.
    let reader = fiber.spawn(() => client.read(max: 16));
    // Deterministic with a FIFO ready queue on one thread: yielding runs the
    // reader, which gets EWOULDBLOCK and parks before control returns here.
    fiber.yield();
    client.close()?;

    let woke_with_error = match reader.join() {
        Ok(_) => false,
        Err(e) => e.message().contains('closed'),
    };
    conn.close()?;
    listener.close()?;
    return testing.assert(
        woke_with_error,
        message: 'expected the reader to wake with a closed error',
    );
}

// --- TLS ---
//
// A real handshake needs a certificate and a TLS server, neither of which exists
// yet (the in-process TLS loop arrives with `tls_accept` — docs/http-tls.md
// §Testing). What is testable now is the whole client path *around* the handshake:
// the wrap, the error mapping, ownership of the socket, and the trust seam.

/// TLS against a server that isn't speaking TLS. The handshake must fail as a
/// `NetError.Tls` — not hang, and not surface as a network error, which would send
/// someone debugging their connection rather than their server.
@test
fn a_handshake_against_a_plaintext_server_fails_as_tls() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        // Echo the ClientHello back. To the client that is a *server* record it
        // cannot make sense of: a protocol violation, decided by TLS.
        let got = conn.read(max: 4096)?;
        let _ = io.write_all(to: conn, got); // the client may have hung up by now
        let _ = conn.close();
        return Result.Ok(void);
    });

    let sock = net.connect_addr(addr)?;
    let outcome = match net.TlsStream.connect(sock, host: 'localhost') {
        Ok(_) => 'the handshake unexpectedly succeeded',
        Err(e) => match e {
            Tls(_) => 'tls',
            _ => 'wrong variant: ' + e.message(),
        },
    };
    testing.assert_eq(actual: outcome, expected: 'tls')?;
    // `connect` takes the socket over, so a failed handshake closes it rather than
    // leaking the descriptor. (White-box: the handle and `_close` are private.)
    testing.assert_err(_close(sock.handle))?;

    server.join()?;
    listener.close()?;
    return Result.Ok(void);
}

/// A host name that can't be a certificate's subject is refused up front, before
/// any bytes move — there would be nothing to verify against.
@test
fn a_host_name_that_cannot_be_verified_is_refused() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    let sock = net.connect_addr(addr)?;

    let msg = match net.TlsStream.connect(sock, host: 'not a host name') {
        Ok(_) => '(unexpectedly connected)',
        Err(e) => e.message(),
    };
    listener.close()?;
    return testing.assert(msg.contains('host name'), message: 'got: ' + msg);
}

/// The test-only trust seam refuses roots it can't use, rather than quietly
/// trusting nothing — which would leave a test "passing" against a certificate it
/// never verified. White-box: `connect_trusting` is file-private, so this is the
/// only place that can reach it.
@test
fn unusable_trust_roots_are_reported() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;
    let sock = net.connect_addr(addr)?;

    let msg = match connect_trusting(sock, host: 'localhost', roots_pem: 'not a PEM') {
        Ok(_) => '(unexpectedly connected)',
        Err(e) => e.message(),
    };
    listener.close()?;
    return testing.assert(msg.contains('trusted roots'), message: 'got: ' + msg);
}

// --- the hermetic TLS loop (docs/http-tls.md §Testing #3) ---
//
// A TLS client and a TLS server in one process, over loopback, with no network and
// no third party: the mirror of the plaintext `connect_and_echo` at the top of this
// file. Both seams it needs are file-private and reachable only from here —
// `accept_tls` (there is no public server-TLS surface) and `connect_trusting` (no
// public API may say "trust this too").
//
// The certificates below are **checked in** rather than minted at test time, and
// that is a deliberate trade. Minting would need a certificate-generation native,
// which means putting `rcgen` in the shipped runtime to serve tests alone; the
// Rust-side tests already do generate theirs, because there `rcgen` is a
// dev-dependency and costs the binary nothing. What is checked in is a throwaway CA
// and a `localhost` leaf with no value to anyone — but it does carry an expiry
// (2052-08-06), so a distant future run failing on `certificate expired` means
// regenerate, not debug. The commands are in the comment on the constants.

/// Regenerate with (openssl, ed25519 for compactness):
///
/// ```
/// openssl req -x509 -newkey ed25519 -nodes -keyout ca.key -out ca.crt -days 9500 \
///   -subj "/CN=Thera std.net test CA" \
///   -addext "basicConstraints=critical,CA:TRUE" \
///   -addext "keyUsage=critical,keyCertSign,cRLSign"
/// ```
const TEST_CA_PEM: String = '-----BEGIN CERTIFICATE-----
MIIBZzCCARmgAwIBAgIUFdBOTd8I5jTxJONQM6m6DYNXaR4wBQYDK2VwMCAxHjAc
BgNVBAMMFVRoZXJhIHN0ZC5uZXQgdGVzdCBDQTAgFw0yNjA4MDMwNDI1MDBaGA8y
MDUyMDgwNjA0MjUwMFowIDEeMBwGA1UEAwwVVGhlcmEgc3RkLm5ldCB0ZXN0IENB
MCowBQYDK2VwAyEAXAwDRvGGQ54O4tiMOtBV792yS2BubC0CTv2XZnlbfvqjYzBh
MB0GA1UdDgQWBBR5E3H3Nhbp51TxjThjHszVRl4zjDAfBgNVHSMEGDAWgBR5E3H3
Nhbp51TxjThjHszVRl4zjDAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwIB
BjAFBgMrZXADQQAhNH2gZ31IRmC5mHpA2Vj0PWXqcGLrMKIM0kE9EteBYpxR7ija
omV2ILMnXKa17+iXPISAqJBBCdBgbuZwcQYC
-----END CERTIFICATE-----
';

/// The `localhost` leaf the test server presents, signed by the CA above. Its SAN
/// is `DNS:localhost`, which is the name the client verifies (it dials `127.0.0.1`,
/// so the two differ on purpose — verification is against the *name*, never the
/// address).
///
/// ```
/// openssl req -newkey ed25519 -nodes -keyout leaf.key -out leaf.csr -subj "/CN=localhost"
/// openssl x509 -req -in leaf.csr -CA ca.crt -CAkey ca.key -CAcreateserial \
///   -out leaf.crt -days 9500 -extfile ext.cnf   # ext.cnf: CA:FALSE, serverAuth,
///                                               # subjectAltName=DNS:localhost
/// ```
const TEST_CERT_PEM: String = '-----BEGIN CERTIFICATE-----
MIIBhTCCATegAwIBAgIUc8a1RX07AwS1fOuxIUz1qqU4sXEwBQYDK2VwMCAxHjAc
BgNVBAMMFVRoZXJhIHN0ZC5uZXQgdGVzdCBDQTAgFw0yNjA4MDMwNDI1MDBaGA8y
MDUyMDgwNjA0MjUwMFowFDESMBAGA1UEAwwJbG9jYWxob3N0MCowBQYDK2VwAyEA
aQWYBZc7q22AwCnS2T1EBt7qt2YJCUcholhY5wDkF12jgYwwgYkwDAYDVR0TAQH/
BAIwADAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwFAYDVR0R
BA0wC4IJbG9jYWxob3N0MB0GA1UdDgQWBBTAcrisubmTCH3THNmlSOHg6VLDyTAf
BgNVHSMEGDAWgBR5E3H3Nhbp51TxjThjHszVRl4zjDAFBgMrZXADQQAGaOf7iqnB
cIhR7XnWQNx8f5T5ELQi06wWAKdcY+3cb6MDZtiFgVNorj4DmlQ7GHtdx535y10T
FzCndNEG0vQK
-----END CERTIFICATE-----
';

/// The leaf's private key. A **test** key for `localhost`, generated for this file
/// and used nowhere else — it guards nothing and grants nothing.
const TEST_KEY_PEM: String = '-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEII2doBwjs6yyKoYnotwRDKBKHHFjoo8si5w3iWjbETz4
-----END PRIVATE KEY-----
';

/// The whole point of stage 5: a real TLS handshake and a plaintext round trip
/// between two fibers, entirely in process. This is what makes the `https` path
/// testable without the network.
@test
fn a_tls_client_and_server_echo_over_loopback() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        let tls = accept_tls(conn, cert_pem: TEST_CERT_PEM, key_pem: TEST_KEY_PEM)?;
        let got = tls.read(max: 64)?;
        io.write_all(to: tls, got)?;
        // `close` sends `close_notify`, which is what lets the client tell a
        // finished stream from a truncated one.
        tls.close()?;
        return Result.Ok(void);
    });

    // Dial the address, but verify the *name* — the leaf is issued for `localhost`
    // and the socket is `127.0.0.1`.
    let sock = net.connect_addr(addr)?;
    let tls = connect_trusting(sock, host: 'localhost', roots_pem: TEST_CA_PEM)?;
    io.write_all(to: tls, 'hello over TLS'.bytes())?;
    let echoed = io.read_all(tls)?;
    tls.close()?;

    server.join()?;
    listener.close()?;
    return testing.assert_eq(actual: echoed.to_string()?, expected: 'hello over TLS');
}

/// The security-critical half, now hermetically: the same server, but a client on
/// the **production** root store, which has never heard of the test CA. It must be
/// refused — and as `Tls`, so a caller can tell "don't retry this" from a network
/// flake. The live `badssl` smoke in `std.http` says the same thing against the
/// real world; this one says it with no network at all.
@test
fn an_untrusted_server_certificate_is_refused() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    let server = fiber.spawn(() => {
        let conn = listener.accept()?;
        // Expected to fail: the client alerts and hangs up mid-handshake. The
        // assertion is on the client, so this end's verdict is deliberately
        // discarded — it must not turn a correct refusal into a test error.
        let _ = accept_tls(conn, cert_pem: TEST_CERT_PEM, key_pem: TEST_KEY_PEM);
        return Result.Ok(void);
    });

    let sock = net.connect_addr(addr)?;
    let outcome = match net.TlsStream.connect(sock, host: 'localhost') {
        Ok(_) => '(the certificate was accepted)',
        Err(e) => match e {
            Tls(_) => 'tls',
            _ => 'wrong variant: ' + e.message(),
        },
    };

    server.join()?;
    listener.close()?;
    return testing.assert(outcome == 'tls', message: 'got: ' + outcome);
}

/// A server identity that can't be used is reported at `accept_tls`, before any
/// bytes move — the mirror of `unusable_trust_roots_are_reported`. A server that
/// silently presented nothing would be the worse failure.
@test
fn an_unusable_server_identity_is_reported() -> Result<Void, Error> {
    let listener = loopback()?;
    let addr = listener.local_addr()?;

    let client = fiber.spawn(() => {
        let sock = net.connect_addr(addr)?;
        let _ = sock.close();
        return Result.Ok(void);
    });

    let conn = listener.accept()?;
    let msg = match accept_tls(conn, cert_pem: 'not a PEM', key_pem: TEST_KEY_PEM) {
        Ok(_) => '(unexpectedly wrapped)',
        Err(e) => e.message(),
    };

    client.join()?;
    listener.close()?;
    return testing.assert(msg.contains('server identity'), message: 'got: ' + msg);
}

/// The one test that exercises the *production* trust path — a real certificate
/// against the bundled Mozilla roots — which nothing hermetic can cover. Off unless
/// `THERA_NET_TESTS` is set, because it needs the network and a third party's
/// server: exactly the properties the rest of this file avoids (docs/http-tls.md
/// §Testing).
@test
fn a_live_https_endpoint_verifies_against_the_bundled_roots() -> Result<Void, Error> {
    if env.get('THERA_NET_TESTS').is_none() {
        return Result.Ok(void);
    }
    let tls = net.connect_tls('example.com', 443)?;
    io.write_all(to: tls, 'GET / HTTP/1.0\r\nhost: example.com\r\n\r\n'.bytes())?;
    let reply = io.read_all(tls)?;
    tls.close()?;
    let status = reply.to_string()?.lines().get(0).unwrap_or('(empty)');
    return testing.assert(status.contains('200'), message: 'got: ' + status);
}
