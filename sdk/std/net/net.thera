//! std.net — TCP sockets: `listen`/`accept` for servers, `connect` for clients,
//! and a `TcpStream` (or, over TLS, a `TlsStream`) that is an ordinary
//! `Reader` + `Writer` + `Closer`.
//!
//! Import as: import std.net
//!
//! ```thera
//! // a client
//! let sock = net.connect('example.com', 80)?;
//! io.write_all(sock, 'GET / HTTP/1.0\r\n\r\n'.to_bytes())?;
//! let reply = io.read_all(sock)?;
//! sock.close()?;
//!
//! // the same, over TLS: certificate + host verified before `connect_tls` returns
//! let tls = net.connect_tls('example.com', 443)?;
//!
//! // a server: one fiber per connection
//! let listener = net.listen('127.0.0.1:8080')?;
//! while true {
//!     let conn = listener.accept()?;
//!     fiber.spawn(() => handle(conn));
//! }
//! ```
//!
//! **Provisional — this surface is expected to change.** It exists to carry
//! `std.http` (see docs/stdlib.md § `std.http`), and only what the HTTP client and
//! server need is implemented. Raw sockets are otherwise *not* core
//! (docs/stdlib.md § "What is intentionally not in core"): they are here to be
//! built on, not yet to be committed to. Notably absent, and all likely additions
//! when this is revisited: **UDP**, **deadlines/timeouts** (which want the
//! scheduler's `select`, docs/roadmap.md), **half-close** (`shutdown`), and socket
//! options (`nodelay`, `keepalive`). TLS is **client-side only** — there is no
//! `TlsListener`, so a server terminates TLS upstream. Take a dependency on the
//! shape of this module only if you are prepared to update it.
//!
//! Concurrency: every call parks the calling fiber rather than blocking the
//! thread, so blocking-looking code stays concurrent (docs/stdlib.md
//! § Cross-cutting #5). Unlike `fs.File`, one fiber may read a `TcpStream` while
//! another writes it.

import std.io;
import std.fiber;

// --- errors ---

pub enum NetError {
    /// Nothing is listening at the address (ECONNREFUSED).
    Refused(String),
    /// The peer reset, aborted, or vanished mid-stream.
    Reset(String),
    /// The address is already bound by another socket (EADDRINUSE).
    AddrInUse(String),
    /// The address can't be bound here — e.g. an IP this host doesn't own.
    AddrUnavailable(String),
    /// The host name did not resolve.
    Dns(String),
    /// Not a well-formed `<ip>:<port>`.
    Addr(String),
    /// The socket is closed (a use-after-`close`).
    Closed(String),
    /// TLS refused: a certificate that doesn't verify or isn't valid for the host,
    /// a protocol violation, or a stream that ended without a `close_notify`. Its
    /// own variant because it is not a network failure and retrying won't fix it.
    Tls(String),
    /// The OS refused the operation (a privileged port, a sandbox).
    PermissionDenied(String),
    TimedOut(String),
    Other(String),
}

impl Error for NetError {
    pub fn message(self) -> String {
        return match self {
            Refused(m) => m,
            Reset(m) => m,
            AddrInUse(m) => m,
            AddrUnavailable(m) => m,
            Dns(m) => m,
            Addr(m) => m,
            Closed(m) => m,
            Tls(m) => m,
            PermissionDenied(m) => m,
            TimedOut(m) => m,
            Other(m) => m,
        };
    }
}

impl Display for NetError {
    pub fn to_string(self) -> String {
        return self.message();
    }
}

// The native error payload is "<kind>\u{1}<message>"; map the kind tag to the
// matching variant so callers can `match` on the cause.
fn to_net_error(_ raw: String) -> NetError {
    let parts = raw.split('\u{1}');
    let kind = parts.get(0).unwrap_or('other');
    let msg = parts.get(1).unwrap_or(raw);
    if kind == 'refused' {
        return NetError.Refused(msg);
    }
    if kind == 'reset' {
        return NetError.Reset(msg);
    }
    if kind == 'addr_in_use' {
        return NetError.AddrInUse(msg);
    }
    if kind == 'addr_unavailable' {
        return NetError.AddrUnavailable(msg);
    }
    if kind == 'dns' {
        return NetError.Dns(msg);
    }
    if kind == 'addr' {
        return NetError.Addr(msg);
    }
    if kind == 'closed' {
        return NetError.Closed(msg);
    }
    if kind == 'tls' {
        return NetError.Tls(msg);
    }
    if kind == 'permission_denied' {
        return NetError.PermissionDenied(msg);
    }
    if kind == 'timed_out' {
        return NetError.TimedOut(msg);
    }
    return NetError.Other(msg);
}

// --- native bindings (private; errors come back kind-tagged) ---

@extern('socket_listen')
native fn _listen(_ addr: String) -> Result<Int, String>

@extern('socket_accept')
native fn _accept(_ handle: Int) -> Result<Int, String>

@extern('socket_connect')
native fn _connect(_ addr: String) -> Result<Int, String>

@extern('socket_connect_finish')
native fn _connect_finish(_ handle: Int) -> Result<Void, String>

@extern('socket_read')
native fn _read(_ handle: Int, _ max: Int) -> Result<Bytes, String>

@extern('socket_write')
native fn _write(_ handle: Int, _ data: Bytes) -> Result<Int, String>

@extern('socket_close')
native fn _close(_ handle: Int) -> Result<Void, String>

@extern('socket_local_addr')
native fn _local_addr(_ handle: Int) -> Result<String, String>

@extern('socket_peer_addr')
native fn _peer_addr(_ handle: Int) -> Result<String, String>

@extern('socket_resolve')
native fn _resolve(_ host: String, _ port: Int) -> Result<String, String>

@extern('socket_is_ready')
native fn _is_ready(_ handle: Int) -> Bool

// TLS. `_tls_connect` wraps an already-connected socket and hands back the *same*
// handle — the session is layered onto the registry entry in place, so the poller
// registration, `_close`, `_local_addr`/`_peer_addr` and `_is_ready` all keep
// working on it while `_read`/`_write` stop (they would bypass the session).

@extern('tls_connect')
native fn _tls_connect(_ handle: Int, _ host: String, _ roots_pem: String) -> Result<Int, String>

// The server mirror, wrapping an *accepted* socket the same way. Bound only for
// `accept_tls` below — there is no public server-TLS surface, by design.
@extern('tls_accept')
native fn _tls_accept(_ handle: Int, _ cert_pem: String, _ key_pem: String) -> Result<Int, String>

@extern('tls_handshake')
native fn _tls_handshake(_ handle: Int) -> Result<Void, String>

@extern('tls_read')
native fn _tls_read(_ handle: Int, _ max: Int) -> Result<Bytes, String>

@extern('tls_write')
native fn _tls_write(_ handle: Int, _ data: Bytes) -> Result<Int, String>

@extern('tls_close')
native fn _tls_close(_ handle: Int) -> Result<Void, String>

// --- streams ---

/// A connected TCP socket: a `Reader` + `Writer` + `Closer` over a runtime socket
/// handle, so every `std.io` helper (`io.copy`, `io.lines`, `io.write_all`) works
/// on it. **Close it when done** — an unclosed socket leaks its descriptor until
/// the process exits.
///
/// One fiber may `read` while another `write`s: the ops are non-blocking under the
/// hood and park on readiness, so neither excludes the other.
pub struct TcpStream {
    let handle: Int;
}

impl io.Reader for TcpStream {
    /// Up to `max` bytes. An **empty** result means the peer closed its end (EOF),
    /// which is the normal end of a stream — not an error.
    pub fn read(self, max: Int) -> Result<Bytes, Error> {
        return match _read(self.handle, max) {
            Ok(b) => Result.Ok(b),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

impl io.Writer for TcpStream {
    /// Writes what the socket accepts now and returns that count, which may be
    /// **short** — the kernel's send buffer is finite. Use `io.write_all` unless
    /// you are handling the remainder yourself.
    pub fn write(self, _ data: Bytes) -> Result<Int, Error> {
        return match _write(self.handle, data) {
            Ok(n) => Result.Ok(n),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

impl io.Closer for TcpStream {
    pub fn close(self) -> Result<Void, Error> {
        return match _close(self.handle) {
            Ok(_) => Result.Ok(void),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

/// A stream is selectable on **readability**: `fiber.select` returns its index
/// when a `read` would not block — including at EOF and on a pending error, both of
/// which `read` reports rather than waits on.
///
/// A `TcpListener` is deliberately *not* selectable: probing it means `accept`,
/// which consumes the connection, and `select`'s `is_ready` must not consume (it is
/// asked speculatively, about sources the caller may never act on). Selecting on
/// "a connection arrived or quit was signalled" therefore wants an accept loop
/// feeding a channel.
impl fiber.Selectable for TcpStream {
    pub fn is_ready(self) -> Bool {
        return _is_ready(self.handle);
    }

    pub fn source(self) -> fiber.SelectSource {
        return fiber.SelectSource.Socket(self.handle);
    }
}

impl TcpStream {
    /// This end's `<ip>:<port>`.
    pub fn local_addr(self) -> Result<String, NetError> {
        return match _local_addr(self.handle) {
            Ok(a) => Result.Ok(a),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }

    /// The remote end's `<ip>:<port>`.
    pub fn peer_addr(self) -> Result<String, NetError> {
        return match _peer_addr(self.handle) {
            Ok(a) => Result.Ok(a),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

// --- TLS ---

/// A TLS client connection: a `Reader` + `Writer` + `Closer` like `TcpStream`, so
/// anything written against those interfaces (`io.copy`, the HTTP wire codec)
/// works over it unchanged — that interchangeability is the point.
///
/// A `TlsStream` only exists once the handshake has completed, which means the
/// server's certificate chain **and** its name have been verified against the
/// bundled root store. A certificate that doesn't check out is a `NetError.Tls`
/// from `connect`, never a stream you can accidentally use.
///
/// **Close it when done**, and prefer `close` over dropping it: it sends TLS's
/// `close_notify`, which is what lets the peer tell a finished stream from a
/// truncated one (this end applies the same rule — a stream that just stops is a
/// `NetError.Tls`, not an EOF).
pub struct TlsStream {
    let handle: Int;
}

impl TlsStream {
    /// Wrap a **connected** `stream` in TLS for `host`, and drive the handshake.
    /// `host` is what the certificate must be valid for, so it must be the name
    /// that was dialled — not an IP the name resolved to.
    ///
    /// Takes ownership of `stream`: on success it *becomes* the returned
    /// `TlsStream` (same descriptor), and on failure it is closed. Either way the
    /// original value is spent — reading or writing it afterwards is a
    /// `NetError.Other`, deliberately, so plaintext can't slip past the session.
    pub fn connect(_ stream: TcpStream, host: String) -> Result<TlsStream, NetError> {
        return connect_trusting(stream, host: host, roots_pem: '');
    }
}

/// `TlsStream.connect`, plus extra trusted roots as PEM — the seam the hermetic
/// TLS tests connect through, so they can trust a certificate minted at test time
/// (docs/http-tls.md §Testing).
///
/// Deliberately **file-private**: white-box visible to `net_test.thera` and to
/// nothing else, so no public API — here or in `std.http` — grows a way to say
/// "trust this too". The roots are additional, never a replacement, so it cannot
/// turn verification off even where it is reachable.
fn connect_trusting(
    _ stream: TcpStream,
    host: String,
    roots_pem: String,
) -> Result<TlsStream, NetError> {
    let handle = match _tls_connect(stream.handle, host, roots_pem) {
        Ok(h) => h,
        // Nothing was wrapped, so this is still a plain socket — close it rather
        // than leak the descriptor, since the caller has handed it over.
        Err(e) => {
            let _ = _close(stream.handle);
            return Result.Err(to_net_error(e));
        },
    };
    return match _tls_handshake(handle) {
        Ok(_) => Result.Ok(TlsStream { handle: handle }),
        Err(e) => {
            let _ = _close(handle);
            Result.Err(to_net_error(e))
        },
    };
}

/// Terminate TLS on an **accepted** `stream`, presenting `cert_pem` (leaf first)
/// with `key_pem`, and drive the handshake. The server half of `connect_trusting`
/// — together they are the hermetic in-process TLS loop (docs/http-tls.md
/// §Testing #3): one fiber serves, another connects, and no network is involved.
///
/// Ownership works exactly as for `TlsStream.connect`: on success `stream` becomes
/// the returned `TlsStream`, on failure it is closed.
///
/// Deliberately **file-private**, like `connect_trusting` and for a stronger
/// reason: a public server-TLS surface is a stated non-goal (a simple server's TLS
/// is terminated upstream), so this exists to make the *client* path testable and
/// nothing else. Note what it does **not** do — a server session verifies nothing
/// about its peer, so a completed handshake here says only that someone speaks
/// TLS.
fn accept_tls(
    _ stream: TcpStream,
    cert_pem: String,
    key_pem: String,
) -> Result<TlsStream, NetError> {
    let handle = match _tls_accept(stream.handle, cert_pem, key_pem) {
        Ok(h) => h,
        // Nothing was wrapped, so this is still a plain socket — close it rather
        // than leak the descriptor, since the caller has handed it over.
        Err(e) => {
            let _ = _close(stream.handle);
            return Result.Err(to_net_error(e));
        },
    };
    return match _tls_handshake(handle) {
        Ok(_) => Result.Ok(TlsStream { handle: handle }),
        Err(e) => {
            let _ = _close(handle);
            Result.Err(to_net_error(e))
        },
    };
}

impl io.Reader for TlsStream {
    /// Up to `max` bytes of **plaintext**. An empty result is EOF — the peer's
    /// `close_notify`. A connection that ends without one is a `NetError.Tls`
    /// instead: silently accepting a truncated stream is how a response gets
    /// trimmed by someone who is not the server.
    pub fn read(self, max: Int) -> Result<Bytes, Error> {
        return match _tls_read(self.handle, max) {
            Ok(b) => Result.Ok(b),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

impl io.Writer for TlsStream {
    /// Encrypts and sends what the session accepts now, returning that count —
    /// **short writes are normal**, exactly as for a `TcpStream`. Use
    /// `io.write_all` unless you are handling the remainder yourself.
    pub fn write(self, _ data: Bytes) -> Result<Int, Error> {
        return match _tls_write(self.handle, data) {
            Ok(n) => Result.Ok(n),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

impl io.Closer for TlsStream {
    /// Flush anything pending, send `close_notify`, and close the socket. The
    /// descriptor goes even if the alert can't be sent.
    pub fn close(self) -> Result<Void, Error> {
        return match _tls_close(self.handle) {
            Ok(_) => Result.Ok(void),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

/// Selectable on readability like a `TcpStream`, but the question is asked of the
/// *session*: buffered plaintext counts as ready even when the socket is quiet,
/// because a whole record may already have been decrypted.
impl fiber.Selectable for TlsStream {
    pub fn is_ready(self) -> Bool {
        return _is_ready(self.handle);
    }

    pub fn source(self) -> fiber.SelectSource {
        return fiber.SelectSource.Socket(self.handle);
    }
}

impl TlsStream {
    /// This end's `<ip>:<port>`.
    pub fn local_addr(self) -> Result<String, NetError> {
        return match _local_addr(self.handle) {
            Ok(a) => Result.Ok(a),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }

    /// The remote end's `<ip>:<port>`.
    pub fn peer_addr(self) -> Result<String, NetError> {
        return match _peer_addr(self.handle) {
            Ok(a) => Result.Ok(a),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

// --- listeners ---

/// A bound, listening TCP socket. `accept` it in a loop; **close it when done**.
pub struct TcpListener {
    let handle: Int;
}

impl TcpListener {
    /// Wait for the next inbound connection. Parks the calling fiber until one
    /// arrives, so an accept loop costs nothing while idle.
    pub fn accept(self) -> Result<TcpStream, NetError> {
        return match _accept(self.handle) {
            Ok(h) => Result.Ok(TcpStream { handle: h }),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }

    /// The bound `<ip>:<port>`. The way to learn the real port when you bound to
    /// port 0 and let the OS choose (the idiom for tests).
    pub fn local_addr(self) -> Result<String, NetError> {
        return match _local_addr(self.handle) {
            Ok(a) => Result.Ok(a),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

impl io.Closer for TcpListener {
    pub fn close(self) -> Result<Void, Error> {
        return match _close(self.handle) {
            Ok(_) => Result.Ok(void),
            Err(e) => Result.Err(to_net_error(e)),
        };
    }
}

// --- entry points ---

/// Bind and listen on `addr`, an `<ip>:<port>` (`'127.0.0.1:8080'` for loopback
/// only, `'0.0.0.0:8080'` for every interface). Port **0** asks the OS to pick a
/// free port — read it back with `local_addr`.
///
/// Takes an address, not a host name: binding is to an interface this host owns,
/// so there is nothing to resolve. `connect` is the one that takes a host.
pub fn listen(_ addr: String) -> Result<TcpListener, NetError> {
    return match _listen(addr) {
        Ok(h) => Result.Ok(TcpListener { handle: h }),
        Err(e) => Result.Err(to_net_error(e)),
    };
}

/// Resolve `host` and connect to it, trying each address until one answers.
/// `host` may be a name (`'example.com'`) or a literal IP.
pub fn connect(_ host: String, _ port: Int) -> Result<TcpStream, NetError> {
    let addrs = resolve(host, port)?;
    // `resolve` yields at least one address (it errors otherwise), so `last` is a
    // real error by construction.
    let mut last = NetError.Dns('no addresses for ' + host);
    for addr in addrs {
        match connect_addr(addr) {
            Ok(s) => { return Result.Ok(s); },
            Err(e) => { last = e; },
        }
    }
    return Result.Err(last);
}

/// Resolve `host`, connect, and wrap the connection in TLS, verifying the
/// server's certificate against `host`. The `https` half of `connect`.
///
/// `host` must be the **name** to verify (`'example.com'`), which is also what is
/// dialled; a literal IP works only if the certificate is issued for that IP.
pub fn connect_tls(_ host: String, _ port: Int) -> Result<TlsStream, NetError> {
    return TlsStream.connect(connect(host, port)?, host: host);
}

/// Connect to a single already-resolved `<ip>:<port>`. `connect` is the one to
/// reach for; this skips resolution (and its fallback across addresses).
pub fn connect_addr(_ addr: String) -> Result<TcpStream, NetError> {
    // Two natives: `_connect` starts the connect and hands back the socket, then
    // `_connect_finish` parks until the handshake lands. They are split because a
    // parked native re-runs on wake, and re-issuing connect(2) on a pending socket
    // reports EALREADY rather than retrying it.
    let handle = match _connect(addr) {
        Ok(h) => h,
        Err(e) => { return Result.Err(to_net_error(e)); },
    };
    match _connect_finish(handle) {
        Ok(_) => { return Result.Ok(TcpStream { handle: handle }); },
        Err(e) => {
            // Don't leak the descriptor when the connect fails.
            let _ = _close(handle);
            return Result.Err(to_net_error(e));
        },
    }
}

/// Resolve `host` to its `<ip>:<port>` addresses (DNS, or the hosts file). Errors
/// if the name resolves to nothing.
pub fn resolve(_ host: String, _ port: Int) -> Result<List<String>, NetError> {
    return match _resolve(host, port) {
        Ok(joined) => Result.Ok(joined.split('\u{1}')),
        Err(e) => Result.Err(to_net_error(e)),
    };
}
