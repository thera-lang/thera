//! Tests for std.toml.

import std.math;
import std.testing;

import 'toml' as _;

// A single-quote character, for building TOML literal-string inputs without
// leaning on escape support in Thera's own string literals.
let sq: String = String.from_chars([39]);

fn len_of(_ items: Option<List<Toml>>) -> Int {
    return match items {
        Some(l) => l.len(),
        None => -1,
    };
}

fn key_count(_ table: Option<Map<String, Toml>>) -> Int {
    return match table {
        Some(m) => m.keys().len(),
        None => -1,
    };
}

@test
fn test_parse_scalars() -> Result<Void, Error> {
    let doc = parse('a = true\nb = false\nc = 42\nd = -17\ne = +8\nf = 1_000_000\n')?;
    testing.assert_eq(actual: doc.get_bool('a'), expected: Option.Some(true))?;
    testing.assert_eq(actual: doc.get_bool('b'), expected: Option.Some(false))?;
    testing.assert_eq(actual: doc.get_int('c'), expected: Option.Some(42))?;
    testing.assert_eq(actual: doc.get_int('d'), expected: Option.Some(-17))?;
    testing.assert_eq(actual: doc.get_int('e'), expected: Option.Some(8))?;
    testing.assert_eq(actual: doc.get_int('f'), expected: Option.Some(1000000))?;
    return Result.Ok(void);
}

@test
fn test_integer_bases() -> Result<Void, Error> {
    let doc = parse('a = 0xDEADbeef\nb = 0o755\nc = 0b1101\nd = 0x0000_00ff\ne = 0o0\n')?;
    testing.assert_eq(actual: doc.get_int('a'), expected: Option.Some(3735928559))?;
    testing.assert_eq(actual: doc.get_int('b'), expected: Option.Some(493))?;
    testing.assert_eq(actual: doc.get_int('c'), expected: Option.Some(13))?;
    testing.assert_eq(actual: doc.get_int('d'), expected: Option.Some(255))?;
    testing.assert_eq(actual: doc.get_int('e'), expected: Option.Some(0))?;
    return Result.Ok(void);
}

@test
fn test_integer_range() -> Result<Void, Error> {
    let doc = parse('max = 9223372036854775807\nmin = -9223372036854775808\n')?;
    testing.assert_eq(actual: doc.get_int('max'), expected: Option.Some(9223372036854775807))?;
    testing.assert_eq(
        actual: doc.get_int('min'),
        expected: Option.Some(-9223372036854775807 - 1),
    )?;
    let hex = parse('v = 0x7FFFFFFFFFFFFFFF\n')?;
    testing.assert_eq(actual: hex.get_int('v'), expected: Option.Some(9223372036854775807))?;

    testing.assert_err(parse('v = 9223372036854775808\n'))?;    // i64 max + 1
    testing.assert_err(parse('v = -9223372036854775809\n'))?;   // i64 min - 1
    testing.assert_err(parse('v = 0x8000000000000000\n'))?;     // sign bit set
    testing.assert_err(parse('v = 0o1000000000000000000000\n'))?;
    return Result.Ok(void);
}

@test
fn test_integer_syntax_errors() -> Result<Void, Error> {
    testing.assert_err(parse('v = 03\n'))?;        // leading zero
    testing.assert_err(parse('v = 1__2\n'))?;      // doubled underscore
    testing.assert_err(parse('v = 1_\n'))?;        // trailing underscore
    testing.assert_err(parse('v = _1\n'))?;        // leading underscore
    testing.assert_err(parse('v = 0x\n'))?;        // no digits after prefix
    testing.assert_err(parse('v = 0x_1\n'))?;      // underscore before first digit
    testing.assert_err(parse('v = 0o8\n'))?;       // digit out of base
    testing.assert_err(parse('v = -0x1\n'))?;      // prefix forms take no sign
    return Result.Ok(void);
}

@test
fn test_floats() -> Result<Void, Error> {
    let doc = parse(
        'a = 3.5\nb = 1e3\nc = 2E-2\nd = +5e+2\ne = 0.0\nf = 6.26e-34\ng = 9_224_617.445_991\nh = 1e00\n'
    )?;
    testing.assert_eq(actual: doc.get_double('a'), expected: Option.Some(3.5))?;
    testing.assert_eq(actual: doc.get_double('b'), expected: Option.Some(1000.0))?;
    testing.assert_eq(actual: doc.get_double('c'), expected: Option.Some(0.02))?;
    testing.assert_eq(actual: doc.get_double('d'), expected: Option.Some(500.0))?;
    testing.assert_eq(actual: doc.get_double('e'), expected: Option.Some(0.0))?;
    testing.assert_eq(actual: doc.get_double('g'), expected: Option.Some(9224617.445991))?;
    testing.assert_eq(actual: doc.get_double('h'), expected: Option.Some(1.0))?;
    // An Int widens through get_double; a float never narrows to Int.
    let n = parse('i = 10\nx = 10.5\n')?;
    testing.assert_eq(actual: n.get_double('i'), expected: Option.Some(10.0))?;
    testing.assert_eq(actual: n.get_int('x'), expected: Option.None)?;
    return Result.Ok(void);
}

@test
fn test_float_specials() -> Result<Void, Error> {
    let doc = parse('a = inf\nb = +inf\nc = -inf\nd = nan\ne = -nan\n')?;
    testing.assert_eq(actual: doc.get_double('a'), expected: Option.Some(math.INFINITY))?;
    testing.assert_eq(actual: doc.get_double('b'), expected: Option.Some(math.INFINITY))?;
    testing.assert_eq(actual: doc.get_double('c'), expected: Option.Some(0.0 - math.INFINITY))?;
    let d = doc.get_double('d').unwrap_or(0.0);
    testing.assert_eq(actual: d != d, expected: true)?;   // NaN is unequal to itself
    let e = doc.get_double('e').unwrap_or(0.0);
    testing.assert_eq(actual: e != e, expected: true)?;
    return Result.Ok(void);
}

@test
fn test_float_syntax_errors() -> Result<Void, Error> {
    testing.assert_err(parse('v = .5\n'))?;        // digits required before the dot
    testing.assert_err(parse('v = 5.\n'))?;        // and after it
    testing.assert_err(parse('v = 1.e3\n'))?;
    testing.assert_err(parse('v = 7e\n'))?;        // empty exponent
    testing.assert_err(parse('v = 03.14\n'))?;     // leading zero
    return Result.Ok(void);
}

@test
fn test_basic_strings() -> Result<Void, Error> {
    let doc = parse(
        'a = "plain"\nb = "tab\\there"\nc = "line\\nbreak"\nd = "quote \\" backslash \\\\"\ne = "\\u0041\\U0001F600"\nf = ""\n'
    )?;
    testing.assert_eq(actual: doc.get_string('a'), expected: Option.Some('plain'))?;
    testing.assert_eq(actual: doc.get_string('b'), expected: Option.Some('tab\there'))?;
    testing.assert_eq(actual: doc.get_string('c'), expected: Option.Some('line\nbreak'))?;
    testing.assert_eq(actual: doc.get_string('d'), expected: Option.Some('quote " backslash \\'))?;
    let grin = String.from_chars([65, 128512]); // 'A' + U+1F600
    testing.assert_eq(actual: doc.get_string('e'), expected: Option.Some(grin))?;
    testing.assert_eq(actual: doc.get_string('f'), expected: Option.Some(''))?;
    return Result.Ok(void);
}

@test
fn test_basic_string_errors() -> Result<Void, Error> {
    testing.assert_err(parse('v = "no end\n'))?;             // unterminated
    testing.assert_err(parse('v = "slash \\/ escape"\n'))?;  // \/ is JSON, not TOML
    testing.assert_err(parse('v = "\\uD800"\n'))?;           // surrogate: not a scalar value
    testing.assert_err(parse('v = "\\U00110000"\n'))?;       // beyond U+10FFFF
    testing.assert_err(parse('v = "\\x41"\n'))?;             // \x is not in the set
    // A raw control character must be escaped (tab is the exception).
    let ctrl = String.from_chars([118, 32, 61, 32, 34, 7, 34, 10]); // v = "<BEL>"
    testing.assert_err(parse(ctrl))?;
    let doc = parse('v = "a\tb"\n')?; // a literal tab is fine
    testing.assert_eq(actual: doc.get_string('v'), expected: Option.Some('a\tb'))?;
    return Result.Ok(void);
}

@test
fn test_literal_strings() -> Result<Void, Error> {
    // No escapes: backslashes ride through untouched. (The TOML input is
    // 'C:\Users\nobody' — the Thera literal doubles its backslashes.)
    let doc = parse('p = ${sq}C:\\Users\\nobody${sq}\nq = ${sq}no \\n escape${sq}\n')?;
    testing.assert_eq(actual: doc.get_string('p'), expected: Option.Some('C:\\Users\\nobody'))?;
    testing.assert_eq(actual: doc.get_string('q'), expected: Option.Some('no \\n escape'))?;
    return Result.Ok(void);
}

@test
fn test_multiline_basic_strings() -> Result<Void, Error> {
    // The newline right after the opener is trimmed; later ones are kept.
    let doc = parse('a = """\nRoses are red\nViolets are blue"""\n')?;
    testing.assert_eq(
        actual: doc.get_string('a'),
        expected: Option.Some('Roses are red\nViolets are blue'),
    )?;
    // One or two quotes are content; a run of four or five closes with extras.
    let q = parse(
        'a = """lone " and pair "" inside"""\nb = """ends with quote""""\nc = """ends with two"""""\n'
    )?;
    testing.assert_eq(
        actual: q.get_string('a'),
        expected: Option.Some('lone " and pair "" inside'),
    )?;
    testing.assert_eq(actual: q.get_string('b'), expected: Option.Some('ends with quote"'))?;
    testing.assert_eq(actual: q.get_string('c'), expected: Option.Some('ends with two""'))?;
    // The line-ending backslash trims all whitespace up to the next content.
    let w = parse('a = """fold \\\n     these  \\\n\n     lines"""\n')?;
    testing.assert_eq(actual: w.get_string('a'), expected: Option.Some('fold these  lines'))?;
    return Result.Ok(void);
}

@test
fn test_multiline_literal_strings() -> Result<Void, Error> {
    let tsq = '${sq}${sq}${sq}';
    let doc = parse('a = ${tsq}\nfirst\\nsecond${tsq}\n')?;
    // No escapes: the two characters backslash + n survive as written.
    testing.assert_eq(actual: doc.get_string('a'), expected: Option.Some('first\\nsecond'))?;
    return Result.Ok(void);
}

@test
fn test_crlf_handling() -> Result<Void, Error> {
    let crlf = String.from_chars([13, 10]);
    let doc = parse('a = 1${crlf}b = 2${crlf}')?;
    testing.assert_eq(actual: doc.get_int('a'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('b'), expected: Option.Some(2))?;
    // Inside a multiline string CRLF normalizes to LF.
    let ml = parse('s = """${crlf}one${crlf}two"""${crlf}')?;
    testing.assert_eq(actual: ml.get_string('s'), expected: Option.Some('one\ntwo'))?;
    // A bare CR is never a newline.
    let bare = String.from_chars([97, 32, 61, 32, 49, 13, 98, 32, 61, 32, 50, 10]);
    testing.assert_err(parse(bare))?;
    return Result.Ok(void);
}

@test
fn test_keys() -> Result<Void, Error> {
    let doc = parse(
        'bare_key-1 = 1\n1234 = 2\n"quoted key" = 3\n${sq}literal.key${sq} = 4\n"" = 5\n'
    )?;
    testing.assert_eq(actual: doc.get_int('bare_key-1'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('1234'), expected: Option.Some(2))?;
    testing.assert_eq(actual: doc.get_int('quoted key'), expected: Option.Some(3))?;
    testing.assert_eq(actual: doc.get_int(''), expected: Option.Some(5))?;
    // A quoted key containing a dot is reachable through the table, not `get`.
    let lit = doc.as_table()
        .and_then((m) => m.get('literal.key'))
        .and_then((v) => v.as_int());
    testing.assert_eq(actual: lit, expected: Option.Some(4))?;
    return Result.Ok(void);
}

@test
fn test_dotted_keys() -> Result<Void, Error> {
    let doc = parse('server.host = "x"\nserver . port = 80\nserver.limits.rate = 5\n')?;
    testing.assert_eq(actual: doc.get_string('server.host'), expected: Option.Some('x'))?;
    testing.assert_eq(actual: doc.get_int('server.port'), expected: Option.Some(80))?;
    testing.assert_eq(actual: doc.get_int('server.limits.rate'), expected: Option.Some(5))?;
    testing.assert_eq(
        actual: doc.get('server').and_then((v) => v.as_table()).is_some(),
        expected: true,
    )?;
    return Result.Ok(void);
}

@test
fn test_key_semantics_errors() -> Result<Void, Error> {
    testing.assert_err(parse('a = 1\na = 2\n'))?;             // duplicate key
    testing.assert_err(parse('a = 1\na.b = 2\n'))?;           // a value is not a table
    testing.assert_err(parse('a.b.c = 1\na.b = 2\n'))?;       // redefining a dotted table
    testing.assert_err(parse('t = { x = 1 }\nt.y = 2\n'))?;   // inline tables are closed
    testing.assert_err(parse('t = { x = 1, x = 2 }\n'))?;     // duplicate inside inline
    testing.assert_err(parse('t = { a.b = 1, a.b.c = 2 }\n'))?;
    // A shared dotted prefix is legal — only the leaves must be new.
    let doc = parse('a.b = 1\na.c = 2\n')?;
    testing.assert_eq(actual: doc.get_int('a.b'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('a.c'), expected: Option.Some(2))?;
    return Result.Ok(void);
}

@test
fn test_arrays() -> Result<Void, Error> {
    let doc = parse(
        'empty = []\nnums = [1, 2, 3]\nmixed = [1, "two", true]\nnested = [[1], [2, 3]]\n'
    )?;
    testing.assert_eq(actual: len_of(doc.get_array('empty')), expected: 0)?;
    testing.assert_eq(
        actual: doc.get('nums').and_then((v) => v.at(2)).and_then((v) => v.as_int()),
        expected: Option.Some(3),
    )?;
    testing.assert_eq(
        actual: doc.get('mixed').and_then((v) => v.at(1)).and_then((v) => v.as_string()),
        expected: Option.Some('two'),
    )?;
    testing.assert_eq(
        actual: doc.get('nested').and_then((v) => v.at(1)).and_then((v) => v.at(0)).and_then(
            (v) => v.as_int()
        ),
        expected: Option.Some(2),
    )?;
    // Newlines, comments, and a trailing comma are all legal inside.
    let ml = parse('v = [\n  1, # one\n  2,\n]\n')?;
    testing.assert_eq(actual: len_of(ml.get_array('v')), expected: 2)?;
    testing.assert_err(parse('v = [1 2]\n'))?;    // a comma is required
    return Result.Ok(void);
}

@test
fn test_inline_tables() -> Result<Void, Error> {
    let doc = parse(
        'empty = {}\npoint = { x = 1, y = 2 }\nname = { first.a = 1, first.b = 2 }\nnest = { inner = { v = 3 } }\n'
    )?;
    testing.assert_eq(actual: key_count(doc.get_table('empty')), expected: 0)?;
    testing.assert_eq(actual: doc.get_int('point.x'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('name.first.b'), expected: Option.Some(2))?;
    testing.assert_eq(actual: doc.get_int('nest.inner.v'), expected: Option.Some(3))?;

    testing.assert_err(parse('v = { a = 1, }\n'))?;           // no trailing comma
    testing.assert_err(parse('v = { a = 1\n, b = 2 }\n'))?;   // single-line only
    // ... though a value inside may still span lines (an array can).
    let arr = parse('v = { a = [\n1,\n2] }\n')?;
    testing.assert_eq(actual: len_of(arr.get_array('v.a')), expected: 2)?;
    return Result.Ok(void);
}

@test
fn test_comments_and_layout() -> Result<Void, Error> {
    let doc = parse('# a full-line comment\n\na = 1 # trailing\n\t \nb = 2\n')?;
    testing.assert_eq(actual: doc.get_int('a'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('b'), expected: Option.Some(2))?;
    // Empty documents (and comment-only ones) parse to an empty table.
    testing.assert_eq(actual: key_count(parse('')?.as_table()), expected: 0)?;
    testing.assert_eq(actual: key_count(parse('# only a comment')?.as_table()), expected: 0)?;
    // The last line needs no newline.
    testing.assert_eq(actual: parse('a = 1')?.get_int('a'), expected: Option.Some(1))?;
    // Control characters (other than tab) are not permitted in comments.
    let ctrl = String.from_chars([35, 7, 10]); // #<BEL>
    testing.assert_err(parse(ctrl))?;
    return Result.Ok(void);
}

@test
fn test_document_errors() -> Result<Void, Error> {
    testing.assert_err(parse('a\n'))?;             // key without =
    testing.assert_err(parse('a =\n'))?;           // = without value
    testing.assert_err(parse('a = 1 b = 2\n'))?;   // junk after a value
    testing.assert_err(parse('= 1\n'))?;           // value without key
    testing.assert_err(parse('a = truex\n'))?;     // not a boolean
    return Result.Ok(void);
}

fn datetime_of(_ v: Option<Toml>) -> Datetime {
    let fallback = Datetime { kind: DatetimeKind.LocalDate, text: 'missing' };
    return match v {
        Some(t) => t.as_datetime().unwrap_or(fallback),
        None => fallback,
    };
}

@test
fn test_datetime_kinds() -> Result<Void, Error> {
    let doc = parse(
        'a = 1979-05-27T07:32:00Z\nb = 1979-05-27T00:32:00.999999-07:00\nc = 1979-05-27T07:32:00\nd = 1979-05-27\ne = 07:32:00\nf = 00:32:00.999\n'
    )?;
    let a = datetime_of(doc.get('a'));
    testing.assert_eq(actual: a.kind, expected: DatetimeKind.OffsetDateTime)?;
    testing.assert_eq(actual: a.text, expected: '1979-05-27T07:32:00Z')?;
    let b = datetime_of(doc.get('b'));
    testing.assert_eq(actual: b.kind, expected: DatetimeKind.OffsetDateTime)?;
    testing.assert_eq(actual: b.text, expected: '1979-05-27T00:32:00.999999-07:00')?;
    testing.assert_eq(
        actual: datetime_of(doc.get('c')).kind,
        expected: DatetimeKind.LocalDateTime,
    )?;
    testing.assert_eq(actual: datetime_of(doc.get('d')).kind, expected: DatetimeKind.LocalDate)?;
    testing.assert_eq(actual: datetime_of(doc.get('e')).kind, expected: DatetimeKind.LocalTime)?;
    testing.assert_eq(actual: datetime_of(doc.get('f')).text, expected: '00:32:00.999')?;
    return Result.Ok(void);
}

@test
fn test_datetime_normalization() -> Result<Void, Error> {
    // Lowercase t/z and the space delimiter normalize; components stay as
    // written.
    let doc = parse('a = 1979-05-27t07:32:00z\nb = 1979-05-27 07:32:00Z\n')?;
    testing.assert_eq(actual: datetime_of(doc.get('a')).text, expected: '1979-05-27T07:32:00Z')?;
    testing.assert_eq(actual: datetime_of(doc.get('b')).text, expected: '1979-05-27T07:32:00Z')?;
    // A space not followed by a time is the end of a local date.
    let d = parse('d = 1979-05-27 # released\n')?;
    testing.assert_eq(actual: datetime_of(d.get('d')).kind, expected: DatetimeKind.LocalDate)?;
    return Result.Ok(void);
}

@test
fn test_datetime_validation() -> Result<Void, Error> {
    testing.assert_err(parse('d = 1979-13-01\n'))?;              // month 13
    testing.assert_err(parse('d = 1979-00-01\n'))?;              // month 0
    testing.assert_err(parse('d = 1979-02-30\n'))?;              // February 30th
    testing.assert_err(parse('d = 2100-02-29\n'))?;              // 2100 is not a leap year
    testing.assert_err(parse('d = 1979-05-27T24:00:00Z\n'))?;    // hour 24
    testing.assert_err(parse('d = 1979-05-27T07:61:00Z\n'))?;    // minute 61
    testing.assert_err(parse('d = 1979-05-27T07:32:61Z\n'))?;    // second 61
    testing.assert_err(parse('d = 1979-05-27T07:32:00+24:00\n'))?; // offset hour 24
    testing.assert_err(parse('d = 1979-05-27T07:32\n'))?;        // seconds required in 1.0
    testing.assert_err(parse('d = 1979-05-27T07:32:00.\n'))?;    // empty fraction
    testing.assert_err(parse('t = 07:32\n'))?;                   // seconds required
    // Leap cases that must pass.
    let ok = parse('a = 2000-02-29\nb = 2024-02-29\nc = 1990-12-31T23:59:60Z\n')?;
    testing.assert_eq(actual: datetime_of(ok.get('a')).text, expected: '2000-02-29')?;
    testing.assert_eq(actual: datetime_of(ok.get('c')).text, expected: '1990-12-31T23:59:60Z')?;
    return Result.Ok(void);
}

@test
fn test_datetime_bridge() -> Result<Void, Error> {
    // An offset date-time names an instant; the local kinds refuse to guess.
    let doc = parse('a = 2023-11-14T22:13:20Z\nb = 2023-11-14T23:13:20+01:00\nc = 1979-05-27\n')?;
    let a = datetime_of(doc.get('a')).to_datetime()?;
    testing.assert_eq(actual: a.unix_seconds(), expected: 1700000000)?;
    let b = datetime_of(doc.get('b')).to_datetime()?;
    testing.assert_eq(actual: b.unix_seconds(), expected: 1700000000)?;
    testing.assert_err(datetime_of(doc.get('c')).to_datetime())?;
    return Result.Ok(void);
}

@test
fn test_table_headers() -> Result<Void, Error> {
    let doc = parse(
        'title = "root"\n\n[server]\nhost = "x"\nport = 80\n\n[server.limits]\nrate = 5\n\n[owner]\nname = "ada"\n'
    )?;
    testing.assert_eq(actual: doc.get_string('title'), expected: Option.Some('root'))?;
    testing.assert_eq(actual: doc.get_string('server.host'), expected: Option.Some('x'))?;
    testing.assert_eq(actual: doc.get_int('server.port'), expected: Option.Some(80))?;
    testing.assert_eq(actual: doc.get_int('server.limits.rate'), expected: Option.Some(5))?;
    testing.assert_eq(actual: doc.get_string('owner.name'), expected: Option.Some('ada'))?;
    // Header trivia: whitespace around the path, comments after, blank lines.
    let laid = parse('[ a . b ] # comment\nx = 1\n')?;
    testing.assert_eq(actual: laid.get_int('a.b.x'), expected: Option.Some(1))?;
    // Quoted segments in headers.
    let q = parse('["dotted.name".sub]\nv = 1\n')?;
    let v = q.as_table()
        .and_then((m) => m.get('dotted.name'))
        .and_then((t) => t.get('sub.v'))
        .and_then((t) => t.as_int());
    testing.assert_eq(actual: v, expected: Option.Some(1))?;
    return Result.Ok(void);
}

@test
fn test_super_table_after_subtable() -> Result<Void, Error> {
    // [x.y.z.w] creates x, x.y, x.y.z implicitly; defining [x] later is legal
    // — once.
    let doc = parse('[x.y.z.w]\na = 1\n[x]\nb = 2\n')?;
    testing.assert_eq(actual: doc.get_int('x.y.z.w.a'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('x.b'), expected: Option.Some(2))?;
    testing.assert_err(parse('[x.y]\n[x]\n[x]\n'))?;      // second [x] redefines
    testing.assert_err(parse('[a]\nx = 1\n[a]\ny = 2\n'))?; // plain duplicate
    return Result.Ok(void);
}

@test
fn test_array_of_tables() -> Result<Void, Error> {
    let doc = parse(
        '[[products]]\nname = "hammer"\nsku = 1\n\n[[products]]\n\n[[products]]\nname = "nail"\n'
    )?;
    let products = doc.get_array('products');
    testing.assert_eq(actual: len_of(products), expected: 3)?;
    testing.assert_eq(
        actual: doc.get('products').and_then((v) => v.at(0)).and_then((v) => v.get_string('name')),
        expected: Option.Some('hammer'),
    )?;
    testing.assert_eq(
        actual: doc.get('products').and_then((v) => v.at(1)).and_then((v) => v.as_table()).map(
            (m) => m.keys().len()
        ),
        expected: Option.Some(0),
    )?;
    testing.assert_eq(
        actual: doc.get('products').and_then((v) => v.at(2)).and_then((v) => v.get_string('name')),
        expected: Option.Some('nail'),
    )?;
    return Result.Ok(void);
}

@test
fn test_nested_arrays_of_tables() -> Result<Void, Error> {
    // The spec's fruit example: sub-tables and nested arrays attach to the
    // most recent element of the enclosing array.
    let doc = parse(
        '[[fruit]]\nname = "apple"\n\n[fruit.physical]\ncolor = "red"\n\n[[fruit.variety]]\nname = "red delicious"\n\n[[fruit.variety]]\nname = "granny smith"\n\n[[fruit]]\nname = "banana"\n\n[[fruit.variety]]\nname = "plantain"\n'
    )?;
    let apple = doc.get('fruit').and_then((v) => v.at(0));
    testing.assert_eq(
        actual: apple.and_then((v) => v.get_string('physical.color')),
        expected: Option.Some('red'),
    )?;
    testing.assert_eq(
        actual: apple.and_then((v) => v.get_array('variety')).map((l) => l.len()),
        expected: Option.Some(2),
    )?;
    let banana = doc.get('fruit').and_then((v) => v.at(1));
    testing.assert_eq(
        actual: banana.and_then((v) => v.get_array('variety')).map((l) => l.len()),
        expected: Option.Some(1),
    )?;
    // Each [[fruit]] element gets its own sub-namespace: defining
    // [fruit.physical] again under the second element is legal.
    let two = parse('[[f]]\n[f.p]\nx = 1\n[[f]]\n[f.p]\nx = 2\n')?;
    testing.assert_eq(
        actual: two.get('f').and_then((v) => v.at(1)).and_then((v) => v.get_int('p.x')),
        expected: Option.Some(2),
    )?;
    return Result.Ok(void);
}

@test
fn test_header_redefinition_errors() -> Result<Void, Error> {
    // A value or static array can never become a table or array of tables.
    testing.assert_err(parse('a = 1\n[a]\n'))?;
    testing.assert_err(parse('a = 1\n[a.b]\n'))?;
    testing.assert_err(parse('fruit = []\n[[fruit]]\n'))?;
    testing.assert_err(parse('t = { x = 1 }\n[t]\n'))?;      // inline tables are closed
    testing.assert_err(parse('t = { x = 1 }\n[t.y]\n'))?;
    // A table and an array of tables cannot trade places.
    testing.assert_err(parse('[a]\n[[a]]\n'))?;
    testing.assert_err(parse('[[a]]\n[a]\n'))?;
    testing.assert_err(parse('[fruit.physical]\n[[fruit]]\n'))?; // implicit table, not array
    return Result.Ok(void);
}

@test
fn test_dotted_vs_header_rules() -> Result<Void, Error> {
    // A table defined by dotted keys cannot be reopened by a header …
    testing.assert_err(parse('[fruit]\napple.color = "red"\n[fruit.apple]\n'))?;
    testing.assert_err(parse('apple.color = "red"\n[apple]\n'))?;
    // … but a header may add a new sub-table beneath one.
    let doc = parse('[fruit]\napple.color = "red"\n[fruit.apple.texture]\nsmooth = true\n')?;
    testing.assert_eq(actual: doc.get_string('fruit.apple.color'), expected: Option.Some('red'))?;
    testing.assert_eq(
        actual: doc.get_bool('fruit.apple.texture.smooth'),
        expected: Option.Some(true),
    )?;
    // And dotted keys cannot extend a table another block defined.
    testing.assert_err(parse('[a.b.c]\nz = 9\n[a]\nb.c.t = 9\n'))?;
    testing.assert_err(parse('[a.b]\nx = 1\n[a]\nb.y = 2\n'))?;
    return Result.Ok(void);
}

@test
fn test_header_key_collisions() -> Result<Void, Error> {
    // A key/value cannot land on a header-defined table, and vice versa.
    testing.assert_err(parse('[a.b]\nx = 1\n[a]\nb = 1\n'))?;
    testing.assert_err(parse('[a]\nb = 1\n[a.b]\n'))?;
    testing.assert_err(parse('[a]\nb = 1\n[a.b.c]\n'))?;
    return Result.Ok(void);
}

@test
fn test_header_syntax_errors() -> Result<Void, Error> {
    testing.assert_err(parse('[a\n'))?;          // unclosed
    testing.assert_err(parse('[]\n'))?;          // empty
    testing.assert_err(parse('[a.]\n'))?;        // trailing dot
    testing.assert_err(parse('[a] junk\n'))?;    // trailing junk
    testing.assert_err(parse('[[a]\n'))?;        // mismatched close
    testing.assert_err(parse('[[a]]]\n'))?;
    testing.assert_err(parse('[a]]\n'))?;
    return Result.Ok(void);
}

@test
fn test_manifest_shape() -> Result<Void, Error> {
    // The driving use case, end to end: an api.toml-shaped document.
    let doc = parse(
        '# The Anthropic client manifest.\nspec_url = "https://example.com/openapi.yml"\nspec_hash = "6d5c96a4"\n\n[generate]\noperations = [\n  "messages_post",     # the flagship call\n  "models_get",\n]\n\n[auth]\nheader = "x-api-key"\n\n[overrides.messages_post]\nname = "create_message"\nnote = "matches the hand-written client"\n'
    )?;
    testing.assert_eq(actual: doc.get_string('spec_hash'), expected: Option.Some('6d5c96a4'))?;
    testing.assert_eq(actual: len_of(doc.get_array('generate.operations')), expected: 2)?;
    testing.assert_eq(actual: doc.get_string('auth.header'), expected: Option.Some('x-api-key'))?;
    testing.assert_eq(
        actual: doc.get_string('overrides.messages_post.name'),
        expected: Option.Some('create_message'),
    )?;
    return Result.Ok(void);
}

@test
fn test_navigation_misses() -> Result<Void, Error> {
    let doc = parse('a.b = 1\ns = "x"\n')?;
    testing.assert_eq(actual: doc.get('nope').is_none(), expected: true)?;
    testing.assert_eq(actual: doc.get('a.b.c').is_none(), expected: true)?;  // through a value
    testing.assert_eq(actual: doc.get_int('s'), expected: Option.None)?;     // wrong type
    testing.assert_eq(actual: doc.get_int('a.b'), expected: Option.Some(1))?;
    testing.assert_eq(actual: doc.get_int('missing.port').unwrap_or(8080), expected: 8080)?;
    // at() on a non-array misses; kind() names kinds in TOML vocabulary.
    testing.assert_eq(actual: doc.get('s').and_then((v) => v.at(0)).is_none(), expected: true)?;
    testing.assert_eq(
        actual: doc.get('a').map((v) => v.kind()),
        expected: Option.Some('table'),
    )?;
    testing.assert_eq(actual: Toml.Int(1).kind(), expected: 'integer')?;
    testing.assert_eq(actual: Toml.Double(1.0).kind(), expected: 'float')?;
    return Result.Ok(void);
}

@test
fn test_error_positions() -> Result<Void, Error> {
    // Errors carry a line/column so a manifest typo is findable.
    let err = parse('good = 1\nbad = 03\n');
    let msg = match err {
        Ok(_) => '',
        Err(e) => e.message(),
    };
    testing.assert_eq(actual: msg.contains('line 2'), expected: true)?;
    return Result.Ok(void);
}

// --- Cursor, the strict reader ---

@test
fn test_cursor_reads_and_paths() -> Result<Void, Error> {
    let doc = parse(
        'name = "x"\nn = 3\nok = true\nrate = 0.5\nwhen = 1979-05-27\n[t]\nlist = [10, 20]\n'
    )?;
    let at = cursor(doc);
    testing.assert_eq(actual: at.field('name').string()?, expected: 'x')?;
    testing.assert_eq(actual: at.field('n').int()?, expected: 3)?;
    testing.assert_eq(actual: at.field('ok').bool()?, expected: true)?;
    testing.assert_eq(actual: at.field('rate').double()?, expected: 0.5)?;
    testing.assert_eq(actual: at.field('when').datetime()?.text, expected: '1979-05-27')?;
    testing.assert_eq(actual: at.field('n').double()?, expected: 3.0)?; // Int widens
    let items = at.field('t').field('list').list()?;
    testing.assert_eq(actual: items.len(), expected: 2)?;
    testing.assert_eq(actual: items[1].int()?, expected: 20)?;
    testing.assert_eq(actual: items[1].path, expected: 't.list[1]')?;
    testing.assert_eq(actual: at.field('t').table()?.field('list').path, expected: 't.list')?;
    testing.assert_eq(actual: at.field('n').raw()?.kind(), expected: 'integer')?;
    return Result.Ok(void);
}

@test
fn test_cursor_errors_name_paths() -> Result<Void, Error> {
    let doc = parse('[server]\nhost = "x"\nports = [1, "two"]\n')?;
    let at = cursor(doc);
    // A missing required key is Missing, with the full path.
    let missing = at.field('server').field('port').int();
    testing.assert_eq(
        actual: decode_msg(missing.map((n) => '${n}')),
        expected: 'missing required key server.port',
    )?;
    // A wrong type is Shape: path, expected, found.
    let shape = at.field('server').field('host').int();
    testing.assert_eq(
        actual: decode_msg(shape.map((n) => '${n}')),
        expected: 'expected an integer at server.host, got string',
    )?;
    let deep = at.field('server').field('ports').list()?[1].int();
    testing.assert_eq(
        actual: decode_msg(deep.map((n) => '${n}')),
        expected: 'expected an integer at server.ports[1], got string',
    )?;
    // Navigating through a non-table marks absent rather than failing early.
    let through = at.field('server').field('host').field('deep').string();
    testing.assert_eq(
        actual: decode_msg(through),
        expected: 'missing required key server.host.deep',
    )?;
    // An error at the root itself still has something to say.
    let root_err = cursor(Toml.Int(1)).table();
    testing.assert_eq(actual: root_err.is_err(), expected: true)?;
    let root_msg = match cursor(Toml.Int(1)).string() {
        Ok(_) => '',
        Err(e) => e.message(),
    };
    testing.assert_eq(
        actual: root_msg,
        expected: 'expected a string at the document root, got integer',
    )?;
    return Result.Ok(void);
}

fn decode_msg(_ r: Result<String, DecodeError>) -> String {
    return match r {
        Ok(v) => 'ok: ${v}',
        Err(e) => e.message(),
    };
}

@test
fn test_cursor_optional_reads() -> Result<Void, Error> {
    let doc = parse('a = 1\n[t]\nx = "s"\n')?;
    let at = cursor(doc);
    // Absent is None, at any depth.
    testing.assert_eq(actual: at.field('missing').opt_int()?, expected: Option.None)?;
    testing.assert_eq(actual: at.field('t').field('y').opt_string()?, expected: Option.None)?;
    testing.assert_eq(actual: at.field('t').field('y').opt_table()?.is_none(), expected: true)?;
    testing.assert_eq(actual: at.field('t').field('y').opt_list()?.is_none(), expected: true)?;
    testing.assert_eq(actual: at.field('t').field('y').opt_datetime()?.is_none(), expected: true)?;
    // Present is Some.
    testing.assert_eq(actual: at.field('a').opt_int()?, expected: Option.Some(1))?;
    // Present with the wrong type is a Shape error, not None.
    testing.assert_err(at.field('t').field('x').opt_int())?;
    // unexpected() rejects at the cursor's path on the caller's terms.
    let custom: Result<Int, DecodeError> = at.field('a').unexpected('a semver string');
    testing.assert_eq(
        actual: decode_msg(custom.map((n) => '${n}')),
        expected: 'expected a semver string at a, got integer',
    )?;
    return Result.Ok(void);
}

// --- the forcing function: decode a realistic api.toml into typed structs ---
//
// The manifest shape is api-access.md § The manifest: spec URL + content-hash
// pin, the selected operations, auth (which the spec cannot state), the beta
// lane, and per-operation overrides each carrying its why.

struct ApiAuth {
    let header: String;
    let env: Option<String>;
}

struct ApiOverride {
    let operation: String;
    let name: String;
    let note: Option<String>;
}

struct ApiManifest {
    let spec_url: String;
    let spec_hash: String;
    let operations: List<String>;
    let beta_lane: Bool;
    let auth: ApiAuth;
    let overrides: List<ApiOverride>;
}

fn manifest_from_toml(_ at: Cursor) -> Result<ApiManifest, DecodeError> {
    let root = at.table()?;
    let mut operations: List<String> = [];
    for op in root.field('generate').field('operations').list()? {
        operations.push(op.string()?);
    }
    let auth_at = root.field('auth').table()?;
    let auth = ApiAuth {
        header: auth_at.field('header').string()?,
        env: auth_at.field('env').opt_string()?,
    };
    let mut overrides: List<ApiOverride> = [];
    let overrides_table = root.field('overrides').opt_table()?;
    if overrides_table.is_some() {
        let ot = match overrides_table {
            Some(c) => c,
            None => root, // unreachable: checked is_some
        };
        let names = match ot.raw()?.as_table() {
            Some(m) => m.keys(),
            None => [],
        };
        for op_name in names {
            let entry = ot.field(op_name).table()?;
            overrides.push(ApiOverride {
                operation: op_name,
                name: entry.field('name').string()?,
                note: entry.field('note').opt_string()?,
            });
        }
    }
    return Result.Ok(ApiManifest {
        spec_url: root.field('spec_url').string()?,
        spec_hash: root.field('spec_hash').string()?,
        operations: operations,
        beta_lane: root.field('generate').field('beta_lane').opt_bool()?.unwrap_or(false),
        auth: auth,
        overrides: overrides,
    });
}

let api_toml: String = '# Generated-client manifest for pkgs/anthropic.\nspec_url = "https://raw.githubusercontent.com/anthropics/anthropic-sdk-python/main/.stats.yml"\nspec_hash = "6d5c96a4e77e63d5302e630e2d9dd7fc"\n\n[generate]\noperations = [\n  "messages_post",              # the flagship call\n  "messages_count_tokens_post",\n  "models_list",\n]\n\n[auth]\nheader = "x-api-key"            # 4 of 7 slate specs declare no securitySchemes\nenv = "ANTHROPIC_API_KEY"\n\n[overrides.messages_post]\nname = "create_message"\nnote = "matches the hand-written client"\n';

@test
fn test_manifest_forcing_function() -> Result<Void, Error> {
    let doc = parse(api_toml)?;
    let m = manifest_from_toml(cursor(doc))?;
    testing.assert_eq(actual: m.spec_hash, expected: '6d5c96a4e77e63d5302e630e2d9dd7fc')?;
    testing.assert_eq(actual: m.operations.len(), expected: 3)?;
    testing.assert_eq(actual: m.operations[2], expected: 'models_list')?;
    testing.assert_eq(actual: m.beta_lane, expected: false)?; // absent → the default
    testing.assert_eq(actual: m.auth.header, expected: 'x-api-key')?;
    testing.assert_eq(actual: m.auth.env, expected: Option.Some('ANTHROPIC_API_KEY'))?;
    testing.assert_eq(actual: m.overrides.len(), expected: 1)?;
    testing.assert_eq(actual: m.overrides[0].operation, expected: 'messages_post')?;
    testing.assert_eq(actual: m.overrides[0].name, expected: 'create_message')?;
    return Result.Ok(void);
}

@test
fn test_manifest_typo_is_findable() -> Result<Void, Error> {
    // The manifest case this reader exists for: a typo fails with the path.
    let missing = parse(api_toml.replace('spec_hash', 'spec_hsah'))?;
    let e1 = match manifest_from_toml(cursor(missing)) {
        Ok(_) => '',
        Err(e) => e.message(),
    };
    testing.assert_eq(actual: e1, expected: 'missing required key spec_hash')?;

    let wrong = parse(api_toml.replace('"models_list"', '3'))?;
    let e2 = match manifest_from_toml(cursor(wrong)) {
        Ok(_) => '',
        Err(e) => e.message(),
    };
    testing.assert_eq(
        actual: e2,
        expected: 'expected a string at generate.operations[2], got integer',
    )?;
    return Result.Ok(void);
}
