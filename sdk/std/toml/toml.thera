//! std.toml — parse TOML 1.0.0 configuration.
//!
//! Import as: import std.toml
//!
//! The structural `Toml` value models any TOML document; `parse` reads text
//! into one (the root is always a `Table`). TOML is a config format, so the
//! reading surface is config-shaped: `get` takes a dotted path — the format's
//! own spelling — and the typed `get_*` helpers read one value leniently.
//!
//! ```thera
//! let doc = toml.parse(text)?;
//! let name = doc.get_string('package.name').unwrap_or('unnamed');
//! let port = doc.get_int('server.port').unwrap_or(8080);
//! let ops = doc.get_array('generate.operations').unwrap_or([]);
//! ```
//!
//! Unlike JSON there is no null: absence is the only optionality, so every
//! lenient read is an `Option` and a miss is `None`.
//!
//! The strict counterpart is `Cursor` — `json.Cursor`'s mirror, deliberately
//! name-for-name — for the reader where a wrong shape is a failure that has
//! to be findable: navigating accumulates a path in TOML's own dotted
//! spelling, and a failed read names it
//! (`expected a string at generate.operations[2], got integer`).
//!
//! ```thera
//! let at = toml.cursor(doc);
//! let url = at.field('spec_url').string()?;          // required
//! let lane = at.field('generate').field('beta_lane').opt_bool()?;  // absent → None
//! ```
//!
//! `get`'s path splits on `.` before matching, so it addresses bare-keyed
//! tables only; a key that itself contains a dot (quoted in the source) is
//! reachable via `as_table` and direct map access.
//!
//! The full TOML 1.0.0 grammar: scalar values including the four date-time
//! kinds, arrays, inline tables, dotted keys, and `[table]` /
//! `[[array-of-tables]]` headers with TOML's definition rules (a table is
//! defined once; dotted keys extend only their own block's tables; inline
//! tables and static arrays are closed). Conformance is pinned by the
//! vendored toml-test snapshot in `third_party/toml-test/` (run by
//! `conformance_test.thera`). Parse-only until a tool needs to write a
//! manifest — see docs/stdlib.md § `std.toml`.
//!
//! Implementation: a hand-written scanner + recursive-descent parser, pure
//! Thera, following std.json's.

import std.char;
import std.math;
import std.time;

/// The structural TOML value. `Int` and `Double` mirror TOML's own
/// integer/float split; there is no null variant because TOML has none.
pub enum Toml {
    Bool(Bool),
    Int(Int),
    Double(Double),
    Str(String),
    Datetime(Datetime),
    Array(List<Toml>),
    Table(Map<String, Toml>),    // insertion-ordered
}

/// Which of TOML's four date-time shapes a `Datetime` carries.
pub enum DatetimeKind {
    OffsetDateTime,    // 1979-05-27T07:32:00Z
    LocalDateTime,     // 1979-05-27T07:32:00
    LocalDate,         // 1979-05-27
    LocalTime,         // 07:32:00
}

/// A TOML date-time: the kind plus the validated, normalized source text
/// (the date/time delimiter as `T`, zone `z` as `Z`; components as written,
/// each range-checked — including the day against its month and leap year).
pub struct Datetime {
    let kind: DatetimeKind;
    let text: String;
}

impl Datetime {
    /// The instant this date-time names, via `time.DateTime.parse_rfc3339` —
    /// for `OffsetDateTime` only. The three local kinds carry no zone, so
    /// they name no instant; converting one is an error, not a guess.
    pub fn to_datetime(self) -> Result<time.DateTime, Error> {
        let offset = match self.kind {
            OffsetDateTime => true,
            _ => false,
        };
        if !offset {
            let err: Error = TomlError.Syntax(
                '${self.text} is a local date-time and names no instant');
            return Result.Err(err);
        }
        return time.DateTime.parse_rfc3339(self.text);
    }
}

/// What `parse` can reject. A domain error: implements the common `Error`.
/// One variant covers both lexical errors and TOML's document-level rules
/// (duplicate keys, extending a closed table) — the message names the rule
/// and the position.
pub enum TomlError {
    Syntax(String),
}

impl Error for TomlError {
    pub fn message(self) -> String {
        return match self {
            Syntax(msg) => msg,
        };
    }
}

impl Display for TomlError {
    pub fn display(self) -> String {
        return self.message();
    }
}

// --- accessors ---

impl Toml {
    /// The value at a dotted path (`'server.port'`), or None anywhere along
    /// the way — a missing key, a non-table in the middle, a non-table self.
    /// Segments are matched literally after splitting on `.`, so quoted keys
    /// containing dots are not addressable here (use `as_table`).
    pub fn get(self, _ path: String) -> Option<Toml> {
        let mut cur = self;
        for seg in path.split('.') {
            let next = match cur {
                Table(m) => m.get(seg),
                _ => Option.None,
            };
            if next.is_none() {
                return Option.None;
            }
            cur = match next {
                Some(v) => v,
                None => cur, // unreachable: next is Some
            };
        }
        return Option.Some(cur);
    }

    /// An array element by index (None if not an array or out of range).
    pub fn at(self, _ index: Int) -> Option<Toml> {
        return match self {
            Array(items) => items.get(index),
            _ => Option.None,
        };
    }

    pub fn as_bool(self) -> Option<Bool> {
        return match self {
            Bool(b) => Option.Some(b),
            _ => Option.None,
        };
    }

    /// The value as an Int — for an `Int` only; a TOML float never quietly
    /// narrows.
    pub fn as_int(self) -> Option<Int> {
        return match self {
            Int(n) => Option.Some(n),
            _ => Option.None,
        };
    }

    /// The value as a Double — for a `Double`, or an `Int` widened.
    pub fn as_double(self) -> Option<Double> {
        return match self {
            Double(x) => Option.Some(x),
            Int(n) => Option.Some(n.to_double()),
            _ => Option.None,
        };
    }

    pub fn as_string(self) -> Option<String> {
        return match self {
            Str(s) => Option.Some(s),
            _ => Option.None,
        };
    }

    pub fn as_datetime(self) -> Option<Datetime> {
        return match self {
            Datetime(dt) => Option.Some(dt),
            _ => Option.None,
        };
    }

    pub fn as_array(self) -> Option<List<Toml>> {
        return match self {
            Array(items) => Option.Some(items),
            _ => Option.None,
        };
    }

    pub fn as_table(self) -> Option<Map<String, Toml>> {
        return match self {
            Table(m) => Option.Some(m),
            _ => Option.None,
        };
    }

    /// The value's kind, in TOML's own vocabulary — for error messages.
    pub fn kind(self) -> String {
        return match self {
            Bool(_) => 'bool',
            Int(_) => 'integer',
            Double(_) => 'float',
            Str(_) => 'string',
            Datetime(_) => 'date-time',
            Array(_) => 'array',
            Table(_) => 'table',
        };
    }

    // The typed path reads — `get` composed with one `as_*`, since that pair
    // is what a config consumer writes every time.

    pub fn get_bool(self, _ path: String) -> Option<Bool> {
        return self.get(path).and_then((v) => v.as_bool());
    }

    pub fn get_int(self, _ path: String) -> Option<Int> {
        return self.get(path).and_then((v) => v.as_int());
    }

    pub fn get_double(self, _ path: String) -> Option<Double> {
        return self.get(path).and_then((v) => v.as_double());
    }

    pub fn get_string(self, _ path: String) -> Option<String> {
        return self.get(path).and_then((v) => v.as_string());
    }

    pub fn get_array(self, _ path: String) -> Option<List<Toml>> {
        return self.get(path).and_then((v) => v.as_array());
    }

    pub fn get_table(self, _ path: String) -> Option<Map<String, Toml>> {
        return self.get(path).and_then((v) => v.as_table());
    }
}

// --- the strict reader: Cursor ---

/// What a strict read can reject, distinct from `TomlError` deliberately: a
/// syntax error is the *document's* failure, a shape mismatch is a
/// disagreement between the document and the reader's schema — different
/// problems with different fixes.
///
/// Both variants lead with a path, because that is what makes a failure
/// findable. Build them through `Cursor`'s readers rather than by hand.
pub enum DecodeError {
    /// The path of a required key the document does not have.
    Missing(String),
    /// A path, what was expected there, and what was found (`Toml.kind()`).
    Shape(String, String, String),
}

impl Error for DecodeError {
    pub fn message(self) -> String {
        return match self {
            Missing(path) => 'missing required key ${path}',
            Shape(path, expected, found) => 'expected ${expected} at ${path}, got ${found}',
        };
    }
}

impl Display for DecodeError {
    pub fn display(self) -> String {
        return self.message();
    }
}

/// A `Toml` paired with where in the document it came from.
///
/// The accessors above (`get`, `get_int`, …) suit a **lenient** reader:
/// navigation never fails and a miss is `Option.None` — the right reading for
/// a config consumer with defaults. A manifest reader wants the opposite: a
/// required key that is absent or the wrong type is an error, and the error
/// has to name where — as a **path**, in TOML's own dotted spelling, because
/// that is the line the user typed.
///
/// ```thera
/// fn auth_from_toml(_ at: toml.Cursor) -> Result<Auth, toml.DecodeError> {
///     return Result.Ok(Auth {
///         header: at.field('header').string()?,
///         env: at.field('env').opt_string()?,
///     });
/// }
///
/// let root = toml.cursor(toml.parse(text)?);
/// let auth = auth_from_toml(root.field('auth').table()?)?;
/// ```
///
/// **Navigating never fails; reading does.** `field` and `index` always
/// answer a cursor — for a key the document doesn't have, one at the extended
/// path marked absent — so a required field is one `?`, at the read, where
/// the wanted type is known. Chains work the same way:
/// `at.field('a').field('b').string()?`. A decoder that can be handed a
/// non-table should open with `let t = at.table()?;`, which validates and
/// reports `at`'s own path. With no null in TOML, absent is the only thing
/// the `opt_*` readers tolerate — a present key of the wrong type is always
/// a `Shape` error.
pub struct Cursor {
    let value: Toml;
    /// Where `value` sits, in TOML's own spelling: `overrides.messages_post`
    /// or `generate.operations[2]`. Empty for the document root.
    let path: String;
    /// False only for a cursor produced by navigating to a key or an index
    /// the document does not have — what lets a required read say
    /// `missing required key auth.header` rather than a shape error.
    let present: Bool;
}

/// A cursor on `value` as a document root (its path is empty; errors at the
/// root itself say `the document root`).
pub fn cursor(_ value: Toml) -> Cursor {
    return Cursor { value: value, path: '', present: true };
}

impl Cursor {
    // --- navigating (never fails) ---

    /// The cursor at `key` of this table — at the extended path, marked
    /// absent if this is not a table or has no such key.
    pub fn field(self, _ key: String) -> Cursor {
        let mut at = key;
        if self.path != '' {
            at = '${self.path}.${key}';
        }
        return match self.value {
            Table(fields) => match fields.get(key) {
                Some(found) => Cursor { value: found, path: at, present: true },
                None => absent(at),
            },
            _ => absent(at),
        };
    }

    /// The cursor at element `i` of this array — marked absent if this is
    /// not an array or `i` is out of range.
    pub fn index(self, _ i: Int) -> Cursor {
        let at = '${self.path}[${i}]';
        return match self.value {
            Array(items) => match items.get(i) {
                Some(found) => Cursor { value: found, path: at, present: true },
                None => absent(at),
            },
            _ => absent(at),
        };
    }

    // --- reading a required value ---

    pub fn string(self) -> Result<String, DecodeError> {
        return self.require('a string', self.value.as_string());
    }

    pub fn int(self) -> Result<Int, DecodeError> {
        return self.require('an integer', self.value.as_int());
    }

    pub fn double(self) -> Result<Double, DecodeError> {
        return self.require('a float', self.value.as_double());
    }

    pub fn bool(self) -> Result<Bool, DecodeError> {
        return self.require('a boolean', self.value.as_bool());
    }

    pub fn datetime(self) -> Result<Datetime, DecodeError> {
        return self.require('a date-time', self.value.as_datetime());
    }

    /// This cursor, having checked it holds a table — the shape a decoder
    /// opens with so that a non-table is blamed on its own path rather than
    /// on the first field read out of it.
    pub fn table(self) -> Result<Cursor, DecodeError> {
        return self.require('a table', self.as_self_if_table());
    }

    /// The elements of this array, each as a cursor whose path carries its
    /// index — so a failure deep in a list says `generate.operations[2]`
    /// without the caller building that string.
    pub fn list(self) -> Result<List<Cursor>, DecodeError> {
        return self.require('an array', self.as_element_cursors());
    }

    /// The value itself, checked only for presence. For a subschema the
    /// reader does not model, where any TOML is legitimate.
    pub fn raw(self) -> Result<Toml, DecodeError> {
        return self.require('a value', Option.Some(self.value));
    }

    // --- reading an optional value ---
    //
    // Absent reads as `Option.None`; a present key of the wrong type is
    // still a `Shape` error. TOML has no null, so absent is the whole story.

    pub fn opt_string(self) -> Result<Option<String>, DecodeError> {
        return self.allow('a string', self.value.as_string());
    }

    pub fn opt_int(self) -> Result<Option<Int>, DecodeError> {
        return self.allow('an integer', self.value.as_int());
    }

    pub fn opt_double(self) -> Result<Option<Double>, DecodeError> {
        return self.allow('a float', self.value.as_double());
    }

    pub fn opt_bool(self) -> Result<Option<Bool>, DecodeError> {
        return self.allow('a boolean', self.value.as_bool());
    }

    pub fn opt_datetime(self) -> Result<Option<Datetime>, DecodeError> {
        return self.allow('a date-time', self.value.as_datetime());
    }

    pub fn opt_table(self) -> Result<Option<Cursor>, DecodeError> {
        return self.allow('a table', self.as_self_if_table());
    }

    pub fn opt_list(self) -> Result<Option<List<Cursor>>, DecodeError> {
        return self.allow('an array', self.as_element_cursors());
    }

    // --- rejecting on your own terms ---

    /// A `Shape` error at this cursor's path, for a check the readers can't
    /// make: `at.field('spec_hash').unexpected('a 40-char hex digest')`.
    pub fn unexpected<T>(self, _ expected: String) -> Result<T, DecodeError> {
        return Result.Err(DecodeError.Shape(self.spot(), expected, self.value.kind()));
    }

    // --- the two readers everything above shares ---

    /// Absent is `Missing`; the wrong kind is `Shape`; otherwise the value.
    fn require<T>(self, _ expected: String, _ read: Option<T>) -> Result<T, DecodeError> {
        if !self.present {
            return Result.Err(DecodeError.Missing(self.spot()));
        }
        return match read {
            Some(value) => Result.Ok(value),
            None => self.unexpected(expected),
        };
    }

    /// Absent is `None`; the wrong kind is still `Shape`. Tolerating an
    /// absent key is not tolerating a key of the wrong type — the first is
    /// the schema saying "optional", the second is a bug in the document.
    fn allow<T>(self, _ expected: String, _ read: Option<T>) -> Result<Option<T>, DecodeError> {
        if !self.present {
            return Result.Ok(Option.None);
        }
        return match read {
            Some(value) => Result.Ok(Option.Some(value)),
            None => self.unexpected(expected),
        };
    }

    /// The path for an error message — the root's empty path made sayable.
    fn spot(self) -> String {
        if self.path == '' {
            return 'the document root';
        }
        return self.path;
    }

    fn as_self_if_table(self) -> Option<Cursor> {
        return match self.value {
            Table(_) => Option.Some(self),
            _ => Option.None,
        };
    }

    fn as_element_cursors(self) -> Option<List<Cursor>> {
        return match self.value {
            Array(items) => Option.Some(items.enumerate().map((it) => Cursor {
                value: it.value,
                path: '${self.path}[${it.index}]',
                present: true,
            }).to_list()),
            _ => Option.None,
        };
    }
}

/// An absent cursor. The placeholder value is unobservable through the
/// readers — `require`/`allow` answer on `present` before looking at it.
fn absent(_ path: String) -> Cursor {
    return Cursor { value: Toml.Bool(false), path: path, present: false };
}

// --- parsing ---

/// A cursor over the input's code points.
struct Parser {
    let chars: List<Int>;
    let mut pos: Int;
    let len: Int;
}

/// The separator used to render a key path into the `states` bookkeeping map
/// — NUL, which no decoded key can contain a run of alongside real segments
/// ambiguously enough to collide.
let path_sep: String = String.from_chars([0]);

pub fn parse(_ text: String) -> Result<Toml, TomlError> {
    let cps = text.chars();
    let p = Parser { chars: cps, pos: 0, len: cps.len() };
    // The document root, built line by line. `states` records how each table
    // was created — 'header' ([a]), 'implicit' (an intermediate of a header
    // path), 'array' ([[a]]), or 'dotted:<block>' (a dotted key, scoped to
    // the block that wrote it) — keyed by NUL-joined path. A table with data
    // but no state is a value's interior (an inline table, a static array's
    // element): closed to every later definition.
    let mut root: Map<String, Toml> = [:];
    let mut states: Map<String, String> = [:];
    // Key/value lines land in the current block: the root until the first
    // header, then the table (or array element) the latest header named.
    let mut cur_map = root;
    let mut cur_path = '';
    let mut block = 0;

    let mut going = true;
    while going {
        p.skip_inline_ws();
        let c = p.peek();
        if c == -1 {
            going = false;
        } else if c == char.HASH {
            p.skip_comment()?;
        } else if c == char.LF || c == char.CR {
            p.expect_newline()?;
        } else if c == char.LBRACKET {
            let is_array = p.cp_at(p.pos + 1) == char.LBRACKET;
            if is_array {
                p.pos = p.pos + 2;
            } else {
                p.pos = p.pos + 1;
            }
            let path = p.parse_key()?;
            if p.peek() != char.RBRACKET {
                return Result.Err(p.syntax('expected ] to close the table header'));
            }
            p.pos = p.pos + 1;
            if is_array {
                if p.peek() != char.RBRACKET {
                    return Result.Err(p.syntax('expected ]] to close the array header'));
                }
                p.pos = p.pos + 1;
            }
            block = block + 1;
            let target = p.open_table(root, states, path, is_array)?;
            cur_map = target.map;
            cur_path = target.path;
            p.expect_line_end()?;
        } else {
            let path = p.parse_key()?;
            if p.peek() != char.EQ {
                return Result.Err(p.syntax('expected = after key'));
            }
            p.pos = p.pos + 1;
            p.skip_inline_ws();
            let value = p.parse_value()?;
            p.insert(cur_map, states, cur_path, block, path, value)?;
            p.expect_line_end()?;
        }
    }
    return Result.Ok(Toml.Table(root));
}

/// Where a table header points: the table key/value lines now land in, and
/// its rendered path (array elements carry their index as a pseudo-segment,
/// so each `[[a]]` element gets distinct sub-paths in the state map).
struct BlockTarget {
    let map: Map<String, Toml>;
    let path: String;
}

impl Parser {
    /// The current code point, or -1 at end of input.
    fn peek(self) -> Int {
        return self.cp_at(self.pos);
    }

    /// The code point at an absolute index, or -1 out of range.
    fn cp_at(self, _ i: Int) -> Int {
        if i < 0 || i >= self.len {
            return -1;
        }
        return self.chars[i];
    }

    /// Skip spaces and tabs — TOML's inline whitespace; never a newline.
    fn skip_inline_ws(self) -> Void {
        let mut going = true;
        while going {
            let c = self.peek();
            if c == char.SPACE || c == char.TAB {
                self.pos = self.pos + 1;
            } else {
                going = false;
            }
        }
        return void;
    }

    fn syntax(self, _ msg: String) -> TomlError {
        return TomlError.Syntax('${msg} at ${self.position()}');
    }

    /// A human-readable line/column for the current position.
    fn position(self) -> String {
        let mut line = 1;
        let mut col = 1;
        let mut i = 0;
        while i < self.pos {
            if self.chars[i] == char.LF {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
            i = i + 1;
        }
        return 'line ${line} col ${col}';
    }

    /// True (and consumes) if the upcoming code points spell `lit`.
    fn match_literal(self, _ lit: String) -> Bool {
        let want = lit.chars();
        for p in want.enumerate() {
            if self.cp_at(self.pos + p.index) != p.value {
                return false;
            }
        }
        self.pos = self.pos + want.len();
        return true;
    }

    /// Consume one newline: LF, or CRLF (a bare CR is an error).
    fn expect_newline(self) -> Result<Void, TomlError> {
        let c = self.peek();
        if c == char.LF {
            self.pos = self.pos + 1;
            return Result.Ok(void);
        }
        if c == char.CR {
            if self.cp_at(self.pos + 1) == char.LF {
                self.pos = self.pos + 2;
                return Result.Ok(void);
            }
            return Result.Err(self.syntax('bare carriage return'));
        }
        return Result.Err(self.syntax('expected a newline'));
    }

    /// After a key/value pair: optional whitespace and comment, then a
    /// newline or end of input. Anything else is trailing junk.
    fn expect_line_end(self) -> Result<Void, TomlError> {
        self.skip_inline_ws();
        if self.peek() == char.HASH {
            self.skip_comment()?;
        }
        if self.peek() == -1 {
            return Result.Ok(void);
        }
        return self.expect_newline();
    }

    /// Consume `#` to end of line, validating the comment's characters
    /// (control characters other than tab are not permitted).
    fn skip_comment(self) -> Result<Void, TomlError> {
        self.pos = self.pos + 1; // consume '#'
        let mut going = true;
        while going {
            let c = self.peek();
            if c == -1 || c == char.LF || c == char.CR {
                going = false;
            } else if c == char.TAB || (c >= char.SPACE && c != char.DEL) {
                self.pos = self.pos + 1;
            } else {
                return Result.Err(self.syntax('control character in comment'));
            }
        }
        return Result.Ok(void);
    }

    // --- keys ---

    /// A key: one or more dot-separated segments, each bare or quoted.
    fn parse_key(self) -> Result<List<String>, TomlError> {
        let mut segs: List<String> = [];
        let mut going = true;
        while going {
            self.skip_inline_ws();
            let c = self.peek();
            if c == char.DQUOTE {
                segs.push(self.parse_basic_string()?);
            } else if c == char.SQUOTE {
                segs.push(self.parse_literal_string()?);
            } else if is_bare_key_char(c) {
                let start = self.pos;
                while is_bare_key_char(self.peek()) {
                    self.pos = self.pos + 1;
                }
                segs.push(String.from_chars(self.chars.slice(start, self.pos)));
            } else {
                return Result.Err(self.syntax('expected a key'));
            }
            self.skip_inline_ws();
            if self.peek() == char.DOT {
                self.pos = self.pos + 1;
            } else {
                going = false;
            }
        }
        return Result.Ok(segs);
    }

    /// Insert `value` at the dotted `path` under the block rooted at `base`
    /// (whose rendered path is `prefix`), enforcing TOML's dotted-key rules:
    /// an intermediate segment may create a table, or descend into one that a
    /// dotted key of the **same block** created. Everything else — a value,
    /// an inline table, and any table defined by a header or by another
    /// block's dotted keys — is closed to dotted extension.
    fn insert(
        self,
        _ base: Map<String, Toml>,
        _ states: Map<String, String>,
        _ prefix: String,
        _ block: Int,
        _ path: List<String>,
        _ value: Toml,
    ) -> Result<Void, TomlError> {
        let mut cur = base;
        let mut marks = states;
        let mut walked = prefix;
        let mut i = 0;
        while i < path.len() - 1 {
            let seg = path[i];
            walked = '${walked}${path_sep}${seg}';
            let found = cur.get(seg);
            if found.is_none() {
                let child: Map<String, Toml> = [:];
                cur[seg] = Toml.Table(child);
                marks[walked] = 'dotted:${block}';
                cur = child;
            } else {
                let existing = match found {
                    Some(v) => v,
                    None => Toml.Bool(false), // unreachable: found is Some
                };
                let state = marks.get(walked).unwrap_or('');
                if state != 'dotted:${block}' {
                    if state == '' && existing.kind() == 'table' {
                        return Result.Err(self.syntax(
                            'cannot extend inline table ${render_path(path, i)}'));
                    }
                    if state == '' {
                        return Result.Err(
                            self.syntax(
                                '${render_path(path, i)} is already a ${existing.kind()}, not a table')
                        );
                    }
                    return Result.Err(self.syntax(
                        'dotted keys cannot extend ${render_path(path, i)}, which was defined elsewhere'));
                }
                cur = table_of(existing);
            }
            i = i + 1;
        }
        let leaf = path[path.len() - 1];
        if cur.get(leaf).is_some() {
            return Result.Err(self.syntax('duplicate key ${render_path(path, path.len() - 1)}'));
        }
        cur[leaf] = value;
        return Result.Ok(void);
    }

    /// Walk a `[table]` / `[[array]]` header path and return the block it
    /// opens. Intermediates may be created (as 'implicit'), or descended
    /// through — a header-defined or dotted-defined table directly, an array
    /// of tables via its last element. The final segment carries the real
    /// rules: a `[table]` may name a fresh key or promote an 'implicit'
    /// table, exactly once; a `[[array]]` may name a fresh key or append to
    /// an existing array of tables. Everything else is a redefinition error.
    fn open_table(
        self,
        _ root: Map<String, Toml>,
        _ states: Map<String, String>,
        _ path: List<String>,
        _ is_array: Bool,
    ) -> Result<BlockTarget, TomlError> {
        let mut cur = root;
        let mut marks = states;
        let mut walked = '';
        let mut i = 0;
        while i < path.len() - 1 {
            let seg = path[i];
            walked = '${walked}${path_sep}${seg}';
            let found = cur.get(seg);
            if found.is_none() {
                let child: Map<String, Toml> = [:];
                cur[seg] = Toml.Table(child);
                marks[walked] = 'implicit';
                cur = child;
            } else {
                let existing = match found {
                    Some(v) => v,
                    None => Toml.Bool(false), // unreachable: found is Some
                };
                let state = marks.get(walked).unwrap_or('');
                if state == '' {
                    return Result.Err(self.syntax(
                        '${render_path(path, i)} is already a ${existing.kind()}, not a table'));
                }
                if state == 'array' {
                    // Descend into the last element; its index becomes a
                    // pseudo-segment so per-element sub-paths stay distinct.
                    let items = array_of(existing);
                    let last = items.len() - 1;
                    cur = table_of(items[last]);
                    walked = '${walked}${path_sep}#${last}';
                } else {
                    cur = table_of(existing); // 'header' / 'implicit' / 'dotted:*'
                }
            }
            i = i + 1;
        }

        let leaf = path[path.len() - 1];
        walked = '${walked}${path_sep}${leaf}';
        let found = cur.get(leaf);
        let state = marks.get(walked).unwrap_or('');
        let full = render_path(path, path.len() - 1);

        if is_array {
            if found.is_none() {
                let elem: Map<String, Toml> = [:];
                let items: List<Toml> = [Toml.Table(elem)];
                cur[leaf] = Toml.Array(items);
                marks[walked] = 'array';
                return Result.Ok(BlockTarget { map: elem, path: '${walked}${path_sep}#0' });
            }
            if state == 'array' {
                let existing = match found {
                    Some(v) => v,
                    None => Toml.Bool(false), // unreachable: found is Some
                };
                let mut items = array_of(existing);
                let elem: Map<String, Toml> = [:];
                items.push(Toml.Table(elem));
                let last = items.len() - 1;
                return Result.Ok(BlockTarget { map: elem, path: '${walked}${path_sep}#${last}' });
            }
            return Result.Err(self.syntax('cannot redefine ${full} as an array of tables'));
        }

        if found.is_none() {
            let child: Map<String, Toml> = [:];
            cur[leaf] = Toml.Table(child);
            marks[walked] = 'header';
            return Result.Ok(BlockTarget { map: child, path: walked });
        }
        if state == 'implicit' {
            let existing = match found {
                Some(v) => v,
                None => Toml.Bool(false), // unreachable: found is Some
            };
            marks[walked] = 'header'; // defining a previously-implicit super-table
            return Result.Ok(BlockTarget { map: table_of(existing), path: walked });
        }
        if state == 'header' {
            return Result.Err(self.syntax('table ${full} is already defined'));
        }
        if state == 'array' {
            return Result.Err(self.syntax('${full} is already an array of tables'));
        }
        if state.starts_with('dotted:') {
            return Result.Err(self.syntax(
                'cannot reopen table ${full}, which dotted keys defined'));
        }
        let existing = match found {
            Some(v) => v,
            None => Toml.Bool(false), // unreachable: found is Some
        };
        return Result.Err(self.syntax('${full} is already a ${existing.kind()}, not a table'));
    }

    // --- values ---

    fn parse_value(self) -> Result<Toml, TomlError> {
        let c = self.peek();
        if c == char.DQUOTE {
            if self.cp_at(self.pos + 1) == char.DQUOTE && self.cp_at(self.pos + 2) == char.DQUOTE {
                let s = self.parse_ml_basic_string()?;
                return Result.Ok(Toml.Str(s));
            }
            let s = self.parse_basic_string()?;
            return Result.Ok(Toml.Str(s));
        }
        if c == char.SQUOTE {
            if self.cp_at(self.pos + 1) == char.SQUOTE && self.cp_at(self.pos + 2) == char.SQUOTE {
                let s = self.parse_ml_literal_string()?;
                return Result.Ok(Toml.Str(s));
            }
            let s = self.parse_literal_string()?;
            return Result.Ok(Toml.Str(s));
        }
        if c == char.LBRACKET {
            return self.parse_array();
        }
        if c == char.LBRACE {
            return self.parse_inline_table();
        }
        if self.match_literal('true') {
            return Result.Ok(Toml.Bool(true));
        }
        if self.match_literal('false') {
            return Result.Ok(Toml.Bool(false));
        }
        if c == char.PLUS || c == char.MINUS || c == 105 || c == 110 || char.is_digit(c) {
            return self.parse_number_or_datetime(); // 'i'nf, 'n'an
        }
        if c == -1 {
            return Result.Err(self.syntax('unexpected end of input'));
        }
        return Result.Err(self.syntax('expected a value'));
    }

    fn parse_array(self) -> Result<Toml, TomlError> {
        self.pos = self.pos + 1; // consume '['
        let mut items: List<Toml> = [];
        let mut going = true;
        while going {
            self.skip_array_trivia()?;
            if self.peek() == char.RBRACKET {
                self.pos = self.pos + 1;
                going = false;
            } else {
                let value = self.parse_value()?;
                items.push(value);
                self.skip_array_trivia()?;
                let c = self.peek();
                if c == char.COMMA {
                    self.pos = self.pos + 1; // trailing comma is legal: loop re-checks ']'
                } else if c == char.RBRACKET {
                    self.pos = self.pos + 1;
                    going = false;
                } else {
                    return Result.Err(self.syntax('expected , or ] in array'));
                }
            }
        }
        return Result.Ok(Toml.Array(items));
    }

    /// Whitespace, newlines, and comments — all legal between array elements.
    fn skip_array_trivia(self) -> Result<Void, TomlError> {
        let mut going = true;
        while going {
            let c = self.peek();
            if c == char.SPACE || c == char.TAB {
                self.pos = self.pos + 1;
            } else if c == char.HASH {
                self.skip_comment()?;
            } else if c == char.LF || c == char.CR {
                self.expect_newline()?;
            } else {
                going = false;
            }
        }
        return Result.Ok(void);
    }

    /// `{ key = value, … }` — single-line, no trailing comma; dotted keys
    /// work inside, scoped to this table. An inline table is closed: nothing
    /// may extend it later.
    fn parse_inline_table(self) -> Result<Toml, TomlError> {
        self.pos = self.pos + 1; // consume '{'
        let mut fields: Map<String, Toml> = [:];
        // A private state map: dotted keys inside the braces share one scope,
        // and nothing here leaks into the document's states — which is what
        // keeps an inline table's interior closed to later definitions.
        let mut states: Map<String, String> = [:];
        self.skip_inline_ws();
        if self.peek() == char.RBRACE {
            self.pos = self.pos + 1;
            return Result.Ok(Toml.Table(fields));
        }
        let mut going = true;
        while going {
            let path = self.parse_key()?;
            if self.peek() != char.EQ {
                return Result.Err(self.syntax('expected = after key'));
            }
            self.pos = self.pos + 1;
            self.skip_inline_ws();
            let value = self.parse_value()?;
            self.insert(fields, states, '', 0, path, value)?;
            self.skip_inline_ws();
            let c = self.peek();
            if c == char.COMMA {
                self.pos = self.pos + 1; // the next pair is required — no trailing comma
            } else if c == char.RBRACE {
                self.pos = self.pos + 1;
                going = false;
            } else {
                return Result.Err(self.syntax('expected , or } in inline table'));
            }
        }
        return Result.Ok(Toml.Table(fields));
    }

    // --- strings ---

    /// The current char is the opening `"`; single-line.
    fn parse_basic_string(self) -> Result<String, TomlError> {
        self.pos = self.pos + 1; // consume opening '"'
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            let c = self.peek();
            if c == -1 || c == char.LF || c == char.CR {
                return Result.Err(self.syntax('unterminated string'));
            }
            self.pos = self.pos + 1;
            if c == char.DQUOTE {
                going = false;
            } else if c == char.BACKSLASH {
                self.parse_escape(out)?;
            } else if is_forbidden_string_char(c) {
                return Result.Err(self.syntax('control character in string'));
            } else {
                out.push(c);
            }
        }
        return Result.Ok(String.from_chars(out));
    }

    /// The current char is the opening `'`; single-line, no escapes.
    fn parse_literal_string(self) -> Result<String, TomlError> {
        self.pos = self.pos + 1; // consume opening '\''
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            let c = self.peek();
            if c == -1 || c == char.LF || c == char.CR {
                return Result.Err(self.syntax('unterminated string'));
            }
            self.pos = self.pos + 1;
            if c == char.SQUOTE {
                going = false;
            } else if is_forbidden_string_char(c) {
                return Result.Err(self.syntax('control character in string'));
            } else {
                out.push(c);
            }
        }
        return Result.Ok(String.from_chars(out));
    }

    /// The upcoming chars are `"""`. Trims a newline immediately after the
    /// opener, normalizes CRLF to LF, and supports the line-ending backslash.
    fn parse_ml_basic_string(self) -> Result<String, TomlError> {
        self.pos = self.pos + 3; // consume '"""'
        self.trim_leading_newline()?;
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            let c = self.peek();
            if c == -1 {
                return Result.Err(self.syntax('unterminated multiline string'));
            }
            if c == char.DQUOTE && self.quotes_ahead(char.DQUOTE) >= 3 {
                self.close_ml_delimiter(char.DQUOTE, out)?;
                going = false;
            } else if c == char.BACKSLASH {
                self.pos = self.pos + 1;
                if self.at_line_ending_backslash() {
                    self.skip_escaped_whitespace()?;
                } else {
                    self.parse_escape(out)?;
                }
            } else if c == char.LF {
                self.pos = self.pos + 1;
                out.push(char.LF);
            } else if c == char.CR {
                self.expect_newline()?; // validates CRLF; a bare CR errors
                out.push(char.LF);
            } else if is_forbidden_string_char(c) {
                return Result.Err(self.syntax('control character in string'));
            } else {
                self.pos = self.pos + 1;
                out.push(c);
            }
        }
        return Result.Ok(String.from_chars(out));
    }

    /// The upcoming chars are `'''`. Same shape, no escapes.
    fn parse_ml_literal_string(self) -> Result<String, TomlError> {
        self.pos = self.pos + 3; // consume "'''"
        self.trim_leading_newline()?;
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            let c = self.peek();
            if c == -1 {
                return Result.Err(self.syntax('unterminated multiline string'));
            }
            if c == char.SQUOTE && self.quotes_ahead(char.SQUOTE) >= 3 {
                self.close_ml_delimiter(char.SQUOTE, out)?;
                going = false;
            } else if c == char.LF {
                self.pos = self.pos + 1;
                out.push(char.LF);
            } else if c == char.CR {
                self.expect_newline()?;
                out.push(char.LF);
            } else if is_forbidden_string_char(c) {
                return Result.Err(self.syntax('control character in string'));
            } else {
                self.pos = self.pos + 1;
                out.push(c);
            }
        }
        return Result.Ok(String.from_chars(out));
    }

    /// A newline immediately after an opening multiline delimiter is trimmed.
    fn trim_leading_newline(self) -> Result<Void, TomlError> {
        let c = self.peek();
        if c == char.LF || c == char.CR {
            return self.expect_newline();
        }
        return Result.Ok(void);
    }

    /// How many consecutive `quote` chars start at the current position.
    fn quotes_ahead(self, _ quote: Int) -> Int {
        let mut n = 0;
        while self.cp_at(self.pos + n) == quote {
            n = n + 1;
        }
        return n;
    }

    /// The current position starts a run of >= 3 `quote`s: the last three are
    /// the closing delimiter, up to two before it belong to the content, and
    /// three or more before it are malformed.
    fn close_ml_delimiter(self, _ quote: Int, _ out: List<Int>) -> Result<Void, TomlError> {
        let run = self.quotes_ahead(quote);
        if run > 5 {
            return Result.Err(self.syntax('too many quotes in multiline string'));
        }
        let mut extra = run - 3;
        while extra > 0 {
            out.push(quote);
            extra = extra - 1;
        }
        self.pos = self.pos + run;
        return Result.Ok(void);
    }

    /// After a backslash in a multiline basic string: is this the line-ending
    /// form (only whitespace up to a newline)? Peeks; consumes nothing.
    fn at_line_ending_backslash(self) -> Bool {
        let mut i = self.pos;
        while self.cp_at(i) == char.SPACE || self.cp_at(i) == char.TAB {
            i = i + 1;
        }
        let c = self.cp_at(i);
        return c == char.LF || c == char.CR;
    }

    /// Consume the whitespace (including newlines) a line-ending backslash
    /// escapes, up to the next non-whitespace character.
    fn skip_escaped_whitespace(self) -> Result<Void, TomlError> {
        let mut going = true;
        while going {
            let c = self.peek();
            if c == char.SPACE || c == char.TAB {
                self.pos = self.pos + 1;
            } else if c == char.LF || c == char.CR {
                self.expect_newline()?;
            } else {
                going = false;
            }
        }
        return Result.Ok(void);
    }

    /// Decode one escape sequence (the `\` is already consumed) into `out`.
    /// TOML's set — note `\/` is not in it, and `\uXXXX`/`\UXXXXXXXX` must
    /// name a Unicode scalar value (no surrogates, unlike JSON's pairing).
    fn parse_escape(self, _ out: List<Int>) -> Result<Void, TomlError> {
        let e = self.peek();
        if e == -1 {
            return Result.Err(self.syntax('unterminated escape'));
        }
        self.pos = self.pos + 1;
        if e == char.DQUOTE {
            out.push(char.DQUOTE);
        } else if e == char.BACKSLASH {
            out.push(char.BACKSLASH);
        } else if e == 98 {
            out.push(char.BS); // \b
        } else if e == 102 {
            out.push(char.FF); // \f
        } else if e == 110 {
            out.push(char.LF); // \n
        } else if e == 114 {
            out.push(char.CR); // \r
        } else if e == 116 {
            out.push(char.TAB); // \t
        } else if e == 117 {
            out.push(self.parse_unicode_escape(4)?); // \u
        } else if e == 85 {
            out.push(self.parse_unicode_escape(8)?); // \U
        } else {
            return Result.Err(self.syntax('invalid escape'));
        }
        return Result.Ok(void);
    }

    /// `digits` hex digits naming a Unicode scalar value.
    fn parse_unicode_escape(self, _ digits: Int) -> Result<Int, TomlError> {
        let mut value = 0;
        let mut i = 0;
        while i < digits {
            let d = match char.hex_digit_value(self.peek()) {
                Some(v) => v,
                None => -1,
            };
            if d < 0 {
                return Result.Err(self.syntax('invalid hex digit in unicode escape'));
            }
            value = value * 16 + d;
            self.pos = self.pos + 1;
            i = i + 1;
        }
        if (value >= 55296 && value <= 57343) || value > 1114111 {
            return Result.Err(self.syntax('escape is not a unicode scalar value'));
        }
        return Result.Ok(value);
    }

    // --- numbers and date-times ---

    /// A value starting with a digit or sign: a number, unless the lookahead
    /// spells a date (`DDDD-`) or time (`DD:`).
    fn parse_number_or_datetime(self) -> Result<Toml, TomlError> {
        let c = self.peek();
        if char.is_digit(c) {
            let date = char.is_digit(self.cp_at(self.pos + 1))
                && char.is_digit(self.cp_at(self.pos + 2))
                && char.is_digit(self.cp_at(self.pos + 3))
                && self.cp_at(self.pos + 4) == char.MINUS;
            let time = char.is_digit(self.cp_at(self.pos + 1))
                && self.cp_at(self.pos + 2) == char.COLON;
            if date {
                return self.parse_datetime(true);
            }
            if time {
                return self.parse_datetime(false);
            }
        }
        return self.parse_number();
    }

    /// A date-time (TOML 1.0.0 § Offset Date-Time through § Local Time). The
    /// text is normalized as it is scanned — the delimiter to `T`, `z` to `Z`
    /// — and every component is range-checked, including the day against its
    /// month and leap year. Which of the four kinds this is falls out of what
    /// follows the date: nothing (LocalDate), a time (LocalDateTime), a time
    /// plus `Z` or a numeric offset (OffsetDateTime).
    fn parse_datetime(self, _ with_date: Bool) -> Result<Toml, TomlError> {
        let mut out: List<Int> = [];
        let mut kind = DatetimeKind.LocalTime;
        if with_date {
            let year = self.read_fixed_digits(4, out)?;
            self.expect_cp(char.MINUS, out)?;
            let month = self.read_fixed_digits(2, out)?;
            self.expect_cp(char.MINUS, out)?;
            let day = self.read_fixed_digits(2, out)?;
            if month < 1 || month > 12 {
                return Result.Err(self.syntax('month out of range in date-time'));
            }
            if day < 1 || day > days_in_month(year, month) {
                return Result.Err(self.syntax('day out of range in date-time'));
            }
            // A time part follows via 'T'/'t', or a space that is genuinely a
            // delimiter (the next chars spell HH:) — otherwise the space ends
            // a plain local date.
            let c = self.peek();
            let delimited = c == 84 || c == 116; // 'T' 't'
            let spaced = c == char.SPACE
                && char.is_digit(self.cp_at(self.pos + 1))
                && char.is_digit(self.cp_at(self.pos + 2))
                && self.cp_at(self.pos + 3) == char.COLON;
            if !delimited && !spaced {
                return Result.Ok(Toml.Datetime(Datetime {
                    kind: DatetimeKind.LocalDate,
                    text: String.from_chars(out),
                }));
            }
            self.pos = self.pos + 1;
            out.push(84); // normalize the delimiter to 'T'
            kind = DatetimeKind.LocalDateTime;
        }

        let hour = self.read_fixed_digits(2, out)?;
        self.expect_cp(char.COLON, out)?;
        let minute = self.read_fixed_digits(2, out)?;
        self.expect_cp(char.COLON, out)?;
        let second = self.read_fixed_digits(2, out)?;
        if hour > 23 {
            return Result.Err(self.syntax('hour out of range in date-time'));
        }
        if minute > 59 {
            return Result.Err(self.syntax('minute out of range in date-time'));
        }
        if second > 60 { // 60 admits a leap second, per RFC 3339
            return Result.Err(self.syntax('second out of range in date-time'));
        }
        if self.peek() == char.DOT {
            self.expect_cp(char.DOT, out)?;
            if !char.is_digit(self.peek()) {
                return Result.Err(self.syntax('expected a digit after . in date-time'));
            }
            while char.is_digit(self.peek()) {
                out.push(self.peek());
                self.pos = self.pos + 1;
            }
        }

        if with_date {
            let c = self.peek();
            if c == 90 || c == 122 { // 'Z' 'z'
                self.pos = self.pos + 1;
                out.push(90); // normalize to 'Z'
                kind = DatetimeKind.OffsetDateTime;
            } else if c == char.PLUS || c == char.MINUS {
                out.push(c);
                self.pos = self.pos + 1;
                let oh = self.read_fixed_digits(2, out)?;
                self.expect_cp(char.COLON, out)?;
                let om = self.read_fixed_digits(2, out)?;
                if oh > 23 || om > 59 {
                    return Result.Err(self.syntax('offset out of range in date-time'));
                }
                kind = DatetimeKind.OffsetDateTime;
            }
        }
        return Result.Ok(Toml.Datetime(Datetime { kind: kind, text: String.from_chars(out) }));
    }

    /// Exactly `n` ASCII digits, appended to `out`; returns their value.
    fn read_fixed_digits(self, _ n: Int, _ out: List<Int>) -> Result<Int, TomlError> {
        let mut value = 0;
        let mut i = 0;
        while i < n {
            let c = self.peek();
            if !char.is_digit(c) {
                return Result.Err(self.syntax('expected a digit in date-time'));
            }
            value = value * 10 + (c - char.DIGIT_0);
            out.push(c);
            self.pos = self.pos + 1;
            i = i + 1;
        }
        return Result.Ok(value);
    }

    /// The exact code point, appended to `out`.
    fn expect_cp(self, _ cp: Int, _ out: List<Int>) -> Result<Void, TomlError> {
        if self.peek() != cp {
            return Result.Err(self.syntax('malformed date-time'));
        }
        out.push(cp);
        self.pos = self.pos + 1;
        return Result.Ok(void);
    }

    fn parse_number(self) -> Result<Toml, TomlError> {
        let mut negative = false;
        let mut signed = false;
        let c = self.peek();
        if c == char.PLUS {
            self.pos = self.pos + 1;
            signed = true;
        } else if c == char.MINUS {
            self.pos = self.pos + 1;
            negative = true;
            signed = true;
        }

        if self.match_literal('inf') {
            if negative {
                return Result.Ok(Toml.Double(0.0 - math.INFINITY));
            }
            return Result.Ok(Toml.Double(math.INFINITY));
        }
        if self.match_literal('nan') {
            return Result.Ok(Toml.Double(math.NAN)); // sign of nan is not observable
        }

        // Hex / octal / binary — prefix forms take no sign.
        if !signed && self.peek() == char.DIGIT_0 {
            let marker = self.cp_at(self.pos + 1);
            if marker == 120 { // 'x'
                return self.parse_radix_int(16);
            }
            if marker == 111 { // 'o'
                return self.parse_radix_int(8);
            }
            if marker == 98 { // 'b'
                return self.parse_radix_int(2);
            }
        }

        // Decimal: int part, optional fraction, optional exponent.
        let int_digits = self.digit_run()?;
        if int_digits.len() > 1 && int_digits[0] == char.DIGIT_0 {
            return Result.Err(self.syntax('number cannot have a leading zero'));
        }
        let mut is_double = false;
        let mut token: List<Int> = [];
        if negative {
            token.push(char.MINUS);
        }
        for d in int_digits {
            token.push(d);
        }
        if self.peek() == char.DOT {
            is_double = true;
            token.push(char.DOT);
            self.pos = self.pos + 1;
            for d in self.digit_run()? {
                token.push(d);
            }
        }
        if self.peek() == 101 || self.peek() == 69 { // 'e' 'E'
            is_double = true;
            token.push(101);
            self.pos = self.pos + 1;
            let s = self.peek();
            if s == char.PLUS || s == char.MINUS {
                token.push(s);
                self.pos = self.pos + 1;
            }
            for d in self.digit_run()? { // zero-prefixed exponents are legal
                token.push(d);
            }
        }

        let text = String.from_chars(token);
        if is_double {
            return match text.to_double() {
                Some(x) => Result.Ok(Toml.Double(x)),
                None => Result.Err(self.syntax('invalid number')),
            };
        }
        if exceeds_i64(int_digits, negative) {
            return Result.Err(self.syntax('integer is out of range'));
        }
        return match text.to_int() {
            Some(n) => Result.Ok(Toml.Int(n)),
            None => Result.Err(self.syntax('invalid number')),
        };
    }

    /// A run of ASCII digits with underscores allowed strictly between them.
    /// Returns the digits with the underscores removed.
    fn digit_run(self) -> Result<List<Int>, TomlError> {
        if !char.is_digit(self.peek()) {
            return Result.Err(self.syntax('expected a digit'));
        }
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            let c = self.peek();
            if char.is_digit(c) {
                out.push(c);
                self.pos = self.pos + 1;
            } else if c == char.UNDERSCORE {
                self.pos = self.pos + 1;
                if !char.is_digit(self.peek()) {
                    return Result.Err(self.syntax('an underscore must sit between digits'));
                }
            } else {
                going = false;
            }
        }
        return Result.Ok(out);
    }

    /// A `0x`/`0o`/`0b` integer (the `0` is current; the marker is next).
    /// Leading zeros are legal here; the value must fit in a 64-bit signed
    /// integer.
    fn parse_radix_int(self, _ base: Int) -> Result<Toml, TomlError> {
        self.pos = self.pos + 2; // consume '0x' / '0o' / '0b'
        let mut digits: List<Int> = [];
        let mut seen = false;
        let mut going = true;
        while going {
            let c = self.peek();
            let d = match char.hex_digit_value(c) {
                Some(v) => v,
                None => -1,
            };
            if d >= 0 && d < base {
                digits.push(d);
                seen = true;
                self.pos = self.pos + 1;
            } else if c == char.UNDERSCORE && seen {
                self.pos = self.pos + 1;
                let next = match char.hex_digit_value(self.peek()) {
                    Some(v) => v,
                    None => -1,
                };
                if next < 0 || next >= base {
                    return Result.Err(self.syntax('an underscore must sit between digits'));
                }
            } else {
                going = false;
            }
        }
        if !seen {
            return Result.Err(self.syntax('expected a digit'));
        }
        // Strip leading zeros, then bound the magnitude to i64.
        let mut start = 0;
        while start < digits.len() - 1 && digits[start] == 0 {
            start = start + 1;
        }
        let significant = digits.slice(start, digits.len());
        let mut over = false;
        if base == 16 {
            over = significant.len() > 16 || (significant.len() == 16 && significant[0] > 7);
        } else if base == 8 {
            over = significant.len() > 21;
        } else {
            over = significant.len() > 63; // binary
        }
        if over {
            return Result.Err(self.syntax('integer is out of range'));
        }
        let mut value = 0;
        for d in significant {
            value = value * base + d;
        }
        return Result.Ok(Toml.Int(value));
    }
}

// --- helpers ---

/// Bare keys are ASCII letters, digits, `_`, and `-`.
fn is_bare_key_char(_ c: Int) -> Bool {
    return char.is_alphanumeric(c) || c == char.UNDERSCORE || c == char.MINUS;
}

/// Raw control characters are not permitted in any string form; tab is the
/// one exception (newlines are handled by each form's own rules).
fn is_forbidden_string_char(_ c: Int) -> Bool {
    return (c < char.SPACE && c != char.TAB) || c == char.DEL;
}

/// The table inside a `Toml.Table` — caller has already established the kind.
fn table_of(_ v: Toml) -> Map<String, Toml> {
    return match v {
        Table(m) => m,
        _ => [:],
    };
}

/// The list inside a `Toml.Array` — caller has already established the kind.
fn array_of(_ v: Toml) -> List<Toml> {
    return match v {
        Array(items) => items,
        _ => [],
    };
}

/// Days in a month, honoring the Gregorian leap-year rule.
fn days_in_month(_ year: Int, _ month: Int) -> Int {
    if month == 2 {
        let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
        if leap {
            return 29;
        }
        return 28;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    return 31;
}

/// The first `count + 1` segments of a key path, dotted, for error messages.
fn render_path(_ path: List<String>, _ last: Int) -> String {
    let mut parts: List<String> = [];
    let mut i = 0;
    while i <= last {
        parts.push(path[i]);
        i = i + 1;
    }
    return parts.join('.');
}

/// Does a decimal magnitude (digit code points, no leading zeros) exceed the
/// i64 range for its sign? Compared textually so overflow never wraps.
fn exceeds_i64(_ digits: List<Int>, _ negative: Bool) -> Bool {
    let mut limit = '9223372036854775807'.chars();
    if negative {
        limit = '9223372036854775808'.chars();
    }
    if digits.len() != limit.len() {
        return digits.len() > limit.len();
    }
    let mut i = 0;
    while i < digits.len() {
        if digits[i] != limit[i] {
            return digits[i] > limit[i];
        }
        i = i + 1;
    }
    return false;
}
