//! Tests for the std.http client. Every request goes to *our own server*, spawned
//! on a loopback port in the same process — the hermetic loop the build order was
//! chosen for: no network, no fixture server, and the two halves check each other.
//!
//! Note what that does and does not prove. It exercises the client against a
//! correct peer; it cannot catch the two of us agreeing on the same misreading of
//! HTTP. `common_test.thera` is the guard for that — it pins each direction against
//! literal bytes, so a shared misconception has to survive being spelled out.

import std.testing;
import std.env;
import std.io;
import std.net;
import std.fiber;
import std.time;
import std.json as _;
import std.http.sse;

// Through the public barrel, not the `client` sibling: `http.get(...)` is the
// surface users touch, so it is the one worth testing.
import std.http;

import 'common';
import 'server';

/// Serve `handler` on loopback and return its base `http://127.0.0.1:<port>`.
fn serving(_ handler: (common.Request) -> Result<common.Response, Error>) -> Result<String, Error> {
    let listener = net.listen('127.0.0.1:0')?;
    let addr = listener.local_addr()?;
    fiber.spawn(() => server.serve_listener(listener, handler));
    return Result.Ok('http://' + addr);
}

/// Echoes the request back as JSON, so a test can assert on what the server
/// actually received — the client's real output.
fn echo(_ req: common.Request) -> Result<common.Response, Error> {
    let seen: Map<String, json.Json> = [:];
    for key in req.headers.keys() {
        seen[key] = json.str(req.headers[key]);
    }
    return Result.Ok(server.json(200, json.obj([
        'method': json.str(req.method),
        'url': json.str(req.url),
        'body': json.str(req.body.to_string()?),
        'headers': json.obj(seen),
    ])));
}

/// A field of the echo handler's JSON report.
fn field(_ resp: common.Response, _ name: String) -> Result<String, Error> {
    let doc = resp.json()?;
    return match doc {
        Object(fields) => match fields.get(name) {
            Some(v) => match v {
                Str(s) => Result.Ok(s),
                _ => Result.Err(error('${name} is not a string')),
            },
            None => Result.Err(error('no field ${name}')),
        },
        _ => Result.Err(error('not a JSON object')),
    };
}

/// A header as the server saw it.
fn seen_header(_ resp: common.Response, _ name: String) -> Result<String, Error> {
    let doc = resp.json()?;
    return match doc {
        Object(fields) => match fields.get('headers') {
            Some(hs) => match hs {
                Object(m) => match m.get(name) {
                    Some(v) => match v {
                        Str(s) => Result.Ok(s),
                        _ => Result.Err(error('${name} is not a string')),
                    },
                    None => Result.Ok('(absent)'),
                },
                _ => Result.Err(error('headers is not an object')),
            },
            None => Result.Err(error('no headers field')),
        },
        _ => Result.Err(error('not a JSON object')),
    };
}

// --- the basics ---

@test
fn gets_a_response() -> Result<Void, Error> {
    let base = serving((_req) => Result.Ok(server.text(200, 'hello')))?;
    let resp = http.get(base + '/greet')?;
    testing.assert_eq(actual: resp.status, expected: 200)?;
    testing.assert(resp.is_ok(), message: '200 is ok')?;
    return testing.assert_eq(actual: resp.text()?, expected: 'hello');
}

/// The request line carries the path, not the whole URL — the absolute form is for
/// proxies only, and a server matching on it would 404 every route.
@test
fn the_request_line_carries_the_path_not_the_url() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/a/b?q=1&r=2')?;
    return testing.assert_eq(actual: field(resp, 'url')?, expected: '/a/b?q=1&r=2');
}

@test
fn posts_a_body() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.post(base + '/submit', body: 'the payload'.bytes())?;
    testing.assert_eq(actual: field(resp, 'method')?, expected: 'POST')?;
    testing.assert_eq(actual: field(resp, 'body')?, expected: 'the payload')?;
    // The codec derives content-length from the body.
    return testing.assert_eq(actual: seen_header(resp, 'content-length')?, expected: '11');
}

@test
fn reads_a_json_response() -> Result<Void, Error> {
    let base = serving((_req) => Result.Ok(server.json(200, json.obj([
        'n': json.int(7),
        'ok': json.bool(true),
    ]))))?;
    let doc = http.get(base + '/j')?.json()?;
    let n = match doc {
        Object(fields) => match fields.get('n') {
            Some(v) => match v {
                Int(i) => i,
                _ => 0,
            },
            None => 0,
        },
        _ => 0,
    };
    return testing.assert_eq(actual: n, expected: 7);
}

/// A 4xx is a perfectly good response, not an error: errors are values, and
/// HttpError is for exchanges that did not happen.
@test
fn a_404_is_a_response_not_an_error() -> Result<Void, Error> {
    let base = serving((_req) => Result.Ok(server.text(404, 'nope')))?;
    let resp = http.get(base + '/missing')?;
    testing.assert_eq(actual: resp.status, expected: 404)?;
    testing.assert(!resp.is_ok(), message: '404 is not ok')?;
    return testing.assert_eq(actual: resp.text()?, expected: 'nope');
}

/// Nor does the client chase a 3xx — it hands the redirect back for the caller to
/// act on.
@test
fn a_redirect_is_not_followed() -> Result<Void, Error> {
    let base = serving((_req) => {
        let r = server.empty(302);
        r.headers['location'] = '/elsewhere';
        return Result.Ok(r);
    })?;
    let resp = http.get(base + '/start')?;
    testing.assert_eq(actual: resp.status, expected: 302)?;
    return testing.assert_eq(actual: resp.headers['location'], expected: '/elsewhere');
}

// --- headers ---

/// `host` is mandatory in HTTP/1.1, and comes from the URL.
@test
fn sends_a_host_header_from_the_url() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/x')?;
    // `base` is 'http://127.0.0.1:<port>' — the authority is what host must read.
    let authority = base.slice('http://'.len(), base.len());
    return testing.assert_eq(actual: seen_header(resp, 'host')?, expected: authority);
}

@test
fn sends_a_default_user_agent() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/x')?;
    return testing.assert_eq(actual: seen_header(resp, 'user-agent')?, expected: http.USER_AGENT);
}

@test
fn caller_headers_are_sent_and_win_over_the_defaults() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/x', headers: ['X-Marker': 'mine', 'User-Agent': 'custom/9'])?;
    // Names normalize to lowercase on the way out...
    testing.assert_eq(actual: seen_header(resp, 'x-marker')?, expected: 'mine')?;
    // ...and a caller who sets user-agent means it.
    return testing.assert_eq(actual: seen_header(resp, 'user-agent')?, expected: 'custom/9');
}

/// No pooling, so the client says so — it lets the server release the connection at
/// once rather than hold it for a reuse that will never come.
@test
fn sends_connection_close() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/x')?;
    return testing.assert_eq(actual: seen_header(resp, 'connection')?, expected: 'close');
}

// --- chunked ---

/// The client must read a chunked response — the framing a real server uses when it
/// doesn't know the length up front. Sent here by hand, since our own server always
/// sets content-length.
@test
fn reads_a_chunked_response() -> Result<Void, Error> {
    let listener = net.listen('127.0.0.1:0')?;
    let addr = listener.local_addr()?;
    fiber.spawn(() => {
        let conn = listener.accept()?;
        // Drain the request head so the client's write completes.
        let _ = common.Wire.new(conn).read_request()?;
        io.write_all(to: conn, ('HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n'
            + '4\r\nchun\r\n' + '4\r\nked!\r\n' + '0\r\n\r\n').bytes())?;
        return conn.close();
    });
    let resp = http.get('http://' + addr + '/c')?;
    return testing.assert_eq(actual: resp.text()?, expected: 'chunked!');
}

// --- URL handling ---

@test
fn a_url_without_a_path_requests_root() -> Result<Void, Error> {
    let base = serving(echo)?;
    // No trailing slash: the request line still has to say `/`.
    let resp = http.get(base)?;
    return testing.assert_eq(actual: field(resp, 'url')?, expected: '/');
}

/// A fragment is client-side only and never goes on the common.
@test
fn a_fragment_is_not_sent() -> Result<Void, Error> {
    let base = serving(echo)?;
    let resp = http.get(base + '/page?a=1#section')?;
    return testing.assert_eq(actual: field(resp, 'url')?, expected: '/page?a=1');
}

// --- https ---
//
// Three tests over two mechanisms, because no single one covers the path.
//
// **Hermetic** (the first): point an `https` URL at the *plaintext* loopback
// server. That is enough to prove the two things this file owns — that `send`
// routes an `https` scheme through TLS at all, and that a TLS failure arrives as
// `HttpError.Tls` — because a plaintext peer cannot complete a handshake, so any
// other outcome means the scheme was ignored.
//
// **Live, gated** (the other two): a full `https` round trip needs a TLS *server*,
// and the seam that stands one up is file-private to `std.net` — deliberately, so
// no public API grows a way to inject trust or terminate TLS (docs/http-tls.md
// §Testing). The hermetic client↔server loop therefore lives in `net_test.thera`,
// which can reach both seams; what is left here is covered against the real world,
// off unless `THERA_NET_TESTS` is set.

/// The hermetic half: `https` to a peer that speaks plaintext HTTP fails as `Tls`.
/// If `send` ignored the scheme this would return a `Response` instead, so the test
/// pins scheme routing and the error mapping together, with no network.
@test
fn https_to_a_plaintext_peer_fails_as_tls() -> Result<Void, Error> {
    // `serving` hands back an `http://` base; asking for it over `https` is the
    // whole point.
    let base = serving(echo)?;
    let outcome = match http.get(base.replace('http://', 'https://')) {
        Ok(_) => '(a plaintext server completed a TLS handshake)',
        Err(e) => match e {
            Tls(_) => 'tls',
            _ => 'wrong variant: ' + e.message(),
        },
    };
    return testing.assert(outcome == 'tls', message: 'got: ' + outcome);
}

/// `https` end to end against a real certificate and the bundled Mozilla roots —
/// the production trust path, which nothing hermetic covers.
@test
fn a_live_https_request_succeeds() -> Result<Void, Error> {
    if env.get('THERA_NET_TESTS').is_none() {
        return Result.Ok(void);
    }
    let resp = http.get('https://example.com/')?;
    return testing.assert_eq(actual: resp.status, expected: 200);
}

/// The security-critical half: verification is actually **on**. A host whose
/// certificate does not chain to a trusted root is refused, and it comes back as
/// `Tls` — not `Connect` — so a caller can tell "don't retry this" from "the
/// network flaked".
@test
fn a_live_untrusted_certificate_is_refused_as_tls() -> Result<Void, Error> {
    if env.get('THERA_NET_TESTS').is_none() {
        return Result.Ok(void);
    }
    let outcome = match http.get('https://self-signed.badssl.com/') {
        Ok(_) => '(the certificate was accepted)',
        Err(e) => match e {
            Tls(_) => 'tls',
            _ => 'wrong variant: ' + e.message(),
        },
    };
    return testing.assert(outcome == 'tls', message: 'got: ' + outcome);
}

@test
fn a_relative_url_is_rejected() -> Result<Void, Error> {
    let failed = match http.get('/just/a/path') {
        Ok(_) => false,
        Err(e) => e.message().contains('absolute'),
    };
    return testing.assert(failed, message: 'expected an absolute-URL error');
}

@test
fn an_unsupported_scheme_is_rejected() -> Result<Void, Error> {
    let failed = match http.get('ftp://example.com/f') {
        Ok(_) => false,
        Err(e) => e.message().contains('scheme'),
    };
    return testing.assert(failed, message: 'expected a scheme error');
}

/// Credentials in a URL are deprecated; passing them through as part of the host
/// would surface as a baffling DNS failure.
@test
fn credentials_in_a_url_are_rejected() -> Result<Void, Error> {
    let failed = match http.get('http://user:pass@example.com/') {
        Ok(_) => false,
        Err(e) => e.message().contains('credentials'),
    };
    return testing.assert(failed, message: 'expected a credentials error');
}

@test
fn a_malformed_port_is_rejected() -> Result<Void, Error> {
    let failed = match http.get('http://example.com:notaport/') {
        Ok(_) => false,
        Err(e) => e.message().contains('port'),
    };
    return testing.assert(failed, message: 'expected a port error');
}

// --- connection failures ---

/// Nothing listening: a Connect error, not a hang and not a bogus Response.
@test
fn a_refused_connection_is_a_connect_error() -> Result<Void, Error> {
    // Bind then close, so the port is real but unserved.
    let held = net.listen('127.0.0.1:0')?;
    let addr = held.local_addr()?;
    held.close()?;
    let failed = match http.get('http://' + addr + '/x') {
        Ok(_) => false,
        Err(e) => match e {
            Connect(_) => true,
            _ => false,
        },
    };
    return testing.assert(failed, message: 'expected HttpError.Connect');
}

/// A peer that hangs up mid-response is a Body error — the framing was fine and the
/// bytes stopped, which is a different fault from a malformed message.
@test
fn a_truncated_response_is_a_body_error() -> Result<Void, Error> {
    let listener = net.listen('127.0.0.1:0')?;
    let addr = listener.local_addr()?;
    fiber.spawn(() => {
        let conn = listener.accept()?;
        let _ = common.Wire.new(conn).read_request()?;
        // Promise ten bytes, send four, hang up.
        io.write_all(to: conn, 'HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nfour'.bytes())?;
        return conn.close();
    });
    let failed = match http.get('http://' + addr + '/t') {
        Ok(_) => false,
        Err(e) => match e {
            Body(_) => true,
            _ => false,
        },
    };
    return testing.assert(failed, message: 'expected HttpError.Body');
}

/// A peer that isn't speaking HTTP is a Protocol error — the distinction that says
/// whose bug it is.
@test
fn a_non_http_peer_is_a_protocol_error() -> Result<Void, Error> {
    let listener = net.listen('127.0.0.1:0')?;
    let addr = listener.local_addr()?;
    fiber.spawn(() => {
        let conn = listener.accept()?;
        io.write_all(to: conn, 'GARBAGE\r\n\r\n'.bytes())?;
        return conn.close();
    });
    let failed = match http.get('http://' + addr + '/g') {
        Ok(_) => false,
        Err(e) => match e {
            Protocol(_) => true,
            _ => false,
        },
    };
    return testing.assert(failed, message: 'expected HttpError.Protocol');
}

// --- streaming ---

/// A GET as a `common.Request`, since the streaming entry points take one directly
/// — there is no `http.stream_get`, and there shouldn't be.
fn get_request(_ url: String) -> common.Request {
    return common.Request { method: 'GET', url: url, headers: [:], body: Bytes.empty() };
}

/// A handler that answers with an event stream.
fn event_source(_ req: common.Request) -> Result<common.Response, Error> {
    let body = 'event: message_start\ndata: {"n":0}\n\n'
        + ': keep-alive\n\n'
        + 'event: message_stop\ndata: {"n":1}\n\n';
    return Result.Ok(common.Response {
        status: 200,
        headers: ['content-type': 'text/event-stream'],
        body: body.bytes(),
    });
}

fn event_name(_ ev: Option<sse.Event>) -> String {
    return match ev {
        Some(e) => e.name,
        None => '<no event>',
    };
}

/// Whether `s`'s connection was already closed, asked by closing it again: the
/// runtime refuses a second close, which is what makes the first one observable
/// from out here. Reading would not do — the body may still have buffered bytes to
/// hand back long after the socket underneath is gone.
fn already_closed(_ s: http.Stream) -> Bool {
    return match s.close() {
        Ok(_) => false,
        Err(_) => true,
    };
}

@test
fn streams_a_response_body() -> Result<Void, Error> {
    let base = serving(echo)?;
    let s = http.stream(get_request(base + '/s'))?;
    testing.assert_eq(actual: s.status, expected: 200)?;
    testing.assert(s.is_ok(), message: '200 is ok')?;
    // The head has arrived; the body has not been touched.
    testing.assert(!s.body.is_complete(), message: 'the body is still on the wire')?;
    let body = io.read_all(s.body)?;
    testing.assert(s.body.is_complete(), message: 'the body is complete now')?;
    let _ = s.close();
    return testing.assert(body.to_string()?.contains('"url"'), message: 'the echo report');
}

/// The end-to-end shape the arc was for: a `text/event-stream` off the wire,
/// through the streaming body, into `std.http.sse`, with nothing in between holding
/// it whole.
@test
fn a_streamed_body_decodes_as_server_sent_events() -> Result<Void, Error> {
    let base = serving(event_source)?;
    let s = http.stream(get_request(base + '/events'))?;
    let content_type = common.header(s.headers, 'content-type').unwrap_or('');
    testing.assert_eq(actual: content_type, expected: 'text/event-stream')?;
    let names = sse.events(s.body).map((ev) => ev.name).to_list();
    let _ = s.close();
    testing.assert_eq(actual: names.len(), expected: 2)?;
    testing.assert_eq(actual: names[0], expected: 'message_start')?;
    return testing.assert_eq(actual: names[1], expected: 'message_stop');
}

/// `send` is `stream` plus a capped read plus the close, so the two paths have to
/// agree about the bytes — which they do by construction, and this keeps them
/// there.
@test
fn the_streamed_and_buffered_clients_agree() -> Result<Void, Error> {
    let base = serving(event_source)?;
    let s = http.stream(get_request(base + '/events'))?;
    let streamed = io.read_all(s.body)?;
    let _ = s.close();
    let buffered = http.get(base + '/events')?;
    return testing.assert_eq(actual: streamed.to_string()?, expected: buffered.text()?);
}

/// Smuggling the stream out of the callback is exactly what the scoped form exists
/// to discourage; here it is the instrument, because a connection that no longer
/// reads is the only observable proof the close happened.
@test
fn with_stream_closes_the_connection_on_the_way_out() -> Result<Void, Error> {
    let base = serving(echo)?;
    let escaped = http.with_stream(get_request(base + '/w'), handle: (s) => Result.Ok(s))?;
    return testing.assert(already_closed(escaped), message: 'the connection was closed');
}

/// And on the way out through a failure, which is the path that actually leaks in
/// every language that leaves this to the caller.
@test
fn with_stream_closes_when_the_callback_fails() -> Result<Void, Error> {
    let base = serving(echo)?;
    let box: List<http.Stream> = [];
    let outcome = http.with_stream(get_request(base + '/f'), handle: (s) => {
        box.push(s);
        // Always taken. Spelled as a condition so the callback's `T` is inferable —
        // a body that only ever returns `Err` names no type to infer it from.
        if s.status == 200 {
            return Result.Err(error('the caller gave up'));
        }
        return Result.Ok(0);
    });
    let propagated = match outcome {
        Ok(_) => false,
        Err(e) => e.message() == 'the caller gave up',
    };
    testing.assert(propagated, message: 'the callback error propagates')?;
    return testing.assert(already_closed(box[0]), message: 'closed despite the failure');
}

/// The assertion the whole arc exists for: events reach the caller **while the
/// server is still writing**. The server sends the first event, then waits to be
/// told it arrived before sending the second — so a client that read the body whole
/// would leave it waiting, and the flag the server reports back says which
/// happened. The wait is bounded by a timer rather than a bare `receive`, so a
/// regression fails this assertion instead of hanging the suite.
@test
fn events_arrive_while_the_server_is_still_writing() -> Result<Void, Error> {
    let go = fiber.channel<Bool>();
    let listener = net.listen('127.0.0.1:0')?;
    let addr = listener.local_addr()?;
    let pushed = fiber.spawn(() => push_two_events(listener, go));

    let s = http.stream(get_request('http://' + addr + '/events'))?;
    let events = sse.Decoder.new(s.body);
    let first = events.read_event()?;
    go.send(true);
    let second = events.read_event()?;
    let _ = s.close();

    testing.assert(pushed.join(), message: 'the second event was sent before the first arrived')?;
    testing.assert_eq(actual: event_name(first), expected: 'a')?;
    return testing.assert_eq(actual: event_name(second), expected: 'b');
}

/// Serve one event stream in two writes with a bounded wait between them. Returns
/// whether the go-ahead arrived — that is, whether the client really was reading
/// incrementally — rather than waiting forever to find out that it wasn't.
fn push_two_events(_ listener: net.TcpListener, _ go: fiber.Channel<Bool>) -> Bool {
    return match write_two_events(listener, go) {
        Ok(signalled) => signalled,
        Err(_) => false,
    };
}

fn write_two_events(_ listener: net.TcpListener, _ go: fiber.Channel<Bool>) -> Result<Bool, Error> {
    let first = 'event: a\ndata: 1\n\n';
    let second = 'event: b\ndata: 2\n\n';
    let conn = listener.accept()?;
    let _ = common.Wire.new(conn).read_request()?;
    // `content-length`, not chunked: the total is known up front, and what makes a
    // body streamable is that the *client* doesn't wait for all of it.
    let head = 'HTTP/1.1 200 OK\r\n'
        + 'content-type: text/event-stream\r\n'
        + 'content-length: '
        + (first.byte_len() + second.byte_len()).to_string()
        + '\r\n\r\n';
    io.write_all(to: conn, (head + first).bytes())?;
    let signalled = fiber.select([go, fiber.after(time.Duration.seconds(2))]) == 0;
    if signalled {
        let _ = go.receive();
    }
    io.write_all(to: conn, second.bytes())?;
    let _ = conn.close();
    return Result.Ok(signalled);
}

// --- concurrency ---

/// The payoff of parking on readiness: many in-flight requests over one thread,
/// each fiber blocking only itself.
@test
fn many_requests_run_concurrently() -> Result<Void, Error> {
    let base = serving(echo)?;
    let mut calls = [];
    for i in 0..10 {
        let path = '/n' + i.to_string();
        calls.push(fiber.spawn(() => http.get(base + path)));
    }
    for p in calls.enumerate() {
        let resp = p.value.join()?;
        testing.assert_eq(actual: field(resp, 'url')?, expected: '/n' + p.index.to_string())?;
    }
    return Result.Ok(void);
}
