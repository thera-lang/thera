//! std.http client — `get`/`post`/`send` over HTTP/1.1.
//!
//! **Internal.** Reach for it through the [std.http](http.thera) barrel, which
//! re-exports this alongside the [common](common/common.thera) types:
//! `http.get(...)`.

import std.io;
import std.net;

import 'common';

/// The default `user-agent`, sent unless a caller sets their own. Servers do route
/// on it (rate limits, compatibility shims), and an unidentified client is the kind
/// of thing that gets blocked.
pub const USER_AGENT: String = 'thera-http/0.1';

// --- URLs ---

/// A parsed absolute URL, split into what connecting and requesting each need.
struct Url {
    let scheme: String;
    let host: String; // no brackets, even for an IPv6 literal
    let port: Int;
    let authority: String; // `host:port` as the `host` header should read it
    let target: String; // path + query — the request line's middle field
}

/// Split an absolute `http://` or `https://` URL. The scheme decides both the
/// default port (80 vs 443) and whether `send` wraps the connection in TLS.
fn parse_url(_ url: String) -> Result<Url, common.HttpError> {
    let scheme_end = match url.find('://') {
        Some(i) => i,
        None => {
            return Result.Err(common.HttpError.Connect(
                'not an absolute URL (no scheme): "' + url + '"',
            ));
        },
    };
    let scheme = url.slice(0, scheme_end).to_lowercase();
    if scheme != 'http' && scheme != 'https' {
        return Result.Err(common.HttpError.Connect('unsupported URL scheme: "' + scheme + '"'));
    }
    let rest = url.slice(scheme_end + 3, url.len());

    // The authority runs to the first `/`, `?`, or `#`.
    let mut cut = rest.len();
    for mark in ['/', '?', '#'] {
        if let Some(i) = rest.find(mark) {
            if i < cut {
                cut = i;
            }
        }
    }
    let authority = rest.slice(0, cut);
    let after = rest.slice(cut, rest.len());

    // Drop a `#fragment`: it is client-side only and never goes on the common.
    let mut target = match after.find('#') {
        Some(i) => after.slice(0, i),
        None => after,
    };
    if target.is_empty() {
        target = '/'; // an empty path is `/` on the request line
    }

    // `user:pass@host` — parsed off rather than silently sent. Credentials in a URL
    // are deprecated (RFC 9110 §4.2.1) and passing them through as a host would
    // produce a baffling DNS failure.
    if authority.contains('@') {
        return Result.Err(common.HttpError.Connect(
            'credentials in a URL are not supported; use an authorization header',
        ));
    }
    if authority.is_empty() {
        return Result.Err(common.HttpError.Connect('no host in URL: "' + url + '"'));
    }

    let default_port = if scheme == 'https' { 443 } else { 80 };
    let host = host_of(authority)?;
    let port = port_of(authority, default_port)?;
    return Result.Ok(Url {
        scheme: scheme,
        host: host,
        port: port,
        authority: authority,
        target: target,
    });
}

/// The host out of an authority, unwrapping an IPv6 literal's brackets —
/// `[::1]:8080` is the host `::1`, which is what a resolver wants.
fn host_of(_ authority: String) -> Result<String, common.HttpError> {
    if authority.starts_with('[') {
        return match authority.find(']') {
            Some(end) => Result.Ok(authority.slice(1, end)),
            None => Result.Err(common.HttpError.Connect(
                'unterminated IPv6 literal: "' + authority + '"',
            )),
        };
    }
    return match authority.find(':') {
        Some(i) => Result.Ok(authority.slice(0, i)),
        None => Result.Ok(authority),
    };
}

/// The port out of an authority, or `fallback`. The colon that matters is the one
/// *after* an IPv6 literal's `]`, not the ones inside it.
fn port_of(_ authority: String, _ fallback: Int) -> Result<Int, common.HttpError> {
    let tail = if authority.starts_with('[') {
        match authority.find(']') {
            Some(end) => authority.slice(end + 1, authority.len()),
            None => '',
        }
    } else {
        authority
    };
    return match tail.find(':') {
        None => Result.Ok(fallback),
        Some(i) => {
            let digits = tail.slice(i + 1, tail.len());
            if digits.is_empty() {
                Result.Ok(fallback) // `host:` — an empty port means the default
            } else {
                match digits.to_int() {
                    Some(n) => {
                        if n < 0 || n > 65535 {
                            Result.Err(
                                common.HttpError.Connect('port out of range: "' + digits + '"')
                            )
                        } else {
                            Result.Ok(n)
                        }
                    },
                    None => Result.Err(
                        common.HttpError.Connect('malformed port: "' + digits + '"')
                    ),
                }
            }
        },
    };
}

// --- requests ---

/// GET `url`.
pub fn get(
    _ url: String,
    headers: Map<String, String> = [:],
) -> Result<common.Response, common.HttpError> {
    return send(common.Request { method: 'GET', url: url, headers: headers, body: Bytes.empty() });
}

/// POST `body` to `url`. Set `content-type` in `headers` to say what it is.
pub fn post(
    _ url: String,
    body: Bytes,
    headers: Map<String, String> = [:],
) -> Result<common.Response, common.HttpError> {
    return send(common.Request { method: 'POST', url: url, headers: headers, body: body });
}

/// Send `request`, whose `url` must be absolute (`http://host/path` or
/// `https://host/path`). An `https` URL verifies the server's certificate chain and
/// host name against the bundled roots; a certificate that doesn't check out is an
/// `HttpError.Tls`, never a silent downgrade.
///
/// One connection per request, closed on the way out: no pooling, no keep-alive
/// reuse, and **no redirect following** — a 3xx comes back as itself, for the
/// caller to act on. A 4xx or 5xx is likewise a perfectly good `Response`, not an
/// error; `HttpError` is for exchanges that did not happen.
///
/// The body is read into memory, capped at `common.MAX_BODY_BYTES`. This is
/// `stream` plus that read plus the close — so for a body that should not be held
/// whole, use `stream` directly.
pub fn send(_ request: common.Request) -> Result<common.Response, common.HttpError> {
    let open = stream(request)?;
    // Written as one expression so there is a single `close` below, on every path,
    // rather than one per early return.
    let outcome = match open.body.buffered() {
        Ok(body) => Result.Ok(common.Response {
            status: open.status,
            headers: open.headers,
            body: body,
        }),
        Err(e) => Result.Err(e),
    };
    let _ = open.close();
    return outcome;
}

// --- streaming ---

/// A response whose connection is **still open**: the head has arrived, and the
/// body is being read off the wire as it comes.
///
/// The client's counterpart to `common.ResponseStream`, which is the codec's
/// version of the same idea. The difference is the last field: this one **owns the
/// connection**, and so has to be closed.
pub struct Stream {
    let status: Int;
    let headers: Map<String, String>;
    let body: common.BodyReader;
    let conn: io.Closer;
}

impl Stream {
    /// Whether the status is 2xx.
    pub fn is_ok(self) -> Bool {
        return self.status >= 200 && self.status < 300;
    }

    /// Close the connection — after reading the body, or early if you have stopped
    /// caring about the rest of it.
    ///
    /// **Always call it.** Thera has no destructors, so nothing else will: a
    /// `Stream` that goes out of scope unclosed is a leaked descriptor, and a retry
    /// loop that leaks one per attempt runs the process out of them. `with_stream`
    /// is the spelling that cannot forget.
    ///
    /// Closing twice is an `Err`, not a crash — the runtime refuses a close on a
    /// connection it no longer has. So `let _ = s.close()` is the right spelling
    /// anywhere the close might be redundant.
    pub fn close(self) -> Result<Void, Error> {
        return self.conn.close();
    }
}

/// Send `request` and return as soon as the response **head** has arrived, with the
/// body still on the common.
///
/// For a body that should be consumed as it comes — a `text/event-stream` (see
/// `std.http.sse`), a download too large to hold. `send` is the right call for
/// everything else: it buffers, which is what almost every caller wants, and being
/// buffered is what lets it be capped.
///
/// **The connection stays open until the returned `Stream` is closed**, and closing
/// it is the caller's job. Prefer `with_stream`, which does it on every path out.
pub fn stream(_ request: common.Request) -> Result<Stream, common.HttpError> {
    let url = parse_url(request.url)?;
    // The scheme picks the stream type; `open` is generic over both, so each arm is
    // just "connect, then hand it over".
    if url.scheme == 'https' {
        return match net.connect_tls(url.host, url.port) {
            Ok(conn) => open(conn, request, url),
            Err(e) => Result.Err(connect_error(e)),
        };
    }
    return match net.connect(url.host, url.port) {
        Ok(conn) => open(conn, request, url),
        Err(e) => Result.Err(connect_error(e)),
    };
}

/// Stream `request`, hand the open `Stream` to `handler`, and **close it on the way
/// out — every way out**, including an early `?` inside the callback.
///
/// The leak-proof spelling, and the one to reach for unless the stream genuinely
/// has to outlive the call:
///
/// ```thera
/// let count = http.with_stream(req, handle: (s) => {
///     let mut n = 0;
///     for ev in sse.events(s.body) { n = n + 1; }
///     return Result.Ok(n);
/// })?;
/// ```
pub fn with_stream<T>(
    _ request: common.Request,
    handle handler: (Stream) -> Result<T, Error>,
) -> Result<T, Error> {
    let open = stream(request)?;
    let outcome = handler(open);
    let _ = open.close();
    return outcome;
}

/// A failure to establish the connection, as an `HttpError`. Only the TLS cause
/// survives as itself — it is the one that says "don't retry this" — and everything
/// else is the `Connect` it already was.
fn connect_error(_ e: net.NetError) -> common.HttpError {
    return match e {
        Tls(m) => common.HttpError.Tls(m),
        _ => common.HttpError.Connect(e.message()),
    };
}

/// Write `request` on `conn` and read the head back, leaving the body on the
/// common.
///
/// Generic over the stream rather than taking a `net.TcpStream`, which is what lets
/// `https` and `http` share it — the codec's two halves are separately
/// interface-typed, so the bound names both roles plus the close.
///
/// **Ownership of `conn` transfers on success** and only on success: a `Stream`
/// closes it when the caller says so, but nothing owns it yet on the failure path,
/// so that path closes it here. Leaking the descriptor when a request fails is
/// exactly how a retry loop runs a process out of them.
fn open<S: io.Reader + io.Writer + io.Closer>(
    _ conn: S,
    _ request: common.Request,
    _ url: Url,
) -> Result<Stream, common.HttpError> {
    let sent = common.Request {
        method: request.method,
        // The request line carries the path, not the whole URL (that form is for
        // proxies only).
        url: url.target,
        headers: outbound_headers(request.headers, url),
        body: request.body,
    };
    let head = match common.write_request(to: conn, sent) {
        // A HEAD response describes a body it does not send; nothing on the wire
        // says so, so the reader has to be told.
        Ok(_) => common.Wire
            .new(conn)
            .stream_response(to_head: request.method.to_uppercase() == 'HEAD'),
        Err(e) => Result.Err(common.HttpError.Connect(e.message())),
    };
    return match head {
        Ok(r) => Result.Ok(Stream {
            status: r.status,
            headers: r.headers,
            body: r.body,
            conn: conn,
        }),
        Err(e) => {
            let _ = conn.close();
            Result.Err(e)
        },
    };
}

/// The caller's headers plus the ones the transport owns. Caller-set values win,
/// except for framing, which the codec derives from the body.
fn outbound_headers(_ caller: Map<String, String>, _ url: Url) -> Map<String, String> {
    let headers: Map<String, String> = [:];
    for key in caller.keys() {
        headers[key.to_lowercase()] = caller[key];
    }
    // `host` is mandatory in HTTP/1.1 and comes from the URL — a caller who sets it
    // means it (virtual hosts, testing through a proxy), so don't overwrite.
    if !headers.has('host') {
        headers['host'] = url.authority;
    }
    if !headers.has('user-agent') {
        headers['user-agent'] = USER_AGENT;
    }
    // No pooling, so say so: it lets the server release the connection at once
    // rather than holding it open for a reuse that will never come.
    headers['connection'] = 'close';
    return headers;
}
