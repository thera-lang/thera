//! std.json — parse and serialize JSON.
//!
//! Import as: import std.json
//!
//! The structural `Json` value models any JSON document; `parse` reads text into
//! one and `stringify` writes it back. A typed `decode<T>`/`encode<T>` (struct ↔
//! JSON) awaits the reflection arc — until then, `Json` plus the lowercase
//! constructors (`json.obj`, `json.int`, …) are how you build values, and
//! `json.Cursor` is how you read them into types.
//!
//! ```thera
//! // Navigate leniently — nothing fails, a miss is None:
//! let root = json.parse(text)?;
//! let name = root.get('user').get('name').as_string().unwrap_or('?');
//!
//! // Or read strictly, where a bad shape is an error that names its path:
//! let at = json.cursor(root);
//! let name = at.field('user').field('name').string()?;   // $.user.name
//!
//! // Encode (each leaf wrapped — Thera has no heterogeneous literal):
//! let doc = json.obj([
//!     'name': json.str('build'),
//!     'tags': json.arr([json.str('a'), json.str('b')]),
//!     'count': json.int(3),
//! ]);
//! let text = json.stringify(doc, pretty: true);
//! ```
//!
//! The two reading styles are deliberate and not redundant: the accessors suit a
//! server that must not crash on a bad request, `Cursor` suits a client of a typed
//! API where a wrong shape is a failure that has to be findable. See `Cursor` below
//! and docs/stdlib.md § `std.json`.
//!
//! Implementation: a hand-written scanner + recursive-descent parser, pure Thera.

import std.char;

/// The structural JSON value. `Int` and `Double` are split (rather than a single
/// number) so integers round-trip exactly and construct cleanly as `json.int(n)`.
pub enum Json {
    Null,
    Bool(Bool),
    Int(Int),
    Double(Double),
    Str(String),
    Array(List<Json>),
    Object(Map<String, Json>), // insertion-ordered → stringify is stable
}

/// What `parse` can reject. A domain error: implements the common `Error`.
pub enum JsonError {
    Syntax(String), // a message including the offending line/column
}

impl Error for JsonError {
    pub fn message(self) -> String {
        return match self {
            Syntax(msg) => msg,
        };
    }
}

impl Display for JsonError {
    pub fn to_string(self) -> String {
        return self.message();
    }
}

// --- constructors (the lowercase building API) ---

pub fn null() -> Json {
    return Json.Null;
}

pub fn bool(_ b: Bool) -> Json {
    return Json.Bool(b);
}

pub fn int(_ n: Int) -> Json {
    return Json.Int(n);
}

pub fn double(_ x: Double) -> Json {
    return Json.Double(x);
}

pub fn str(_ s: String) -> Json {
    return Json.Str(s);
}

pub fn arr(_ items: List<Json>) -> Json {
    return Json.Array(items);
}

/// An object.
///
/// With `omit_nulls`, entries whose value is `Json.Null` are left out rather than
/// written as `null` — which is what turns a struct with a long tail of optional
/// fields into a request body without a conditional insert per field:
///
/// ```thera
/// json.obj([
///     'model': json.str(req.model),                          // always sent
///     'temperature': json.opt(req.temperature, json.double),  // sent when Some
///     'top_k': json.opt(req.top_k, json.int),
/// ], omit_nulls: true);
/// ```
///
/// It applies to this object's own entries, not recursively, and it is per-call —
/// so an API that distinguishes "field absent" from "field explicitly null" builds
/// the null-carrying part with `omit_nulls` off.
pub fn obj(_ fields: Map<String, Json>, omit_nulls: Bool = false) -> Json {
    if !omit_nulls {
        return Json.Object(fields);
    }
    let mut kept: Map<String, Json> = [:];
    for key in fields.keys() {
        let value = fields[key];
        if !value.is_null() {
            kept[key] = value;
        }
    }
    return Json.Object(kept);
}

/// `Some(v)` encoded by `encode`, `None` as `Json.Null` — the lifter that lets an
/// optional field be written unconditionally, then dropped by `obj`'s `omit_nulls`.
/// `encode` is normally one of the constructors above:
/// `json.opt(req.top_k, json.int)`.
pub fn opt<T>(_ value: Option<T>, _ encode: (T) -> Json) -> Json {
    return match value {
        Some(inner) => encode(inner),
        None => Json.Null,
    };
}

// --- accessors ---

impl Json {
    /// An object field by key (Null if not an object or the key is absent). Null
    /// -on-miss keeps navigation chainable: `j.get('a').get('b').as_int()`.
    pub fn get(self, _ key: String) -> Json {
        return match self {
            Object(m) => match m.get(key) {
                Some(v) => v,
                None => Json.Null,
            },
            _ => Json.Null,
        };
    }

    /// An array element by index (Null if not an array or out of range).
    pub fn at(self, _ index: Int) -> Json {
        return match self {
            Array(items) => match items.get(index) {
                Some(v) => v,
                None => Json.Null,
            },
            _ => Json.Null,
        };
    }

    pub fn as_bool(self) -> Option<Bool> {
        return match self {
            Bool(b) => Option.Some(b),
            _ => Option.None,
        };
    }

    /// The number as an Int — for an `Int`, or a `Double` with no fractional part.
    pub fn as_int(self) -> Option<Int> {
        return match self {
            Int(n) => Option.Some(n),
            Double(x) => int_if_integral(x),
            _ => Option.None,
        };
    }

    /// The number as a Double — for a `Double`, or an `Int` widened.
    pub fn as_double(self) -> Option<Double> {
        return match self {
            Double(x) => Option.Some(x),
            Int(n) => Option.Some(n.to_double()),
            _ => Option.None,
        };
    }

    pub fn as_string(self) -> Option<String> {
        return match self {
            Str(s) => Option.Some(s),
            _ => Option.None,
        };
    }

    pub fn as_array(self) -> Option<List<Json>> {
        return match self {
            Array(items) => Option.Some(items),
            _ => Option.None,
        };
    }

    pub fn as_object(self) -> Option<Map<String, Json>> {
        return match self {
            Object(m) => Option.Some(m),
            _ => Option.None,
        };
    }

    pub fn is_null(self) -> Bool {
        return match self {
            Null => true,
            _ => false,
        };
    }

    /// The name of this value's kind — `'object'`, `'array'`, `'string'`,
    /// `'number'`, `'boolean'`, `'null'`. What a decode failure reports as *found*.
    pub fn kind(self) -> String {
        return match self {
            Null => 'null',
            Bool(_) => 'boolean',
            Int(_) => 'number',
            Double(_) => 'number',
            Str(_) => 'string',
            Array(_) => 'array',
            Object(_) => 'object',
        };
    }
}

fn int_if_integral(_ x: Double) -> Option<Int> {
    let n = x.to_int(); // truncates toward zero
    return if n.to_double() == x { Option.Some(n) } else { Option.None };
}

// --- typed decoding ---

/// What reading a typed value out of a document rejects: the JSON parsed, but was
/// not the shape the reader needed. Distinct from `JsonError`, which is the
/// *parser's* failure — a syntax error and a shape mismatch are different problems
/// with different fixes, and a program often handles only one of them.
///
/// Both variants lead with a path, because that is what makes a failure findable.
/// Build them through `Cursor`'s readers rather than by hand.
pub enum DecodeError {
    /// The path of a required field the document does not have.
    Missing(String),
    /// A path, what was expected there, and what was found (`Json.kind()`).
    Shape(String, String, String),
}

impl Error for DecodeError {
    pub fn message(self) -> String {
        return match self {
            Missing(path) => 'missing required field ${path}',
            Shape(path, expected, found) => 'expected ${expected} at ${path}, got ${found}',
        };
    }
}

impl Display for DecodeError {
    pub fn to_string(self) -> String {
        return self.message();
    }
}

/// A `Json` paired with where in the document it came from.
///
/// The accessors above (`get`, `as_string`, …) suit a **lenient** reader:
/// navigation never fails, an absent value is `Option.None`, and nothing is an
/// error — which is how a server should read a request it must not crash on. A
/// client of a typed API wants the opposite: a required field that is absent or the
/// wrong type is an error, and the error has to name the field. It has to name it
/// as a **path**, too — `expected string, got number` with no location is not
/// debuggable once a program decodes hundreds of schemas.
///
/// A bare `Json` cannot report that, because it has no idea where it came from: the
/// path has to be threaded alongside it by hand, at every level of every decoder,
/// with nothing checking that the two agree. A `Cursor` carries both, so navigating
/// accumulates the path and the readers can report it.
///
/// ```thera
/// fn usage_from_json(_ at: json.Cursor) -> Result<Usage, json.DecodeError> {
///     return Result.Ok(Usage {
///         input_tokens: at.field('input_tokens').int()?,
///         output_tokens: at.field('output_tokens').int()?,
///         cache_read: at.field('cache_read_input_tokens').opt_int()?,
///     });
/// }
///
/// let root = json.cursor(json.parse(body)?);
/// let usage = usage_from_json(root.field('usage').object()?)?;
/// ```
///
/// **Navigating never fails; reading does.** `field` and `index` always answer a
/// cursor — for a key the document doesn't have, one at the extended path holding
/// `Null` and marked absent — so a field is one `?`, at the read, where the wanted
/// type is known. Chains work the same way: `at.field('a').field('b').string()?`. A
/// decoder that can be handed a non-object (a list element, say) should open with
/// `let obj = at.object()?;`, which validates and reports `at`'s own path.
pub struct Cursor {
    let value: Json;
    /// Where `value` sits, as a JSONPath-ish string: `$.content[2].text`.
    let path: String;
    /// False only for a cursor produced by navigating to a key or an index the
    /// document does not have. It is what lets a required read tell
    /// `missing required field $.id` from `expected string at $.id, got null`, and
    /// what lets a caller tell "absent" from "explicitly null" for an API that
    /// gives the two different meanings (`null` to clear a field, absent to leave
    /// it alone). The optional readers deliberately treat both as `None`, which is
    /// what almost every API means.
    let present: Bool;
}

/// A cursor on `value` as a document root, whose path is `$`.
pub fn cursor(_ value: Json) -> Cursor {
    return Cursor { value: value, path: '$', present: true };
}

impl Cursor {
    // --- navigating (never fails) ---

    /// The cursor at `key` of this object — at the extended path, marked absent if
    /// this is not an object or has no such key.
    pub fn field(self, _ key: String) -> Cursor {
        let at = '${self.path}.${key}';
        return match self.value {
            Object(fields) => match fields.get(key) {
                Some(found) => Cursor { value: found, path: at, present: true },
                None => absent(at),
            },
            _ => absent(at),
        };
    }

    /// The cursor at element `i` of this array — marked absent if this is not an
    /// array or `i` is out of range.
    pub fn index(self, _ i: Int) -> Cursor {
        let at = '${self.path}[${i}]';
        return match self.value {
            Array(items) => match items.get(i) {
                Some(found) => Cursor { value: found, path: at, present: true },
                None => absent(at),
            },
            _ => absent(at),
        };
    }

    pub fn is_null(self) -> Bool {
        return self.value.is_null();
    }

    // --- reading a required value ---

    pub fn string(self) -> Result<String, DecodeError> {
        return self.require('a string', self.value.as_string());
    }

    pub fn int(self) -> Result<Int, DecodeError> {
        return self.require('an integer', self.value.as_int());
    }

    pub fn double(self) -> Result<Double, DecodeError> {
        return self.require('a number', self.value.as_double());
    }

    pub fn bool(self) -> Result<Bool, DecodeError> {
        return self.require('a boolean', self.value.as_bool());
    }

    /// This cursor, having checked it holds an object — the shape a decoder opens
    /// with so that a non-object is blamed on its own path rather than on the first
    /// field read out of it.
    pub fn object(self) -> Result<Cursor, DecodeError> {
        return self.require('an object', self.as_self_if_object());
    }

    /// The elements of this array, each as a cursor whose path carries its index —
    /// so a failure deep in a list says `$.content[2].text` without the caller
    /// building that string.
    pub fn list(self) -> Result<List<Cursor>, DecodeError> {
        return self.require('an array', self.as_element_cursors());
    }

    /// The value itself, checked only for presence. For a subschema the API does
    /// not model, where any JSON is legitimate and a type check would be a lie.
    pub fn raw(self) -> Result<Json, DecodeError> {
        return self.require('a value', Option.Some(self.value));
    }

    // --- reading an optional value ---
    //
    // Absent and explicitly-null both read as `Option.None`; `present` is there for
    // the rarer API that distinguishes them.

    pub fn opt_string(self) -> Result<Option<String>, DecodeError> {
        return self.allow('a string', self.value.as_string());
    }

    pub fn opt_int(self) -> Result<Option<Int>, DecodeError> {
        return self.allow('an integer', self.value.as_int());
    }

    pub fn opt_double(self) -> Result<Option<Double>, DecodeError> {
        return self.allow('a number', self.value.as_double());
    }

    pub fn opt_bool(self) -> Result<Option<Bool>, DecodeError> {
        return self.allow('a boolean', self.value.as_bool());
    }

    pub fn opt_object(self) -> Result<Option<Cursor>, DecodeError> {
        return self.allow('an object', self.as_self_if_object());
    }

    pub fn opt_list(self) -> Result<Option<List<Cursor>>, DecodeError> {
        return self.allow('an array', self.as_element_cursors());
    }

    // --- rejecting on your own terms ---

    /// A `Shape` error at this cursor's path, for a check the readers can't make:
    /// `at.field('created_at').unexpected('an ISO-8601 timestamp')`.
    pub fn unexpected<T>(self, _ expected: String) -> Result<T, DecodeError> {
        return Result.Err(DecodeError.Shape(self.path, expected, self.value.kind()));
    }

    // --- the two readers everything above shares ---

    /// Absent is `Missing`; the wrong kind is `Shape`; otherwise the value.
    fn require<T>(self, _ expected: String, _ read: Option<T>) -> Result<T, DecodeError> {
        if !self.present {
            return Result.Err(DecodeError.Missing(self.path));
        }
        return match read {
            Some(value) => Result.Ok(value),
            None => self.unexpected(expected),
        };
    }

    /// Absent or null is `None`; the wrong kind is still `Shape`. Tolerating an
    /// absent field is not tolerating a field of the wrong type — the first is the
    /// schema saying "optional", the second is a bug or a breaking change.
    fn allow<T>(self, _ expected: String, _ read: Option<T>) -> Result<Option<T>, DecodeError> {
        if !self.present || self.value.is_null() {
            return Result.Ok(Option.None);
        }
        return match read {
            Some(value) => Result.Ok(Option.Some(value)),
            None => self.unexpected(expected),
        };
    }

    fn as_self_if_object(self) -> Option<Cursor> {
        return match self.value {
            Object(_) => Option.Some(self),
            _ => Option.None,
        };
    }

    fn as_element_cursors(self) -> Option<List<Cursor>> {
        return match self.value {
            Array(items) => Option.Some(items.enumerate().map((it) => Cursor {
                value: it.value,
                path: '${self.path}[${it.index}]',
                present: true,
            }).to_list()),
            _ => Option.None,
        };
    }
}

fn absent(_ path: String) -> Cursor {
    return Cursor { value: Json.Null, path: path, present: false };
}

// --- parsing ---

/// A cursor over the input's code points.
struct Scanner {
    let chars: List<Int>;
    let mut pos: Int;
    let len: Int;
}

pub fn parse(_ text: String) -> Result<Json, JsonError> {
    let cps = text.chars();
    let s = Scanner { chars: cps, pos: 0, len: cps.len() };
    let value = s.parse_value()?;
    s.skip_ws();
    if s.pos < s.len {
        return Result.Err(s.syntax('trailing characters after JSON value'));
    }
    return Result.Ok(value);
}

impl Scanner {
    /// The current code point, or -1 at end of input.
    fn peek(self) -> Int {
        if self.pos >= self.len {
            return -1;
        }
        return self.chars[self.pos];
    }

    fn skip_ws(self) -> Void {
        let mut going = true;
        while going {
            if char.is_whitespace(self.peek()) {
                self.pos = self.pos + 1;
            } else {
                going = false;
            }
        }
        return void;
    }

    /// Advance past a run of ASCII digits.
    fn skip_digits(self) -> Void {
        let mut going = true;
        while going {
            if char.is_digit(self.peek()) {
                self.pos = self.pos + 1;
            } else {
                going = false;
            }
        }
        return void;
    }

    fn syntax(self, _ msg: String) -> JsonError {
        return JsonError.Syntax('${msg} at ${self.position()}');
    }

    /// A human-readable line/column for the current position.
    fn position(self) -> String {
        let mut line = 1;
        let mut col = 1;
        let mut i = 0;
        while i < self.pos {
            if self.chars[i] == char.LF {
                line = line + 1;
                col = 1;
            } else {
                col = col + 1;
            }
            i = i + 1;
        }
        return 'line ${line} col ${col}';
    }

    /// True (and consumes) if the upcoming code points spell `lit`.
    fn match_literal(self, _ lit: String) -> Bool {
        let want = lit.chars();
        for p in want.enumerate() {
            if self.pos + p.index >= self.len {
                return false;
            }
            if self.chars[self.pos + p.index] != p.value {
                return false;
            }
        }
        self.pos = self.pos + want.len();
        return true;
    }

    fn parse_value(self) -> Result<Json, JsonError> {
        self.skip_ws();
        let c = self.peek();
        if c == char.LBRACE {
            return self.parse_object();
        }
        if c == char.LBRACKET {
            return self.parse_array();
        }
        if c == char.DQUOTE {
            let s = self.parse_string()?;
            return Result.Ok(Json.Str(s));
        }
        if c == char.MINUS || char.is_digit(c) {
            return self.parse_number();
        }
        if self.match_literal('true') {
            return Result.Ok(Json.Bool(true));
        }
        if self.match_literal('false') {
            return Result.Ok(Json.Bool(false));
        }
        if self.match_literal('null') {
            return Result.Ok(Json.Null);
        }
        if c == -1 {
            return Result.Err(self.syntax('unexpected end of input'));
        }
        return Result.Err(self.syntax('unexpected character'));
    }

    fn parse_array(self) -> Result<Json, JsonError> {
        self.pos = self.pos + 1; // consume '['
        let mut items: List<Json> = [];
        self.skip_ws();
        if self.peek() == char.RBRACKET {
            self.pos = self.pos + 1;
            return Result.Ok(Json.Array(items));
        }
        let mut going = true;
        while going {
            let value = self.parse_value()?;
            items.push(value);
            self.skip_ws();
            let c = self.peek();
            if c == char.COMMA {
                self.pos = self.pos + 1;
            } else if c == char.RBRACKET {
                self.pos = self.pos + 1;
                going = false;
            } else {
                return Result.Err(self.syntax('expected , or ] in array'));
            }
        }
        return Result.Ok(Json.Array(items));
    }

    fn parse_object(self) -> Result<Json, JsonError> {
        self.pos = self.pos + 1; // consume '{'
        let mut fields: Map<String, Json> = [:];
        self.skip_ws();
        if self.peek() == char.RBRACE {
            self.pos = self.pos + 1;
            return Result.Ok(Json.Object(fields));
        }
        let mut going = true;
        while going {
            self.skip_ws();
            if self.peek() != char.DQUOTE {
                return Result.Err(self.syntax('expected a string key'));
            }
            let key = self.parse_string()?;
            self.skip_ws();
            if self.peek() != char.COLON {
                return Result.Err(self.syntax('expected : after key'));
            }
            self.pos = self.pos + 1; // consume ':'
            let value = self.parse_value()?;
            fields[key] = value;
            self.skip_ws();
            let c = self.peek();
            if c == char.COMMA {
                self.pos = self.pos + 1;
            } else if c == char.RBRACE {
                self.pos = self.pos + 1;
                going = false;
            } else {
                return Result.Err(self.syntax('expected , or } in object'));
            }
        }
        return Result.Ok(Json.Object(fields));
    }

    /// The current char is the opening quote.
    fn parse_string(self) -> Result<String, JsonError> {
        self.pos = self.pos + 1; // consume opening '"'
        let mut out: List<Int> = [];
        let mut going = true;
        while going {
            if self.pos >= self.len {
                return Result.Err(self.syntax('unterminated string'));
            }
            let c = self.chars[self.pos];
            self.pos = self.pos + 1;
            if c == char.DQUOTE {
                going = false;
            } else if c == char.BACKSLASH {
                self.parse_escape(out)?; // decodes into `out`
            } else if c < char.SPACE {
                // Control characters (U+0000–U+001F) must be escaped, so a raw tab
                // or newline inside a string is a syntax error (RFC 8259).
                return Result.Err(self.syntax('unescaped control character in string'));
            } else {
                out.push(c);
            }
        }
        return Result.Ok(String.from_chars(out));
    }

    /// Decode one escape sequence (the '\' is already consumed) into `out`.
    fn parse_escape(self, _ out: List<Int>) -> Result<Void, JsonError> {
        if self.pos >= self.len {
            return Result.Err(self.syntax('unterminated escape'));
        }
        let e = self.chars[self.pos];
        self.pos = self.pos + 1;
        if e == char.DQUOTE {
            out.push(char.DQUOTE);
        } else if e == char.BACKSLASH {
            out.push(char.BACKSLASH);
        } else if e == char.SLASH {
            out.push(char.SLASH);
        } else if e == 98 {
            out.push(char.BS); // \b
        } else if e == 102 {
            out.push(char.FF); // \f
        } else if e == 110 {
            out.push(char.LF); // \n
        } else if e == 114 {
            out.push(char.CR); // \r
        } else if e == 116 {
            out.push(char.TAB); // \t
        } else if e == 117 {
            let cp = self.parse_unicode_escape()?;
            out.push(cp);
        } else {
            return Result.Err(self.syntax('invalid escape'));
        }
        return Result.Ok(void);
    }

    /// A `\uXXXX` (the `\u` already consumed), combining a surrogate pair into a
    /// single astral code point when one follows.
    fn parse_unicode_escape(self) -> Result<Int, JsonError> {
        let hi = self.parse_hex4()?;
        // A high surrogate (U+D800..U+DBFF) must pair with a low surrogate.
        if hi >= 55296 && hi <= 56319 {
            if self.pos + 1 < self.len
                && self.chars[self.pos] == char.BACKSLASH
                && self.chars[self.pos + 1] == 117
            {
                self.pos = self.pos + 2; // consume '\u'
                let lo = self.parse_hex4()?;
                if lo >= 56320 && lo <= 57343 {
                    return Result.Ok(65536 + (hi - 55296) * 1024 + (lo - 56320));
                }
                return Result.Err(self.syntax('invalid low surrogate'));
            }
            return Result.Err(self.syntax('expected a low surrogate'));
        }
        // A low surrogate (U+DC00..U+DFFF) with no preceding high surrogate is not
        // a scalar value: reject it rather than emit an invalid code point.
        if hi >= 56320 && hi <= 57343 {
            return Result.Err(self.syntax('unexpected low surrogate'));
        }
        return Result.Ok(hi);
    }

    fn parse_hex4(self) -> Result<Int, JsonError> {
        let mut value = 0;
        let mut i = 0;
        while i < 4 {
            if self.pos >= self.len {
                return Result.Err(self.syntax('truncated \\u escape'));
            }
            let d = hex_value(self.chars[self.pos]);
            if d < 0 {
                return Result.Err(self.syntax('invalid hex digit'));
            }
            value = value * 16 + d;
            self.pos = self.pos + 1;
            i = i + 1;
        }
        return Result.Ok(value);
    }

    /// number = '-'? int frac? exp? (RFC 8259); leading zeros are rejected, as are
    /// a bare '.'/'e' without the digits the grammar requires.
    fn parse_number(self) -> Result<Json, JsonError> {
        let start = self.pos;
        let mut is_double = false;

        // Optional minus sign.
        if self.peek() == char.MINUS {
            self.pos = self.pos + 1;
        }

        // Integer part: a lone '0', or a non-zero digit followed by more digits.
        if self.peek() == char.DIGIT_0 {
            self.pos = self.pos + 1;
            if char.is_digit(self.peek()) {
                return Result.Err(self.syntax('number cannot have a leading zero'));
            }
        } else if char.is_digit(self.peek()) {
            self.skip_digits();
        } else {
            return Result.Err(self.syntax('invalid number'));
        }

        // Fractional part: '.' then at least one digit.
        if self.peek() == char.DOT {
            is_double = true;
            self.pos = self.pos + 1;
            if !char.is_digit(self.peek()) {
                return Result.Err(self.syntax('expected a digit after the decimal point'));
            }
            self.skip_digits();
        }

        // Exponent part: 'e'/'E', an optional sign, then at least one digit.
        if self.peek() == 101 || self.peek() == 69 { // 'e' 'E'
            is_double = true;
            self.pos = self.pos + 1;
            if self.peek() == char.PLUS || self.peek() == char.MINUS {
                self.pos = self.pos + 1;
            }
            if !char.is_digit(self.peek()) {
                return Result.Err(self.syntax('expected a digit in the exponent'));
            }
            self.skip_digits();
        }

        let token = String.from_chars(self.chars.slice(start, self.pos));
        if is_double {
            return match token.to_double() {
                Some(x) => Result.Ok(Json.Double(x)),
                None => Result.Err(self.syntax('invalid number')),
            };
        }
        // An integer, unless it overflows i64 — then fall back to Double.
        return match token.to_int() {
            Some(n) => Result.Ok(Json.Int(n)),
            None => match token.to_double() {
                Some(x) => Result.Ok(Json.Double(x)),
                None => Result.Err(self.syntax('invalid number')),
            },
        };
    }
}

/// The hex value of an ASCII hex digit, or -1.
fn hex_value(_ c: Int) -> Int {
    if char.is_digit(c) {
        return c - char.DIGIT_0;
    }
    let lower = char.to_lowercase(c);
    if lower >= 97 && lower <= 102 {
        return lower - 97 + 10; // a..f
    }
    return -1;
}

// --- serializing ---

pub fn stringify(_ value: Json, pretty: Bool = false) -> String {
    let mut parts: List<String> = [];
    write_value(value, pretty, 0, parts);
    return parts.join('');
}

fn write_value(_ v: Json, _ pretty: Bool, _ indent: Int, _ out: List<String>) -> Void {
    return match v {
        Null => out.push('null'),
        Bool(b) => out.push('${b}'),
        Int(n) => out.push('${n}'),
        Double(x) => out.push('${x}'),
        Str(s) => out.push(quote(s)),
        Array(items) => write_array(items, pretty, indent, out),
        Object(fields) => write_object(fields, pretty, indent, out),
    };
}

fn write_array(_ items: List<Json>, _ pretty: Bool, _ indent: Int, _ out: List<String>) -> Void {
    if items.len() == 0 {
        out.push('[]');
        return void;
    }
    out.push('[');
    for p in items.enumerate() {
        if pretty {
            out.push('\n');
            out.push(indent_str(indent + 1));
        }
        write_value(p.value, pretty, indent + 1, out);
        if p.index + 1 < items.len() {
            out.push(',');
        }
    }
    if pretty {
        out.push('\n');
        out.push(indent_str(indent));
    }
    out.push(']');
    return void;
}

fn write_object(
    _ fields: Map<String, Json>,
    _ pretty: Bool,
    _ indent: Int,
    _ out: List<String>,
) -> Void {
    let keys = fields.keys();
    if keys.len() == 0 {
        out.push('{}');
        return void;
    }
    out.push('{');
    for p in keys.enumerate() {
        if pretty {
            out.push('\n');
            out.push(indent_str(indent + 1));
        }
        out.push(quote(p.value));
        if pretty {
            out.push(': ');
        } else {
            out.push(':');
        }
        let value = match fields.get(p.value) {
            Some(jv) => jv,
            None => Json.Null,
        };
        write_value(value, pretty, indent + 1, out);
        if p.index + 1 < keys.len() {
            out.push(',');
        }
    }
    if pretty {
        out.push('\n');
        out.push(indent_str(indent));
    }
    out.push('}');
    return void;
}

/// A JSON string literal: `s` escaped and double-quoted.
fn quote(_ s: String) -> String {
    let cps = s.chars();
    let mut out: List<Int> = [];
    out.push(char.DQUOTE);
    for p in cps.enumerate() {
        let c = p.value;
        if c == char.DQUOTE {
            out.push(char.BACKSLASH);
            out.push(char.DQUOTE);
        } else if c == char.BACKSLASH {
            out.push(char.BACKSLASH);
            out.push(char.BACKSLASH);
        } else if c == char.BS {
            out.push(char.BACKSLASH);
            out.push(98); // \b
        } else if c == char.FF {
            out.push(char.BACKSLASH);
            out.push(102); // \f
        } else if c == char.LF {
            out.push(char.BACKSLASH);
            out.push(110); // \n
        } else if c == char.CR {
            out.push(char.BACKSLASH);
            out.push(114); // \r
        } else if c == char.TAB {
            out.push(char.BACKSLASH);
            out.push(116); // \t
        } else if c < 32 {
            // Other control characters as \u00XX.
            out.push(char.BACKSLASH);
            out.push(117); // u
            out.push(char.DIGIT_0);
            out.push(char.DIGIT_0);
            out.push(hex_char(c / 16));
            out.push(hex_char(c % 16));
        } else {
            out.push(c);
        }
    }
    out.push(char.DQUOTE);
    return String.from_chars(out);
}

/// The ASCII code of the hex digit for 0..15.
fn hex_char(_ n: Int) -> Int {
    if n < 10 {
        return char.DIGIT_0 + n;
    }
    return 97 + n - 10; // a..f
}

fn indent_str(_ level: Int) -> String {
    let out: List<Int> = [];
    let mut i = 0;
    while i < level * 2 {
        out.push(char.SPACE);
        i = i + 1;
    }
    return String.from_chars(out);
}
