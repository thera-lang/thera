//! std.core — the built-in Map<K, V> type.
//!
//! Map<K, V> is an ordered key-value store (insertion order is preserved). It is a
//! built-in type: always in scope, never explicitly imported (there is no
//! `import std.map`). Build one with a map literal: `{k1: v1, k2: v2}`.
//!
//! Indexing:
//!
//! ```thera
//! let v = scores[key];   // → V; traps if key is absent
//! scores[key] = v;       // insert / update (the binding must be `mut`)
//! ```
//!
//! Use `.get(key)` when a missing key is a normal, expected case. See "Runtime
//! faults" and "Collections" in docs/language.md.

/// The built-in ordered key-value store — an opaque, runtime-represented value (no
/// struct layout); a map literal (`{k: v}`) constructs one.
pub native type Map<K, V>

impl Map<K, V> {
    // Indexing — `m[key]` and `m[key] = v` — is built-in operator syntax (lowered
    // by the compiler, not a method, so it has no declaration here). The read
    //
    //   fn [](self, key: K) -> V          // traps if `key` is absent
    //
    // returns the value for `key`, **trapping** on a missing key — use `get` below
    // for the checked `Option<V>` form. The write
    //
    //   fn []=(self, key: K, v: V)      // insert or update; never traps
    //
    // inserts a new entry or replaces the existing one (the binding must be `mut`).
    // (Indexing isn't an overloadable interface yet; this documents the contract
    // the compiler implements for `Map`.)

    /// Number of entries.
    @extern('map_len')
    pub native fn len(self) -> Int

    /// True if there are no entries.
    pub fn is_empty(self) -> Bool {
        return self.len() == 0;
    }

    /// True if `key` is present.
    @extern('map_has')
    pub native fn has(self, key: K) -> Bool

    /// Value for `key`, or None if absent — the checked alternative to indexing.
    @extern('map_get')
    pub native fn get(self, key: K) -> Option<V>

    /// Value for `key`, or `default` if absent — the unwrap-with-fallback form of
    /// `get`, so a missing key needs no `match`.
    ///
    /// ```thera
    /// counts.get_or('x', 0)
    /// ```
    pub fn get_or(self, key: K, default: V) -> V {
        match self.get(key) {
            Some(v) => { return v; }
            None => { return default; }
        }
    }

    /// Remove `key`, returning its previous value if it was present.
    @extern('map_remove')
    pub native fn remove(self, key: K) -> Option<V>

    /// Remove every entry, in place (the map becomes empty; same reference).
    @extern('map_clear')
    pub native fn clear(self) -> Void

    /// Keys / values, in insertion order.
    @extern('map_keys')
    pub native fn keys(self) -> List<K>

    @extern('map_values')
    pub native fn values(self) -> List<V>

    /// The entries, in insertion order, as `Entry<K, V>` values (`.key`, `.value`)
    /// — the paired form of [keys]/[values], for iterating both at once.
    ///
    /// ```thera
    /// for e in scores.entries() {
    ///     println('${e.key}: ${e.value}');
    /// }
    /// ```
    pub fn entries(self) -> List<Entry<K, V>> {
        let result = [];
        for key in self.keys() {
            result.push(Entry { key: key, value: self[key] });
        }
        return result;
    }
}

/// One key-value pair of a map, as produced by [Map.entries] — read `.key` and
/// `.value` (the map-shaped sibling of `Indexed<T>`'s `.index`/`.value`).
pub struct Entry<K, V> {
    let key: K;
    let value: V;
}

impl Debug for Map<K, V> {
    /// `[k: v, ...]` — keys and values rendered via `Debug`, in insertion order.
    /// (Empty map: `[:]`.)
    fn debug(self) -> String {
        if self.is_empty() { return '[:]'; }

        let mut s = '[';
        let mut first = true;
        for key in self.keys() {
            if !first {
                s = s + ', ';
            }
            s = s + key.debug() + ': ' + self[key].debug();
            first = false;
        }
        return s + ']';
    }
}

/// A map's display form *is* its developer form — the structural `Debug` rendering
/// is canonical (there is no prettier user-facing shape; the Python
/// `str`-delegates-to-`repr` convention for containers).
impl Display for Map<K, V> {
    fn to_string(self) -> String {
        return self.debug();
    }
}
