/// std.core — the Option type.
///
/// `Option<T>` represents an optional value: `Some(T)` when present, `None` when
/// absent. It is one of the two language-blessed enums (the `?` operator and the
/// built-in helper methods know it by name), but it is otherwise an ordinary enum
/// defined here in Thera.
///
/// The variant order is significant: it fixes the runtime tags (Some = 0, None = 1)
/// shared with the bytecode runtime — do not reorder.
///
/// Reaching for the right tool (see also `if let` / `let … else` in language.md):
/// `if let` to act on a present value, `let … else` to bind or bail, and these
/// combinators to transform or default a value inline — `map`/`and_then` to carry a
/// computation through, `unwrap_or`/`unwrap_or_else` to exit with a default,
/// `ok_or` to turn absence into a `Result`. Reserve `match` for genuinely choosing
/// among variants.
pub enum Option<T> {
    Some(T),
    None,
}

impl Option<T> {
    /// Convert to a `Result`, treating `None` as the error `err`. Reach for it to
    /// turn an absent value into a failure you can propagate with `?`.
    ///
    /// ```thera
    /// let config = ['port': 8080];
    /// let port = config.get('port').ok_or(error('port is required'))?;
    /// ```
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        return match self {
            Some(v) => Result.Ok(v),
            None => Result.Err(err),
        };
    }

    /// The contained value if present, else `fallback`. Reach for it to exit with a
    /// default when the fallback is a cheap, already-computed value (use
    /// `unwrap_or_else` if it is expensive).
    ///
    /// ```thera
    /// let config = ['host': 443];
    /// let port = config.get('port').unwrap_or(8080);   // 8080
    /// ```
    pub fn unwrap_or(self, fallback: T) -> T {
        return match self {
            Some(v) => v,
            None => fallback,
        };
    }

    /// Whether a value is present. (To use the value, prefer `if let` / `?`; this
    /// is for a plain boolean check.)
    ///
    /// ```thera
    /// let config = ['port': 8080];
    /// if config.get('port').is_some() {
    ///     println('the port was set explicitly');
    /// }
    /// ```
    pub fn is_some(self) -> Bool {
        return match self {
            Some(_) => true,
            None => false,
        };
    }

    /// Whether a value is absent.
    ///
    /// ```thera
    /// let config = ['port': 8080];
    /// if config.get('host').is_none() {
    ///     println('no host configured; using the default');
    /// }
    /// ```
    pub fn is_none(self) -> Bool {
        return match self {
            Some(_) => false,
            None => true,
        };
    }

    /// Transform the contained value; `None` is unchanged — `Some(x)` becomes
    /// `Some(f(x))`. Reach for it over a `match` to apply a pure function inline,
    /// keeping the optional shape.
    ///
    /// ```thera
    /// let name = Option.Some('ada');
    /// let initial = name.map((s) => s.slice(0, 1));   // Some('a')
    /// ```
    pub fn map<U>(self, f: (T) -> U) -> Option<U> {
        return match self {
            Some(v) => Option.Some(f(v)),
            None => Option.None,
        };
    }

    /// Chain a fallible step: apply `f` (itself returning an `Option`) when
    /// present, flattening the result. Reach for it over nested `match`/`map` when
    /// the next step can also be absent.
    ///
    /// ```thera
    /// let config = ['port': '8080'];
    /// let port = config.get('port').and_then((s) => s.to_int());   // Some(8080)
    /// ```
    pub fn and_then<U>(self, f: (T) -> Option<U>) -> Option<U> {
        return match self {
            Some(v) => f(v),
            None => Option.None,
        };
    }

    /// The contained value if present, else the result of calling `f`. Reach for it
    /// over `unwrap_or` when the fallback is expensive or has a side effect — `f`
    /// runs only on `None`.
    ///
    /// ```thera
    /// fn load_config() -> String {
    ///     return 'defaults';   // pretend this reads a file
    /// }
    ///
    /// let cached: Option<String> = Option.None;
    /// let conf = cached.unwrap_or_else(() => load_config());   // 'defaults'
    /// ```
    pub fn unwrap_or_else(self, f: () -> T) -> T {
        return match self {
            Some(v) => v,
            None => f(),
        };
    }
}

impl Debug for Option<T> {
    /// `Some(x)` / `None` — the contained value rendered via `Debug`.
    fn debug(self) -> String {
        return match self {
            Some(v) => 'Some(${v.debug()})',
            None => 'None',
        };
    }
}

/// An option's display form *is* its developer form — the structural `Debug`
/// rendering is canonical (there is no prettier user-facing shape; the Python
/// `str`-delegates-to-`repr` convention for containers).
impl Display for Option<T> {
    fn to_string(self) -> String {
        return self.debug();
    }
}
