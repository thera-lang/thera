//! Tests for the built-in List<T> higher-order methods written in Thera.

import std.testing;

@test
fn test_slice() -> Result<Void, Error> {
    testing.assert_eq(actual: [10, 20, 30, 40].slice(1, 3), expected: [20, 30])?;
    testing.assert_eq(actual: [10, 20, 30, 40].slice(0, 4), expected: [10, 20, 30, 40])?;
    testing.assert_eq(actual: [10, 20, 30].slice(0, 99), expected: [10, 20, 30])?;
    // clamps high
    testing.assert_eq(actual: [10, 20, 30].slice(-5, 2), expected: [10, 20])?;
    // clamps low
    testing.assert_eq(actual: [10, 20, 30].slice(2, 1), expected: [])?;
    // reversed -> empty
    testing.assert_eq(actual: [10, 20, 30].slice(1, 1), expected: [])?;
    // empty range
    return Result.Ok(void);
}

@test
fn test_iter_roundtrips() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    testing.assert_eq(actual: xs.iter().to_list(), expected: xs)?;
    testing.assert_eq(actual: [].iter().count(), expected: 0)?;
    return Result.Ok(void);
}

@test
fn test_iter_fuses_a_lazy_chain() -> Result<Void, Error> {
    // The opt-in lazy path: map/filter fused in one walk, materialized once.
    let out = [1, 2, 3, 4, 5]
        .iter()
        .map((n) => n * n)
        .filter((n) => n > 4)
        .to_list();
    testing.assert_eq(actual: out, expected: [9, 16, 25])?;
    return Result.Ok(void);
}

@test
fn test_iter_take_short_circuits() -> Result<Void, Error> {
    let out = [10, 20, 30, 40].iter().take(2).to_list();
    testing.assert_eq(actual: out, expected: [10, 20])?;
    return Result.Ok(void);
}

@test
fn test_iter_drives_a_for_loop() -> Result<Void, Error> {
    let mut sum = 0;
    for n in [4, 5, 6].iter() {
        sum = sum + n;
    }
    testing.assert_eq(actual: sum, expected: 15)?;
    return Result.Ok(void);
}

@test
fn test_enumerate_pairs_index_and_value() -> Result<Void, Error> {
    // Collected: each element paired with its 0-based position.
    let pairs = ['a', 'b', 'c'].enumerate().to_list();
    testing.assert_eq(actual: pairs.len(), expected: 3)?;
    testing.assert_eq(actual: pairs[0].index, expected: 0)?;
    testing.assert_eq(actual: pairs[0].value, expected: 'a')?;
    testing.assert_eq(actual: pairs[2].index, expected: 2)?;
    testing.assert_eq(actual: pairs[2].value, expected: 'c')?;
    return Result.Ok(void);
}

@test
fn test_enumerate_drives_a_for_loop() -> Result<Void, Error> {
    // The intended use: iterate with the index in hand (the `while i < xs.len()`
    // replacement).
    let xs = [10, 20, 30];
    let mut seen: List<String> = [];
    for p in xs.enumerate() {
        seen.push('${p.index}=${p.value}');
    }
    testing.assert_eq(actual: seen, expected: ['0=10', '1=20', '2=30'])?;
    return Result.Ok(void);
}

@test
fn test_enumerate_empty_is_empty() -> Result<Void, Error> {
    let empty: List<Int> = [];
    testing.assert_eq(actual: empty.enumerate().count(), expected: 0)?;
    return Result.Ok(void);
}

@test
fn test_enumerate_is_lazy_and_composes() -> Result<Void, Error> {
    // A lazy adapter like `Iterator.enumerate` — the interface default methods
    // (`filter`/`to_list`) compose on it.
    let evens = [5, 6, 7, 8].enumerate().filter((p) => p.value % 2 == 0).to_list();
    testing.assert_eq(actual: evens.len(), expected: 2)?;
    testing.assert_eq(actual: evens[0].index, expected: 1)?;
    testing.assert_eq(actual: evens[0].value, expected: 6)?;
    return Result.Ok(void);
}

@test
fn test_map_filter_fold_still_work() -> Result<Void, Error> {
    let xs = [1, 2, 3, 4];
    testing.assert_eq(actual: xs.map(n => n * 2), expected: [2, 4, 6, 8])?;
    testing.assert_eq(actual: xs.filter(n => n % 2 == 0), expected: [2, 4])?;
    testing.assert_eq(actual: xs.fold(0, (acc, n) => acc + n), expected: 10)?;
    return Result.Ok(void);
}

@test
fn test_first_last_is_empty() -> Result<Void, Error> {
    testing.assert_eq(actual: [10, 20, 30].first(), expected: Option.Some(10))?;
    testing.assert_eq(actual: [10, 20, 30].last(), expected: Option.Some(30))?;
    let empty: List<Int> = [];
    testing.assert_eq(actual: empty.first(), expected: Option.None)?;
    testing.assert_eq(actual: empty.last(), expected: Option.None)?;
    testing.assert(empty.is_empty())?;
    testing.assert(![1].is_empty())?;
    return Result.Ok(void);
}

@test
fn test_contains_index_of() -> Result<Void, Error> {
    let xs = [10, 20, 30, 20];
    testing.assert(xs.contains(20))?;
    testing.assert(!xs.contains(99))?;
    testing.assert_eq(actual: xs.index_of(20), expected: Option.Some(1))?; // first
    testing.assert_eq(actual: xs.index_of(99), expected: Option.None)?;
    testing.assert(['a', 'b'].contains('b'))?;
    return Result.Ok(void);
}

@test
fn test_any_all() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    testing.assert(xs.any(n => n == 2))?;
    testing.assert(!xs.any(n => n > 9))?;
    testing.assert(xs.all(n => n > 0))?;
    testing.assert(!xs.all(n => n == 1))?;
    // Empty list: `any` is false, `all` is vacuously true.
    let empty: List<Int> = [];
    testing.assert(!empty.any(n => true))?;
    testing.assert(empty.all(n => false))?;
    return Result.Ok(void);
}

@test
fn test_find_find_index() -> Result<Void, Error> {
    let xs = [10, 21, 30, 41];
    // The first match wins.
    testing.assert_eq(actual: xs.find(n => n % 2 == 1), expected: Option.Some(21))?;
    testing.assert_eq(actual: xs.find(n => n > 99), expected: Option.None)?;
    testing.assert_eq(actual: xs.find_index(n => n % 2 == 1), expected: Option.Some(1))?;
    testing.assert_eq(actual: xs.find_index(n => n > 99), expected: Option.None)?;
    return Result.Ok(void);
}

@test
fn test_insert_in_place() -> Result<Void, Error> {
    let xs = [1, 3];
    xs.insert(1, 2); // middle
    testing.assert_eq(actual: xs, expected: [1, 2, 3])?;
    xs.insert(0, 0); // front
    testing.assert_eq(actual: xs, expected: [0, 1, 2, 3])?;
    xs.insert(4, 4); // `insert(len, v)` is `push(v)`
    testing.assert_eq(actual: xs, expected: [0, 1, 2, 3, 4])?;
    let empty: List<Int> = [];
    empty.insert(0, 7);
    testing.assert_eq(actual: empty, expected: [7])?;
    return Result.Ok(void);
}

@test
fn test_remove_at_in_place() -> Result<Void, Error> {
    let xs = [10, 20, 30, 40];
    testing.assert_eq(actual: xs.remove_at(1), expected: 20)?; // middle
    testing.assert_eq(actual: xs, expected: [10, 30, 40])?;
    testing.assert_eq(actual: xs.remove_at(0), expected: 10)?; // first
    testing.assert_eq(actual: xs.remove_at(1), expected: 40)?; // last
    testing.assert_eq(actual: xs, expected: [30])?;
    testing.assert_eq(actual: xs.remove_at(0), expected: 30)?; // drain to empty
    testing.assert(xs.is_empty())?;
    return Result.Ok(void);
}

@test
fn test_extend_in_place() -> Result<Void, Error> {
    let xs = [1, 2];
    xs.extend([3, 4]);
    testing.assert_eq(actual: xs, expected: [1, 2, 3, 4])?;
    xs.extend([]);
    testing.assert_eq(actual: xs, expected: [1, 2, 3, 4])?;
    // Self-extension doubles the list (the source length is captured up front).
    let ys = [1, 2];
    ys.extend(ys);
    testing.assert_eq(actual: ys, expected: [1, 2, 1, 2])?;
    return Result.Ok(void);
}

@test
fn test_concat_returns_new() -> Result<Void, Error> {
    let xs = [1, 2];
    let ys = [3];
    testing.assert_eq(actual: xs.concat(ys), expected: [1, 2, 3])?;
    // Neither input changes.
    testing.assert_eq(actual: xs, expected: [1, 2])?;
    testing.assert_eq(actual: ys, expected: [3])?;
    let empty: List<Int> = [];
    testing.assert_eq(actual: empty.concat(xs), expected: xs)?;
    testing.assert_eq(actual: xs.concat(empty), expected: xs)?;
    return Result.Ok(void);
}

@test
fn test_flat_map() -> Result<Void, Error> {
    testing.assert_eq(
        actual: [1, 2, 3].flat_map(n => [n, n * 10]),
        expected: [1, 10, 2, 20, 3, 30],
    )?;
    // Empty inner lists just contribute nothing.
    let none: List<Int> = [];
    testing.assert_eq(actual: [1, 2, 3].flat_map(n => none), expected: none)?;
    testing.assert_eq(actual: none.flat_map(n => [n]), expected: none)?;
    return Result.Ok(void);
}

@test
fn test_reverse_in_place() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    xs.reverse();
    testing.assert_eq(actual: xs, expected: [3, 2, 1])?;
    let empty: List<Int> = [];
    empty.reverse();
    testing.assert_eq(actual: empty, expected: [])?;
    let one = [7];
    one.reverse();
    testing.assert_eq(actual: one, expected: [7])?;
    return Result.Ok(void);
}

@test
fn test_reversed_returns_new() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    testing.assert_eq(actual: xs.reversed(), expected: [3, 2, 1])?;
    // The receiver is unchanged.
    testing.assert_eq(actual: xs, expected: [1, 2, 3])?;
    let empty: List<Int> = [];
    testing.assert_eq(actual: empty.reversed(), expected: empty)?;
    return Result.Ok(void);
}

@test
fn test_sort_in_place() -> Result<Void, Error> {
    let xs = [3, 1, 2];
    xs.sort((a, b) => a < b);
    testing.assert_eq(actual: xs, expected: [1, 2, 3])?;
    xs.sort((a, b) => b < a);
    testing.assert_eq(actual: xs, expected: [3, 2, 1])?;
    let empty: List<Int> = [];
    empty.sort((a, b) => a < b);
    testing.assert_eq(actual: empty, expected: [])?;
    return Result.Ok(void);
}

@test
fn test_sorted_by_returns_new() -> Result<Void, Error> {
    let xs = [3, 1, 2];
    testing.assert_eq(actual: xs.sorted_by((a, b) => a < b), expected: [1, 2, 3])?;
    // The receiver is unchanged.
    testing.assert_eq(actual: xs, expected: [3, 1, 2])?;
    let empty: List<Int> = [];
    testing.assert_eq(actual: empty.sorted_by((a, b) => a < b), expected: empty)?;
    testing.assert_eq(
        actual: [5, 4, 3, 2, 1].sorted_by((a, b) => a < b),
        expected: [1, 2, 3, 4, 5],
    )?;
    // Stable: equal keys (by first tuple element) keep input order.
    let pairs = [[2, 1], [1, 1], [2, 2], [1, 2]];
    testing.assert_eq(
        actual: pairs.sorted_by((a, b) => a[0] < b[0]),
        expected: [[1, 1], [1, 2], [2, 1], [2, 2]],
    )?;
    return Result.Ok(void);
}

@test
fn test_display() -> Result<Void, Error> {
    // `Display` renders elements via `Debug`; nested lists recurse.
    testing.assert_eq(actual: '${[1, 2, 3]}', expected: '[1, 2, 3]')?;
    testing.assert_eq(actual: '${[[1], [2, 3]]}', expected: '[[1], [2, 3]]')?;
    let empty: List<Int> = [];
    testing.assert_eq(actual: '${empty}', expected: '[]')?;
    return Result.Ok(void);
}

@test
fn test_clear_empties_in_place() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    let alias = xs; // same underlying list (reference type)
    xs.clear();
    testing.assert(xs.is_empty())?;
    testing.assert_eq(actual: xs.len(), expected: 0)?;
    testing.assert(alias.is_empty(), message: 'clear is observed through an alias')?;
    xs.push(7); // still usable after clearing
    testing.assert_eq(actual: xs.get(0), expected: Option.Some(7))?;
    return Result.Ok(void);
}

@test
fn test_pop_returns_last_and_shrinks() -> Result<Void, Error> {
    let xs = [1, 2, 3];
    let alias = xs; // same underlying list (reference type)
    testing.assert_eq(actual: xs.pop(), expected: Option.Some(3))?;
    testing.assert_eq(actual: xs.pop(), expected: Option.Some(2))?;
    testing.assert_eq(actual: xs.len(), expected: 1)?;
    // pop is observed through an alias (reference type)
    testing.assert_eq(actual: alias.last(), expected: Option.Some(1))?;
    return Result.Ok(void);
}

@test
fn test_pop_empty_is_none() -> Result<Void, Error> {
    let xs: List<Int> = [];
    testing.assert_eq(actual: xs.pop(), expected: Option.None)?;
    // Drain-to-empty then one more pop.
    let ys = [9];
    testing.assert_eq(actual: ys.pop(), expected: Option.Some(9))?;
    testing.assert_eq(actual: ys.pop(), expected: Option.None)?;
    return Result.Ok(void);
}

@test
fn test_pop_as_stack() -> Result<Void, Error> {
    // push/pop drive a LIFO stack — the use that motivated `pop`.
    let stack = [];
    stack.push('a');
    stack.push('b');
    let out = [];
    let mut going = true;
    while going {
        match stack.pop() {
            Some(x) => { out.push(x); },
            None => { going = false; },
        }
    }
    testing.assert_eq(actual: out, expected: ['b', 'a'])?;
    return Result.Ok(void);
}
