//! std.core — the Result type.
//!
//! `Result<T, E>` represents a fallible outcome: `Ok(T)` on success, `Err(E)` on
//! failure. `Result<T, Error>` is the conventional fallible signature throughout
//! Thera. It is one of the two language-blessed enums (the `?` operator, and the
//! program entry point's exit-code convention, know it by name), but it is
//! otherwise an ordinary enum defined here in Thera.
//!
//! The variant order is significant: it fixes the runtime tags (Ok = 0, Err = 1)
//! shared with the bytecode runtime — do not reorder.
//!
//! Reaching for the right tool: `?` to propagate a failure to the caller (the usual
//! move in a `Result`-returning function); the combinators below to work with a
//! result inline — `map` to adapt the success, `map_err` to wrap the error before
//! propagating, `and_then` to chain another fallible step,
//! `unwrap_or`/`unwrap_or_else` to exit with a default, `ok` to drop the error to
//! an `Option`. Reserve `match` for handling both arms at a boundary.
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl Result<T, E> {
    /// Whether this is `Ok`. (To use the value, prefer `?` or `match`; this is for
    /// a plain boolean check.)
    ///
    /// ```thera
    /// let parsed = '7'.to_int().ok_or(error('not a number'));
    /// if parsed.is_ok() {
    ///     println('that was a number');
    /// }
    /// ```
    pub fn is_ok(self) -> Bool {
        return match self {
            Ok(_) => true,
            Err(_) => false,
        };
    }

    /// Whether this is `Err`.
    ///
    /// ```thera
    /// let parsed = 'x'.to_int().ok_or(error('not a number'));
    /// if parsed.is_err() {
    ///     println('that was not a number');
    /// }
    /// ```
    pub fn is_err(self) -> Bool {
        return match self {
            Ok(_) => false,
            Err(_) => true,
        };
    }

    /// Transform the `Ok` value, leaving an `Err` unchanged. Reach for it to adapt
    /// a success value without unwrapping or touching the error.
    ///
    /// ```thera
    /// let parsed = '7'.to_int().ok_or(error('not a number'));
    /// let doubled = parsed.map((n) => n * 2);   // Ok(14)
    /// ```
    pub fn map<U>(self, f: (T) -> U) -> Result<U, E> {
        return match self {
            Ok(v) => Result.Ok(f(v)),
            Err(e) => Result.Err(e),
        };
    }

    /// Transform the `Err` value, leaving an `Ok` unchanged. Reach for it to add
    /// context to a low-level error — or to lift it into a domain error type —
    /// before propagating with `?`.
    ///
    /// ```thera
    /// let parsed = 'x'.to_int().ok_or(error('not a number'));
    /// let n = parsed.map_err((e) => error('config: ${e.message()}'))?;
    /// ```
    pub fn map_err<F>(self, f: (E) -> F) -> Result<T, F> {
        return match self {
            Ok(v) => Result.Ok(v),
            Err(e) => Result.Err(f(e)),
        };
    }

    /// Chain a fallible step: apply `f` (itself returning a `Result`) on `Ok`,
    /// flattening; short-circuits on `Err`. In a `Result`-returning function `?` is
    /// usually clearer — reach for `and_then` in expression position.
    ///
    /// ```thera
    /// let parsed = '7'.to_int().ok_or(error('not a number'));
    /// let v = parsed.and_then((n) =>
    ///     if n < 1024 { Result.Err(error('reserved port')) } else { Result.Ok(n) });
    /// ```
    pub fn and_then<U>(self, f: (T) -> Result<U, E>) -> Result<U, E> {
        return match self {
            Ok(v) => f(v),
            Err(e) => Result.Err(e),
        };
    }

    /// The `Ok` value, or `fallback` on `Err`. Reach for it to supply a default and
    /// discard the error.
    ///
    /// ```thera
    /// let parsed = 'x'.to_int().ok_or(error('not a number'));
    /// let port = parsed.unwrap_or(8080);   // 8080
    /// ```
    pub fn unwrap_or(self, fallback: T) -> T {
        return match self {
            Ok(v) => v,
            Err(_) => fallback,
        };
    }

    /// The `Ok` value, or the result of `f` applied to the error. Reach for it over
    /// `unwrap_or` when the fallback depends on the error (or is expensive).
    ///
    /// ```thera
    /// let loaded: Result<String, Error> = Result.Err(error('no such file'));
    /// let text = loaded.unwrap_or_else((e) => '# ${e.message()}');
    /// ```
    pub fn unwrap_or_else(self, f: (E) -> T) -> T {
        return match self {
            Ok(v) => v,
            Err(e) => f(e),
        };
    }

    /// Discard the error, converting to an `Option`: `Ok(v)` → `Some(v)`, `Err(_)`
    /// → `None`. Reach for it when only presence matters, not the error.
    ///
    /// ```thera
    /// let parsed = '7'.to_int().ok_or(error('not a number'));
    /// let maybe = parsed.ok();   // Some(7)
    /// ```
    pub fn ok(self) -> Option<T> {
        return match self {
            Ok(v) => Option.Some(v),
            Err(_) => Option.None,
        };
    }
}

impl Debug for Result<T, E> {
    /// `Ok(x)` / `Err(e)` — the contained value rendered via `Debug`.
    fn debug(self) -> String {
        return match self {
            Ok(v) => 'Ok(${v.debug()})',
            Err(e) => 'Err(${e.debug()})',
        };
    }
}

/// A result's display form *is* its developer form — the structural `Debug`
/// rendering is canonical (there is no prettier user-facing shape; the Python
/// `str`-delegates-to-`repr` convention for containers).
impl Display for Result<T, E> {
    fn to_string(self) -> String {
        return self.debug();
    }
}
