//! std.core — the built-in List<T> type's higher-order methods, written in Thera.
//!
//! List<T> is a built-in, growable sequence: always in scope, never explicitly
//! imported (there is no `import std.list`). It is not constructed via a struct
//! literal — build one with a list literal, `[a, b, c]`.
//!
//! `.len()`, `.get(i)`, `.push(v)`, and `.join(sep)` are declared below as
//! `native fn`s backed by runtime natives; indexing (`xs[i]`) is built-in syntax.
//! The transforms further down are ordinary Thera methods that take a closure and
//! are compiled like any other code — the payoff of closures (see
//! examples/closures.thera, docs/bytecode.md).
//!
//! ```thera
//! let evens = [1, 2, 3, 4].filter(n => n % 2 == 0);   // [2, 4]
//! let lengths = ['ada', 'bo'].map(s => s.len());      // [3, 2]
//! ```
//!
//! `sort` takes an explicit comparator (`less`); a no-argument `sort()` keyed on a
//! built-in `Ord` interface waits on that interface landing.

/// The built-in growable sequence type — an opaque, runtime-represented value (no
/// struct layout); a list literal (`[a, b, c]`) constructs one.
pub native type List<T>

impl List<T> {
    // Indexing — `xs[i]` and `xs[i] = v` — is built-in operator syntax (lowered by
    // the compiler, not a method, so it has no declaration here). The read
    //
    //   fn [](self, i: Int) -> T          // traps if `i` is out of range
    //
    // returns the element at `i`, **trapping** on an out-of-range index — use `get`
    // below for the checked `Option<T>` form. The write
    //
    //   fn []=(self, i: Int, v: T)      // traps if `i` is out of range
    //
    // replaces `xs[i]` in place; it cannot extend the list (use `push`), so an
    // out-of-range index traps. (Indexing isn't an overloadable interface yet; this
    // documents the contract the compiler implements for `List`.)

    /// Number of elements.
    @extern('list_len')
    pub native fn len(self) -> Int

    /// The element at `i`, or None if out of range — the checked alternative to
    /// indexing with `[]`.
    @extern('list_get')
    pub native fn get(self, i: Int) -> Option<T>

    /// Join the elements (rendered via Display) with `sep` between them.
    @extern('list_join')
    pub native fn join(self, sep: String) -> String

    /// Append `item` to the end, in place.
    @extern('list_push')
    pub native fn push(self, item: T) -> Void

    /// Remove and return the last element, in place — `None` if the list is empty.
    /// The mutating companion of `last()`.
    @extern('list_pop')
    pub native fn pop(self) -> Option<T>

    /// Remove every element, in place (the list becomes empty; same reference).
    @extern('list_clear')
    pub native fn clear(self) -> Void

    /// True if the list has no elements.
    pub fn is_empty(self) -> Bool {
        return self.len() == 0;
    }

    /// The first / last element, or None if the list is empty — the checked
    /// alternative to `xs[0]` / `xs[xs.len() - 1]`.
    pub fn first(self) -> Option<T> {
        return self.get(0);
    }

    pub fn last(self) -> Option<T> {
        return self.get(self.len() - 1);
    }

    /// True if `item` is equal (`==`) to some element.
    pub fn contains(self, item: T) -> Bool {
        for x in self {
            if x == item {
                return true;
            }
        }
        return false;
    }

    /// The index of the first element equal to `item`, or None if absent.
    pub fn index_of(self, item: T) -> Option<Int> {
        let mut i = 0;
        let n = self.len();
        while i < n {
            if self[i] == item {
                return Option.Some(i);
            }
            i = i + 1;
        }
        return Option.None;
    }

    /// True if `pred` returns true for at least one element (false for an empty
    /// list); stops at the first match. The predicate form of [contains].
    pub fn any(self, pred: (T) -> Bool) -> Bool {
        for x in self {
            if pred(x) {
                return true;
            }
        }
        return false;
    }

    /// True if `pred` returns true for every element (vacuously true for an empty
    /// list); stops at the first counterexample.
    pub fn all(self, pred: (T) -> Bool) -> Bool {
        for x in self {
            if !pred(x) {
                return false;
            }
        }
        return true;
    }

    /// The first element for which `pred` returns true, or None if there is none.
    pub fn find(self, pred: (T) -> Bool) -> Option<T> {
        for x in self {
            if pred(x) {
                return Option.Some(x);
            }
        }
        return Option.None;
    }

    /// The index of the first element for which `pred` returns true, or None if
    /// there is none — the predicate form of [index_of].
    pub fn find_index(self, pred: (T) -> Bool) -> Option<Int> {
        let mut i = 0;
        let n = self.len();
        while i < n {
            if pred(self[i]) {
                return Option.Some(i);
            }
            i = i + 1;
        }
        return Option.None;
    }

    /// Insert `item` at index `at`, in place, shifting later elements one slot
    /// toward the end. `at` may be any index in `[0, len]` — `insert(len, v)` is
    /// `push(v)`; anything outside that range traps (the indexing contract).
    pub fn insert(self, at: Int, item: T) -> Void {
        if at == self.len() {
            self.push(item);
            return;
        }
        // Every other valid `at` names an existing slot, so this read traps on an
        // out-of-range index before the list is touched. Then ripple `prev` toward
        // the end, one swap per slot, and the displaced last element becomes a
        // push.
        let mut prev = self[at];
        self[at] = item;
        let mut i = at + 1;
        while i < self.len() {
            let tmp = self[i];
            self[i] = prev;
            prev = tmp;
            i = i + 1;
        }
        self.push(prev);
    }

    /// Remove and return the element at index `i`, in place, shifting later
    /// elements one slot toward the front; traps if `i` is out of range (the
    /// indexing contract). The positional companion of `pop` (which is
    /// `remove_at(len - 1)` with a checked `Option` result).
    pub fn remove_at(self, i: Int) -> T {
        let removed = self[i];
        let mut j = i;
        let last = self.len() - 1;
        while j < last {
            self[j] = self[j + 1];
            j = j + 1;
        }
        self.pop();
        return removed;
    }

    /// Append every element of `other` to this list, in place (like `push`, a
    /// mutation of this list; the returns-new form is [concat]).
    pub fn extend(self, other: List<T>) -> Void {
        // Iterate to a pre-captured length so `xs.extend(xs)` doubles the list
        // rather than chasing its own growth.
        let n = other.len();
        let mut i = 0;
        while i < n {
            self.push(other[i]);
            i = i + 1;
        }
    }

    /// A new list of this list's elements followed by `other`'s; neither input
    /// changes (the in-place form is [extend]).
    pub fn concat(self, other: List<T>) -> List<T> {
        let result = [];
        result.extend(self);
        result.extend(other);
        return result;
    }

    /// Reverse the elements **in place** (like `push`/`pop`, a mutation of this
    /// list; the returns-new form is [reversed]).
    pub fn reverse(self) -> Void {
        let mut i = 0;
        let mut j = self.len() - 1;
        while i < j {
            let tmp = self[i];
            self[i] = self[j];
            self[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }

    /// A new list with the elements in reverse order (this list is unchanged; the
    /// in-place form is [reverse]).
    pub fn reversed(self) -> List<T> {
        let result = [];
        let mut i = self.len() - 1;
        while i >= 0 {
            result.push(self[i]);
            i = i - 1;
        }
        return result;
    }

    /// Sort the elements **in place** by `less` (like `push`/`pop`, a mutation of
    /// this list; the returns-new form is [sorted_by]). `less(a, b)` is true when
    /// `a` should come before `b`; stable, O(n log n).
    ///
    /// ```thera
    /// let nums = [3, 1, 2];
    /// nums.sort((a, b) => a < b);   // ascending:  [1, 2, 3]
    /// nums.sort((a, b) => b < a);   // descending: [3, 2, 1]
    ///
    /// // `<` is Int/Double only — other element types order through their own
    /// // comparison.
    /// let names = ['bo', 'ada'];
    /// names.sort((a, b) => a.compare(b) == Ordering.Less);
    /// ```
    pub fn sort(self, less: (T, T) -> Bool) -> Void {
        let out = self.sorted_by(less);
        let mut i = 0;
        while i < out.len() {
            self[i] = out[i];
            i = i + 1;
        }
    }

    /// A new list with the elements ordered by `less` — `less(a, b)` is true when
    /// `a` should come before `b` (this list is unchanged; the in-place form is
    /// [sort]). The sort is **stable** (equal elements keep their input order) and
    /// runs in O(n log n) via a bottom-up merge.
    ///
    /// ```thera
    /// struct Edit { let start: Int; let text: String; }
    ///
    /// let edits = [Edit { start: 9, text: 'b' }, Edit { start: 3, text: 'a' }];
    /// let ordered = edits.sorted_by((a, b) => a.start < b.start);   // edits unchanged
    /// ```
    pub fn sorted_by(self, less: (T, T) -> Bool) -> List<T> {
        // Bottom-up merge sort over a working copy; `less` decides order and a
        // `!less(right, left)` tie-break (take the left first) keeps it stable.
        let mut src = [];
        for x in self {
            src.push(x);
        }
        let n = src.len();
        let mut width = 1;
        while width < n {
            let mut dst = [];
            let mut lo = 0;
            while lo < n {
                let mid = (lo + width).min(n);
                let hi = (lo + width + width).min(n);
                let mut i = lo;
                let mut j = mid;
                while i < mid || j < hi {
                    if i >= mid {
                        dst.push(src[j]);
                        j = j + 1;
                    } else if j >= hi {
                        dst.push(src[i]);
                        i = i + 1;
                    } else if less(src[j], src[i]) {
                        dst.push(src[j]);
                        j = j + 1;
                    } else {
                        dst.push(src[i]);
                        i = i + 1;
                    }
                }
                lo = lo + width + width;
            }
            src = dst;
            width = width + width;
        }
        return src;
    }

    /// A lazy iterator pairing each element with its 0-based position, as
    /// `Indexed<T>` values (`.index`, `.value`). Reach for it to iterate with the
    /// index in hand — `for p in xs.enumerate() { … p.index … p.value … }` — in
    /// place of a manual `while i < xs.len()` index loop.
    ///
    /// ```thera
    /// for p in ['a', 'b'].enumerate() {
    ///     println('${p.index}: ${p.value}');   // 0: a\n1: b
    /// }
    /// ```
    pub fn enumerate(self) -> Iterator<Indexed<T>> {
        return self.iter().enumerate();
    }

    /// A **lazy** `Iterator` over the elements, in order — the opt-in gateway to
    /// the pull-based `Iterator` protocol (`map`/`filter`/`take`/`enumerate`, then
    /// `to_list`/`count`).
    ///
    /// Prefer the eager `map`/`filter` below for the common case: they return a
    /// plain `List`, so the result keeps indexing, `len`, re-iteration, and further
    /// list methods. Reach for `iter()` when a *chain* of transforms would
    /// otherwise build throwaway intermediate lists, when you want to stop early
    /// (`take(n)`), or when the data is large enough that fusing the passes matters
    /// — `iter()` runs the whole chain in one walk with no intermediates:
    ///
    /// ```thera
    /// let xs = [1, 2, 3, 4, 5];
    ///
    /// // eager: one intermediate list, then the final list — fine for small input
    /// let a = xs.map((n) => n * n).filter((n) => n > 10);
    ///
    /// // lazy: fused single pass, materialized once at the end
    /// let b = xs.iter().map((n) => n * n).filter((n) => n > 10).to_list();
    /// ```
    ///
    /// Note an `Iterator` is single-use (stateful: consumed as it is read), so call
    /// `iter()` again for a fresh pass rather than reusing the value.
    pub fn iter(self) -> Iterator<T> {
        return ListIter { items: self, pos: 0 };
    }

    /// A new list with `f` applied to each element, in order.
    pub fn map<U>(self, f: (T) -> U) -> List<U> {
        let result = [];
        for item in self {
            result.push(f(item));
        }
        return result;
    }

    /// A new list of the elements for which `keep` returns true, in order.
    pub fn filter(self, keep: (T) -> Bool) -> List<T> {
        let result = [];
        for item in self {
            if keep(item) {
                result.push(item);
            }
        }
        return result;
    }

    /// A new list with `f` applied to each element and the resulting lists
    /// concatenated flat, in order.
    ///
    /// ```thera
    /// [1, 2, 3].flat_map(n => [n, n * 10])   // [1, 10, 2, 20, 3, 30]
    /// ```
    pub fn flat_map<U>(self, f: (T) -> List<U>) -> List<U> {
        let result = [];
        for item in self {
            result.extend(f(item));
        }
        return result;
    }

    /// Reduce the list to a single value: start from `initial` and fold each
    /// element in with `combine`, left to right.
    ///
    /// ```thera
    /// let sum = [1, 2, 3].fold(0, (acc, n) => acc + n);   // 6
    /// ```
    pub fn fold<A>(self, initial: A, combine: (A, T) -> A) -> A {
        let mut acc = initial;
        for item in self {
            acc = combine(acc, item);
        }
        return acc;
    }

    /// A new list of the elements in the half-open range `[start, end)`. Indices
    /// are clamped to the list's bounds, so out-of-range or reversed ranges yield a
    /// shorter or empty list rather than an error.
    ///
    /// ```thera
    /// [10, 20, 30, 40].slice(1, 3)   // [20, 30]
    /// ```
    pub fn slice(self, start: Int, end: Int) -> List<T> {
        let lo = start.clamp(0, self.len());
        let hi = end.clamp(0, self.len());
        let result = [];
        let mut i = lo;
        while i < hi {
            result.push(self[i]);
            i = i + 1;
        }
        return result;
    }
}

impl Debug for List<T> {
    /// `[a, b, c]` — each element rendered via `Debug`, so nested strings are
    /// quoted (`["a", "b"]`), matching mainstream collection printing. (Empty list:
    /// `[]`.)
    fn debug(self) -> String {
        let mut s = '[';
        let mut first = true;
        for item in self {
            if !first {
                s = s + ', ';
            }
            s = s + item.debug();
            first = false;
        }
        return s + ']';
    }
}

/// A list's display form *is* its developer form — the structural `Debug` rendering
/// is canonical (there is no prettier user-facing shape; the Python
/// `str`-delegates-to-`repr` convention for containers).
impl Display for List<T> {
    fn to_string(self) -> String {
        return self.debug();
    }
}
