// Support library: a directory library whose sibling files import each other
// (the legal-cycle fixture for `import_cycle_sibling_ok`).

pub import 'even_side';
pub import 'odd_side';

pub fn describe(n: Int) -> String {
    if odd_side.is_odd(n) {
        return 'odd:${n}';
    }
    return 'even:${n}';
}
