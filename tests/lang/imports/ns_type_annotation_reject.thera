//! spec: mod-ns-file-local
//! mode: check

// The type-position half of file-local namespaces: a type annotation's (or
// construction's) qualifier must be a namespace this file imports. An unknown
// qualifier is the error itself, reported once at the annotation — the type
// resolves as Unknown, so no downstream same-name mismatch cascades — with a
// qualify-as hint when an import does expose the type.

import 'provider';

fn hinted(_ g: bogus.Gadget) -> Int {   // expect error: unknown namespace: bogus; `Gadget` is exposed by `provider`
    return g.n;
}

fn unhinted(_ x: nowhere.Missing) -> Int {   // expect error: unknown namespace: nowhere
    return 0;
}

fn main() -> Int {
    let g = provider.Gadget { n: 3 };
    return hinted(g) + unhinted(0);
}
