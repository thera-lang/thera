//! spec: fn-named-params
//! mode: run

fn greet(name: String, times: Int) -> String {
    return '${name} x${times}';
}

// A label is simply the parameter's name — there is no separate external label.
// `default` is not a reserved word, so it serves as both.
fn flag(_ name: String, default: Bool) -> Bool {
    return default;
}

fn main() -> Int {
    println(greet(name: 'a', times: 3));   // expect: a x3
    let f = flag('-v', default: true);
    println('${f}');                        // expect: true
    return 0;
}
