//! spec: fn-default-params
//! mode: run
//! xfail: a default parameter value is resolved in the caller's scope, so one naming a declaring-file const or import fails to compile (docs/roadmap.md → Compiler & front-end)

// A default parameter value is written in the callee's file, so its names must
// resolve there. Today the expression is copied into the *caller's* unit and
// resolved against that file's scope, so a default naming anything the caller
// cannot see fails — `undefined name: LOCAL_PAD` for the const, `field access on
// non-struct value` for the import. Passing the argument explicitly is fine, as
// is defaulting it from inside `defaultlib` itself.
//
// `thera check` accepts this program; only `emit` rejects it, so the two
// disagree — closing that gap is part of the fix.

import 'defaultlib';

fn main() -> Int {
    println('${defaultlib.padded(1)}');           // expect: 8
    println('${defaultlib.padded(1, pad: 100)}'); // expect: 101
    println('${defaultlib.scaled(2)}');           // expect: 6
    return 0;
}
