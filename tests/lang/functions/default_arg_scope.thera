//! spec: fn-default-params
//! mode: run

// A default parameter value is written in the callee's file, so its names
// resolve *there* — a file-local const, a member of an import only that file
// has — even though the value is materialized at each call site. The caller
// needs no access to either name.
//
// `thera check` sees the same program: the default is checked once, at the
// declaration, in the file that wrote it.

import 'defaultlib';

fn main() -> Int {
    println('${defaultlib.padded(1)}');           // expect: 8
    println('${defaultlib.padded(1, pad: 100)}'); // expect: 101
    println('${defaultlib.scaled(2)}');           // expect: 6
    return 0;
}
