//! spec: fn-default-params
//! mode: run

// The composite: a default parameter value needs **two contexts at once**. Its
// names resolve in the declaring file (`tag` lives in `defaultlib`), while a
// `#loc` inside it stamps the *call* site — that is what gives `std.testing`
// assertions the failing test's location.
//
// So neither extreme works: resolving the whole default in the caller's scope
// loses `tag`, and hoisting the default into a thunk compiled in `defaultlib`
// would make `#loc` report `defaultlib.thera`. Codegen resolves names at the
// declaration and keeps expanding the default per call site.

import 'defaultlib';

fn main() -> Int {
    let a = defaultlib.caller_line();
    let b = defaultlib.caller_line();
    println('${b == a + 1}');   // expect: true
    return 0;
}
