//! spec: fn-decl
//! mode: run

fn add(named a: Int, named b: Int) -> Int {
    return a + b;
}

// No return type annotation — defaults to Void.
fn log(msg: String) {
    println(msg);
}

fn main() -> Int {
    println('${add(a: 2, b: 3)}');   // expect: 5
    log('logged');             // expect: logged
    return 0;
}
