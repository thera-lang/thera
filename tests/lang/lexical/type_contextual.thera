//! spec: lex-type-contextual
//! mode: run

// `type` is a contextual keyword: an ordinary identifier usable as a field,
// parameter, label, or local — a reserved word in any of those positions is an
// error. Only `native type` gives it meaning.
struct Block {
    let type: String;
}

fn describe(type: String) -> String {
    return 'kind=${type}';
}

fn labeled(_ type: String) -> String {
    return 'label=${type}';
}

fn main() -> Int {
    let type = 'text';
    let b = Block { type: type };
    println(b.type);                     // expect: text
    println(describe(type: 'tool_use')); // expect: kind=tool_use
    println(labeled('thinking'));        // expect: label=thinking
    let f = (type: String) => type.len();
    println('${f('abc')}');              // expect: 3
    return 0;
}
