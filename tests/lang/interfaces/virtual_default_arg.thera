//! spec: fn-default-params
//! mode: run

// A dynamically dispatched call fills in parameter defaults from the
// *interface's* declared signature — the static type governs, as at every
// statically resolved call site. Both the direct call and the call through
// the interface-typed parameter fill the omitted `punct`.

interface Greeter {
    fn greet(self, punct: String = '!') -> String;
}

struct Person {
    let name: String;
}

impl Greeter for Person {
    fn greet(self, punct: String = '!') -> String {
        return self.name + punct;
    }
}

fn show(_ g: Greeter) -> Void {
    println(g.greet());
}

fn main() -> Int {
    let p = Person { name: 'hi' };
    println(p.greet());   // expect: hi!
    show(p);              // expect: hi!
    println(p.greet('?')); // expect: hi?
    return 0;
}
