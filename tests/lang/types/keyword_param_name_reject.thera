//! spec: name-keyword-members
//! mode: check

// A parameter name may not be a keyword: it is read bare in the body, where a
// keyword cannot appear. With the two-name form retired there is no label slot
// to escape into, so the error prescribes the two real ways out.
fn f(match: Int) -> Int {   // expect error: a parameter name cannot be a keyword
    return 1;
}

fn main() -> Int {
    return f(match: 2);
}
