//! spec: name-keyword-members
//! mode: run

// Member positions are grammatically closed, so any keyword is an ordinary
// name there: field declarations, struct-literal fields, `.` access,
// call-site labels, and parameter labels.
struct Param {
    let in: String;
    let enum: List<String>;
    let mut: Bool;
    let mut match: Int;   // `mut` modifier + a field named `match`
}

struct Links {
    let self: String;
}

fn find(in loc: String, if cond: Bool) -> String {
    return if cond { loc } else { 'none' };
}

fn main() -> Int {
    let p = Param { in: 'query', enum: ['a', 'b'], mut: true, match: 7 };
    println(p.in);                       // expect: query
    println('${p.enum.len()}');          // expect: 2
    println('${p.mut}');                 // expect: true
    p.match = p.match + 1;
    println('${p.match}');               // expect: 8
    let l = Links { self: 'https://example.com' };
    println(l.self);                     // expect: https://example.com
    println(find(in: 'path', if: true)); // expect: path
    println('${p.in.len()}');            // expect: 5
    return 0;
}
