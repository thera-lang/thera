// The analysis session — the one engine every front-end consumer drives
// (docs/roadmap.md layer 1; audit LD16). It owns the state the stateless pipeline
// phases share across requests: the SDK root, open-buffer overlays, the cross-file
// parse cache, and the checked-clean set. Batch commands
// (`thera check`/`test`/`emit`) construct one per run; the LSP holds one for the
// workspace and mutates it on document events. There is no second stateless path to
// keep in sync — the driver's entry points are thin wrappers over a one-shot
// session. Phase 2's incremental engine (a resolved-library cache +
// dependency-graph invalidation over `LoadedImports.file_imports`) grows here.

import 'ast/ast' as _; // Program, Decl
import 'source' as _; // SourceSpan (the digest's decl-text fallback)
import 'lexer/lexer'; // tokenize; Token — the primary's cached tokenization rides on Closure
import 'parser/parser';
import 'checker/checker';
import 'codegen/codegen';
import 'bytecode/encoder';
import 'element';
import 'loader';
import 'diagnostic'; // Diagnostic — the uniform phase error, produced by every phase
import 'doc_check'; // check_file — doc examples, checked beside the file that holds them

import std.path;

// The most distinct closure signatures the imports-only library cache retains
// before evicting the least-recently-used entry. Sized to comfortably exceed the
// distinct import-sets of a real project (files sharing imports share a signature),
// so workspace-wide analysis effectively never evicts; a size-aware policy can
// refine this later.
const LIBRARY_CACHE_CAP: Int = 1024;

// The outcome of compiling a source: any diagnostics, and the encoded `.thera-bc`
// bytes when there were none.
pub struct CompileOutcome {
    let diagnostics: List<diagnostic.Diagnostic>;
    let bytes: Option<Bytes>;
}

// A parsed primary program plus its loaded import closure — what position-based LSP
// queries consume (the resolution surfaces ride on `loaded`). `tokens` is the
// primary's cached tokenization (from the same parse as `program`), carried so the
// resolver reads it instead of re-lexing the buffer per request.
pub struct Closure {
    let program: Program;
    let tokens: List<lexer.Token>;
    let loaded: loader.LoadedImports;
}

pub struct Session {
    let sdk_root: Option<String>;
    // Canonical path -> current text: open-buffer overlays over disk, consulted by
    // the loader before reading a file (an unsaved import is analyzed as the user
    // sees it).
    let overlays: Map<String, String>;
    // Canonical path -> parsed AST, reused across requests so the import closure
    // (the `std.core` prelude above all) is parsed once and only re-parsed when its
    // file changes.
    let parse_cache: Map<String, loader.ParsedFile>;
    // Canonical keys of closure files that already checked clean this session —
    // skipped on later checks, so a batch (or a keystroke) costs the changed files,
    // not the whole closure. Files with diagnostics are never marked.
    let checked: Set<String>;
    // The merged forward import graph across every closure this session has loaded:
    // canonical key -> that file's last-known resolved import edges
    // (`LoadedImports.file_imports`, replaced entry-wise per load). Reversed on
    // demand by `dependents_of`, the invalidation cone for an edit.
    let import_graph: Map<String, List<String>>;
    // Canonical path -> the file's derived surfaces (`loader.FileSurface`) — reused
    // across requests so a load re-derives only changed files' surfaces. Evicted
    // over the invalidation cone: a file's surfaces depend on its imports' surfaces
    // (and, for `bare_surface`, on the prelude — the SDK invalidate-all rule covers
    // that implicit edge). Like the parse cache, only overlay events invalidate —
    // out-of-band disk edits are invisible to a long-lived session.
    let surface_cache: Map<String, loader.FileSurface>;
    // Closure signature (sorted member keys) -> the imports-only element model,
    // reused across requests so a keystroke re-resolves the primary, not the whole
    // closure (`element.layer_primary` stacks the primary on the cached base
    // without mutating it — the frozen-base invariant). Evicted when any member is
    // invalidated.
    let library_cache: Map<String, CachedLibrary>;
    // Canonical path -> the file's committed-type record from the last check that
    // walked it (CH19), serving `type_at`/`records_for`. As fresh as that check:
    // evicted over the invalidation cone with `checked`; files the checker skipped
    // (the SDK, files already clean before records existed) have no entry.
    let type_records: Map<String, List<element.TypeRecord>>;
}

// One cached imports-only library plus its member set (for eviction: an entry dies
// when any member file is invalidated).
pub struct CachedLibrary {
    let members: Set<String>;
    let library: element.LibraryElement;
}

pub fn new_session(sdk_root: Option<String>) -> Session {
    return Session {
        sdk_root: sdk_root,
        overlays: [:],
        parse_cache: [:],
        checked: Set.new(),
        import_graph: [:],
        surface_cache: [:],
        library_cache: [:],
        type_records: [:],
    };
}

impl Session {
    // Set (or update) the overlay text for `p` — the open-buffer content the loader
    // reads instead of disk.
    //
    // **The surface-digest gate** (scale.md item 2): the new text is parsed here
    // (not an extra parse — the result seeds the parse cache the next analysis
    // would fill anyway) and its printed public surface compared to the cached
    // parse's. A **surface-preserving edit** — the overwhelming case for agent
    // edits: bodies, comments, private decls — invalidates only this file and its
    // white-box test sibling; importers' checked status stays valid, so a body edit
    // costs one file's re-check, not the dependent cone's. A surface *change* (or
    // either side failing to parse cleanly — mid-edit states stay conservative)
    // falls back to the full cone eviction below.
    pub fn set_overlay(self, p: String, text: String) -> Void {
        let key = loader.canonical_path(p);
        let old_sig = match self.parse_cache.get(key) {
            Some(pf) => {
                if pf.diagnostics.len() == 0 {
                    Option.Some(surface_signature(pf.program))
                } else {
                    Option.None
                }
            },
            None => Option.None,
        };
        self.overlays[key] = text;
        let pf = loader.parse_source(key, text);
        let unchanged = match old_sig {
            Some(old) => pf.diagnostics.len() == 0 && surface_signature(pf.program) == old,
            None => false,
        };
        if unchanged {
            self.invalidate_file(key);
        } else {
            self.invalidate(p);
        }
        self.parse_cache[key] = pf;
    }

    // Drop `p`'s overlay (closed buffer): analyses revert to disk content.
    pub fn remove_overlay(self, p: String) -> Void {
        match self.overlays.remove(loader.canonical_path(p)) {
            Some(_) => void,
            None => void,
        }
        self.invalidate(p);
    }

    // Evict `p` from the cross-request caches (a no-op when absent). Only `p`'s own
    // text changed, so importers keep their parses — but their checked-clean status
    // is stale (they checked against `p`'s old content), so the eviction cascades
    // over the invalidation cone. This closes the stale-`checked` gap: an edit to
    // `util.thera` re-checks its importers on their next check, not just
    // `util.thera` itself.
    pub fn invalidate(self, p: String) -> Void {
        let key = loader.canonical_path(p);
        match self.parse_cache.remove(key) {
            Some(_) => void,
            None => void,
        }
        // The edit may have changed `p`'s own imports, so its forward edges are
        // stale — drop them so `index_edges` (or the next closure load) re-probes.
        // Only `p`'s own edges can change; importers' edges still point at `p`.
        match self.import_graph.remove(key) {
            Some(_) => void,
            None => void,
        }
        for k in self.dependents_of(key) {
            self.checked.remove(k);
            match self.surface_cache.remove(k) {
                Some(_) => void,
                None => void,
            }
            match self.type_records.remove(k) {
                Some(_) => void,
                None => void,
            }
            self.evict_libraries_with(k);
        }
    }

    // The narrow eviction for a surface-preserving edit: `key`'s own caches, its
    // forward edges (the edit may have changed its imports), and its white-box test
    // sibling — `<base>_test.thera` sees `key`'s *private* top-level names, which
    // the surface digest deliberately excludes. Importers' checked status survives
    // (their view of `key` is its public surface, unchanged by definition here).
    // Cached library bases containing `key` are still evicted: they hold `key`'s
    // old AST, and keeping them would serve stale spans to position tooling
    // (go-to-definition into the edited file). Removing *that* rebuild cost is item
    // 2's per-library composition arc, not this gate's job.
    fn invalidate_file(self, key: String) -> Void {
        match self.import_graph.remove(key) {
            Some(_) => void,
            None => void,
        }
        for k in [key, test_sibling_of(key)] {
            self.checked.remove(k);
            match self.surface_cache.remove(k) {
                Some(_) => void,
                None => void,
            }
            match self.type_records.remove(k) {
                Some(_) => void,
                None => void,
            }
        }
        self.evict_libraries_with(key);
        return;
    }

    // Drop the least-recently-used cached library — the front entry, since a hit
    // moves its signature to the back (see `library_for`). Bounds the cache without
    // the old clear-all, which threw away every warm base at once.
    fn evict_lru_library(self) -> Void {
        let keys = self.library_cache.keys();
        if keys.len() > 0 {
            match self.library_cache.remove(keys[0]) {
                Some(_) => void,
                None => void,
            }
        }
    }

    // Drop every cached imports-only library whose closure contains `k`.
    fn evict_libraries_with(self, k: String) -> Void {
        let stale: List<String> = [];
        for sig in self.library_cache.keys() {
            if self.library_cache[sig].members.contains(k) {
                stale.push(sig);
            }
        }
        for sig in stale {
            match self.library_cache.remove(sig) {
                Some(_) => void,
                None => void,
            }
        }
    }

    // The element model for this request through the library cache: the
    // imports-only base — cache-hit by closure signature, else built and stored —
    // with the primary layered on top. None when the layered path can't serve the
    // request (the primary appears in its own import closure: an SDK file checked
    // as the primary, or an import cycle through the root; or a primary `impl`
    // targets a type the primary doesn't declare) — the caller then runs the full
    // uncached build.
    fn library_for(
        self,
        program: Program,
        canon: String,
        loaded: loader.LoadedImports,
    ) -> Option<element.LibraryElement> {
        let keys: List<String> = [];
        for p in loaded.programs {
            let k = element.file_key(p.file_path);
            if k == canon {
                return Option.None; // the primary is in its own closure
            }
            keys.push(k);
        }
        for f in loaded.file_imports.keys() {
            if loaded.file_imports[f].contains(canon) {
                return Option.None; // an import references the primary
            }
        }
        let signature = keys.sorted_by((a, b) => a.compare(b) == Ordering.Less).join('\n');
        let base = match self.library_cache.get(signature) {
            Some(c) => {
                // Mark as most-recently-used: the map is insertion-ordered, so
                // remove + re-insert moves this signature to the end (`evict_lru`
                // drops the front). No rebuild — the frozen base is reused as-is.
                self.library_cache.remove(signature);
                self.library_cache[signature] = c;
                c.library
            },
            None => {
                // Bound the cache with LRU eviction (not clear-all): workspace-wide
                // analysis holds one signature per distinct import-set, so the cap
                // is high enough not to bite most projects — a real project rarely
                // has this many distinct closures. A smarter size-aware policy is a
                // follow-up.
                if self.library_cache.len() >= LIBRARY_CACHE_CAP {
                    self.evict_lru_library();
                }
                let built = element.build_import_library(
                    loaded.programs,
                    loaded.file_namespaces,
                    loaded.file_bare_surface,
                );
                let members: Set<String> = Set.new();
                for k in keys {
                    members.add(k);
                }
                self.library_cache[signature] = CachedLibrary { members: members, library: built };
                built
            },
        };
        return element.layer_primary(
            base,
            program,
            loaded.file_namespaces,
            loaded.file_bare_surface,
        );
    }

    // `p` (canonicalized) plus every file that transitively imports it, per the
    // session's merged import graph — the invalidation cone for an edit to `p`.
    // Conservative: the graph's edges are unlabeled (no pub/non-pub distinction),
    // so any import path counts — over-eviction only. A key under the SDK's std
    // root returns every known file: each file's bare surface implicitly depends on
    // the std.core prelude, and that implicit edge isn't in the graph.
    pub fn dependents_of(self, p: String) -> List<String> {
        let key = loader.canonical_path(p);
        if let Some(prefix) = sdk_prefix(self.sdk_root) {
            if key.starts_with(prefix) {
                let all = self.import_graph.keys();
                if !all.contains(key) {
                    all.push(key);
                }
                return all;
            }
        }
        // Reverse adjacency, rebuilt per call: edits are rare next to loads, and
        // rebuilding sidesteps the bookkeeping when a file's edge list is replaced
        // wholesale.
        let importers_of: Map<String, List<String>> = [:];
        for importer in self.import_graph.keys() {
            for dep in self.import_graph[importer] {
                if !importers_of.has(dep) {
                    importers_of[dep] = [];
                }
                if let Some(list) = importers_of.get(dep) {
                    list.push(importer);
                }
            }
        }
        let seen: Set<String> = Set.new();
        seen.add(key);
        let cone: List<String> = [key];
        let mut i = 0;
        while i < cone.len() {
            if let Some(importers) = importers_of.get(cone[i]) {
                for f in importers {
                    if !seen.contains(f) {
                        seen.add(f);
                        cone.push(f);
                    }
                }
            }
            i = i + 1;
        }
        return cone;
    }

    // Whether `p` is a file under the SDK's std root — a trusted library source
    // reached by `import std.*`. Such files are read-only to editing tools (rename
    // skips them, and refuses a rename whose declaration lives in one), matching
    // how the checker already trusts and skips them.
    pub fn is_sdk_file(self, p: String) -> Bool {
        return match sdk_prefix(self.sdk_root) {
            Some(prefix) => loader.canonical_path(p).starts_with(prefix),
            None => false,
        };
    }

    // Record the forward import edges of every file in `files` the graph doesn't
    // already know — the cheap edges-only probe (`loader.import_edges`), not a full
    // closure load. The references/rename cone (`dependents_of`) reverses this
    // graph, so it must cover the whole scan set to be complete; this fills the
    // gaps for files never loaded (or edited since — `invalidate` drops their
    // entry) so a cold reference request doesn't miss an unopened importer. `files`
    // maps canonical path -> current text (an open buffer's overlay or the on-disk
    // contents). Already-known files are skipped, so a warm request does no work
    // here. The probed parse populates the parse cache, so the cone files that go
    // on to resolve reuse it (no re-parse).
    pub fn index_edges(self, files: Map<String, String>) -> Void {
        for key in files.keys() {
            if !self.import_graph.has(key) {
                let pf = self.parsed_primary(key, files.get(key).unwrap_or(''));
                self.import_graph[key] = loader.import_edges(key, pf.program, self.sdk_root);
            }
        }
    }

    // Merge one load's dependency edges into the session graph (entry-wise replace:
    // the load's view of a file's imports is current).
    fn record_graph(self, loaded: loader.LoadedImports) -> Void {
        for f in loaded.file_imports.keys() {
            self.import_graph[f] = loaded.file_imports[f];
        }
    }

    // Force `p` to be re-checked by the next `check` even if unedited (the LSP
    // re-publishes an open document's diagnostics on demand; its overlay text is
    // the request's input, never a cached result).
    pub fn force_recheck(self, p: String) -> Void {
        self.checked.remove(loader.canonical_path(p));
    }

    // The cached syntactic parse of `text` at `p` — the entry point for the
    // parse-only consumers (document symbols, code actions, workspace symbols).
    // Cached under the canonical key; an edit must `invalidate`/`set_overlay` first
    // (the LSP does, on every document event), so a hit is current.
    pub fn parse(self, text: String, p: String) -> Program {
        return self.parsed_primary(loader.canonical_path(p), text).program;
    }

    // The primary's cached parse (`canon` must be canonical): a hit returns the
    // session's entry — evicted on every overlay event — and a miss parses `source`
    // best-effort, lex and parse diagnostics riding on the `ParsedFile` exactly as
    // imported files behave via the loader, then stores it for the closure loads
    // that follow.
    fn parsed_primary(self, canon: String, source: String) -> loader.ParsedFile {
        if let Some(pf) = self.parse_cache.get(canon) {
            return pf;
        }
        let pf = loader.parse_source(canon, source);
        self.parse_cache[canon] = pf;
        return pf;
    }

    // Parse `text` at `p` and load its import closure through the session's caches
    // and overlays — the shared setup for the LSP's position-based queries (hover,
    // definition).
    pub fn load_closure(self, text: String, p: String) -> Closure {
        let pf = self.parsed_primary(loader.canonical_path(p), text);
        let loaded = loader.load_imports(
            p,
            pf.program,
            self.sdk_root,
            parse_cache: self.parse_cache,
            overlays: self.overlays,
            surface_cache: self.surface_cache,
        );
        self.record_graph(loaded);
        return Closure { program: pf.program, tokens: pf.tokens, loaded: loaded };
    }

    // Type-check `source` (located at `p`) with its full import closure. The whole
    // *local* closure is checked, not just the primary: a check error in an
    // imported file is a diagnostic (attributed to that file) rather than shipping
    // to bytecode. Files under the SDK's std root are trusted (the SDK is
    // fixpoint-validated; its diagnostics aren't actionable here) and skipped, as
    // is everything already checked clean this session.
    pub fn check(self, source: String, p: String) -> List<diagnostic.Diagnostic> {
        // Canonical identity from the start, so the primary's attribution matches
        // the keys the loader mints (`Diagnostic.file` is canonical). The parse
        // comes through the cache (R1): a keystroke's diagnostics request reuses
        // the parse the position queries already made.
        let canon = loader.canonical_path(p);
        let pf = self.parsed_primary(canon, source);
        let program = pf.program;
        let loaded = loader.load_imports(
            canon,
            program,
            self.sdk_root,
            parse_cache: self.parse_cache,
            overlays: self.overlays,
            surface_cache: self.surface_cache,
        );
        self.record_graph(loaded);
        let skip = skip_keys(canon, loaded.programs, self.sdk_root, self.checked);
        // Lex/parse errors from imported files first (root causes) — minus files
        // already reported this run — then the closure's check errors.
        let out: List<diagnostic.Diagnostic> = [];
        for d in loaded.diagnostics {
            if !d.file.map((f) => self.checked.contains(f)).unwrap_or(false) {
                out.push(d);
            }
        }
        let result = checker.check_files(
            program,
            loaded.programs,
            loaded.file_namespaces,
            loaded.file_bare_surface,
            skip: skip,
            prebuilt: self.library_for(program, canon, loaded),
        );
        for d in result.errors {
            out.push(d);
        }
        self.store_records(result.records);
        // A primary that failed to lex/parse still went through the full pipeline
        // above: the parser's recovered tree keeps the committed-type records
        // fresh, so the position queries (`type_at`, completion) answer mid-edit.
        // Only its lex/parse diagnostics are *reported*, though — a statement
        // recovery dropped would cascade into secondary errors (`undefined name`)
        // after the root cause (roadmap: cascade suppression / cause-naming).
        // Marking still sees the full set, so a clean import checks as clean and
        // the broken primary never does.
        if pf.diagnostics.len() > 0 {
            let all: List<diagnostic.Diagnostic> = [];
            for d in pf.diagnostics {
                all.push(d);
            }
            for d in out {
                all.push(d);
            }
            mark_checked_clean(self.checked, canon, loaded.programs, skip, all);
            return pf.diagnostics;
        }
        mark_checked_clean(self.checked, canon, loaded.programs, skip, out);
        return out;
    }

    // Compile-check the doc examples in `source` (located at `p`), as `doc-example`
    // warnings (see doc_check.thera).
    //
    // Deliberately *not* folded into `check`, on two counts. **Scope:** `check`
    // walks the import closure to type-check, but doc examples are extracted only
    // from the files a command was pointed at — your dependency's documentation is
    // not your diagnostic, and a caller who cannot see the difference would report
    // the whole SDK's doc comments against a two-line program. **State:** this pass
    // writes nothing back. It borrows the session's caches, so the closure is
    // parsed once for a whole run rather than once per example, and leaves them as
    // it found them; going through `check` instead would put a phantom synthetic
    // file in the parse cache and the import graph.
    pub fn check_doc_examples(self, source: String, p: String) -> List<diagnostic.Diagnostic> {
        return doc_check.check_file(
            p,
            source,
            self.sdk_root,
            parse_cache: self.parse_cache,
            overlays: self.overlays,
            surface_cache: self.surface_cache,
        );
    }

    // Compile `source` (located at `p`) to `.thera-bc` bytes with its import
    // closure linked in. Like `check`, the whole local (non-SDK) closure is checked
    // — an imported file's check error blocks the compile instead of shipping to
    // bytecode.
    pub fn compile(self, source: String, p: String) -> CompileOutcome {
        let canon = loader.canonical_path(p);
        let pf = self.parsed_primary(canon, source);
        if pf.diagnostics.len() > 0 {
            return failed(pf.diagnostics);
        }
        let program = pf.program;
        let loaded = loader.load_imports(
            canon,
            program,
            self.sdk_root,
            parse_cache: self.parse_cache,
            overlays: self.overlays,
            surface_cache: self.surface_cache,
        );
        self.record_graph(loaded);
        let skip = skip_keys(canon, loaded.programs, self.sdk_root, self.checked);
        // An imported file that failed to lex/parse/resolve leaves the closure
        // incomplete, so its diagnostics (root causes) block codegen alongside any
        // check errors.
        let import_diags = loaded.diagnostics;
        let result = checker.check_files(
            program,
            loaded.programs,
            loaded.file_namespaces,
            loaded.file_bare_surface,
            skip: skip,
            prebuilt: self.library_for(program, canon, loaded),
        );
        self.store_records(result.records);
        // Warnings ride the same list but don't gate compilation — only
        // error-severity diagnostics (and import-closure failures) block.
        if import_diags.len() > 0 || diagnostic.error_count(result.errors) > 0 {
            for d in result.errors {
                import_diags.push(d);
            }
            return failed(import_diags);
        }
        mark_checked_clean(self.checked, canon, loaded.programs, skip, []);
        let cg = codegen.compile_program(
            program,
            loaded.programs,
            loaded.file_namespaces,
            loaded.file_bare_surface,
        );
        if cg.errors.len() > 0 {
            return failed(cg.errors);
        }
        return CompileOutcome {
            diagnostics: [],
            bytes: Option.Some(encoder.encode_module(cg.module)),
        };
    }

    // Fold a check run's committed-type records into the per-file store: group by
    // file, then replace those files' entries wholesale (files the checker skipped
    // don't appear and keep their stored records).
    fn store_records(self, records: List<element.TypeRecord>) -> Void {
        let by_file: Map<String, List<element.TypeRecord>> = [:];
        for r in records {
            match by_file.get(r.file) {
                Some(l) => { l.push(r); },
                None => { by_file[r.file] = [r]; },
            }
        }
        for f in by_file.keys() {
            self.type_records[f] = by_file[f];
        }
    }

    // The committed-type record for `p` from the last check that walked it —
    // checking on demand when `p` is an open overlay with no stored records (the
    // post-edit LSP case). Entries are in walk order; a later entry for the same
    // span supersedes an earlier one (the `let` refinement override).
    pub fn records_for(self, p: String) -> List<element.TypeRecord> {
        let canon = loader.canonical_path(p);
        if !self.type_records.has(canon) {
            if let Some(text) = self.overlays.get(canon) {
                self.check(text, canon);
            }
        }
        return self.type_records.get(canon).unwrap_or([]);
    }

    // The committed type of the node at `offset` in `p` — the smallest recorded
    // span containing the offset (ties go to the later entry, so the refinement
    // override wins). None when the offset sits outside any recorded node or the
    // file has no records (never walked, or evicted).
    pub fn type_at(self, p: String, offset: Int) -> Option<element.Type> {
        let mut best: Option<element.Type> = Option.None;
        let mut best_len = 0;
        for r in self.records_for(p) {
            if offset >= r.offset && offset < r.offset + r.length {
                if best.is_none() || r.length <= best_len {
                    best = Option.Some(r.ty);
                    best_len = r.length;
                }
            }
        }
        return best;
    }
}

// --- the hermetic (no-import) pipeline, for self-contained programs ---

// Type-check `source` with no import closure (no prelude, no loader) —
// self-contained test fixtures. Lex and parse errors short-circuit.
pub fn check_source(source: String) -> List<diagnostic.Diagnostic> {
    let lex = lexer.tokenize(source);
    if lex.errors.len() > 0 {
        return lex.errors;
    }
    let parsed = parser.parse_tokens(lex.tokens);
    if parsed.errors.len() > 0 {
        return parsed.errors;
    }
    return checker.check(parsed.program, [], [:], [:]).errors;
}

// Compile `source` to `.thera-bc` bytes with no import closure. Each phase
// short-circuits on errors, so `bytes` is present only for a clean program.
pub fn compile_source(source: String) -> CompileOutcome {
    let lex = lexer.tokenize(source);
    if lex.errors.len() > 0 {
        return failed(lex.errors);
    }
    let parsed = parser.parse_tokens(lex.tokens);
    if parsed.errors.len() > 0 {
        return failed(parsed.errors);
    }
    let checked = checker.check(parsed.program, [], [:], [:]);
    if diagnostic.error_count(checked.errors) > 0 {
        return failed(checked.errors);
    }
    let cg = codegen.compile_program(parsed.program, [], [:], [:]);
    if cg.errors.len() > 0 {
        return failed(cg.errors);
    }
    return CompileOutcome {
        diagnostics: [],
        bytes: Option.Some(encoder.encode_module(cg.module)),
    };
}

// `file:line:column: message` — the diagnostic line the CLI prints. Attribution
// (`d.file`) is canonical (absolute); printing shows the primary file exactly as
// the user spelled it (`file_path`, the compiler convention), and any other
// attributed file relative to the current directory when it lies under it. An error
// line carries no severity token (the default reading); a warning is tagged
// `warning:` and closes with its rule name — the key a `// ignore: <rule>` comment
// names to suppress it.
pub fn format_diagnostic(d: diagnostic.Diagnostic, file_path: String) -> String {
    let file = match d.file {
        Some(f) => {
            if f == loader.canonical_path(file_path) {
                file_path
            } else {
                loader.display_path(f)
            }
        },
        None => file_path,
    };
    let tag = match d.severity {
        Warning => 'warning: ',
        _ => '',
    };
    let rule = match d.rule {
        Some(r) => ' (${r})',
        None => '',
    };
    return '${file}:${d.span}: ${tag}${d.message}${rule}';
}

// --- helpers ---

fn failed(diagnostics: List<diagnostic.Diagnostic>) -> CompileOutcome {
    return CompileOutcome { diagnostics: diagnostics, bytes: Option.None };
}

// The closure files to skip when checking: everything under the SDK's std root
// (trusted — fixpoint-validated, and its diagnostics aren't actionable from a user
// program) plus everything already checked clean this run. The primary — the file
// explicitly asked about — is exempt from the SDK skip (checking an SDK file
// directly must still check it), but not from `checked`.
fn skip_keys(
    primary_key: String,
    programs: List<Program>,
    sdk_root: Option<String>,
    checked: Set<String>,
) -> Set<String> {
    let skip: Set<String> = Set.new();
    if let Some(prefix) = sdk_prefix(sdk_root) {
        for p in programs {
            // A path-less program has no key to skip by (never `''` — the
            // canonical-key discipline, LD17).
            if let Some(key) = p.file_path {
                if key.starts_with(prefix) && key != primary_key {
                    skip.add(key);
                }
            }
        }
    }
    for key in checked.to_list() {
        skip.add(key);
    }
    return skip;
}

// The canonical `<std root>/` prefix SDK file keys carry, if there is an SDK.
fn sdk_prefix(sdk_root: Option<String>) -> Option<String> {
    return match sdk_root {
        Some(root) => loader.std_root(root).map((std) => loader.canonical_path(std) + '/'),
        None => Option.None,
    };
}

// Record which closure files checked *clean* this run: every non-skipped file with
// no diagnostic attributed to it (an unattributed diagnostic is the primary's,
// conservatively). Skipped files keep their existing state.
fn mark_checked_clean(
    checked: Set<String>,
    primary_key: String,
    programs: List<Program>,
    skip: Set<String>,
    diags: List<diagnostic.Diagnostic>,
) -> Void {
    let error_files: Set<String> = Set.new();
    let mut primary_dirty = false;
    for d in diags {
        match d.file {
            Some(f) => { error_files.add(f); },
            None => { primary_dirty = true; },
        }
    }
    if !primary_dirty && !error_files.contains(primary_key) && !skip.contains(primary_key) {
        checked.add(primary_key);
    }
    for p in programs {
        if let Some(key) = p.file_path {
            if !skip.contains(key) && !error_files.contains(key) {
                checked.add(key);
            }
        }
    }
    return;
}

// --- the surface digest (scale.md item 2) ---

// `foo.thera` -> its white-box sibling `foo_test.thera`, in the same directory.
// (For a `_test` file this yields a `_test_test` name that exists nowhere — the
// evictions against it are no-ops.)
fn test_sibling_of(key: String) -> String {
    let dir = path.dirname(key);
    let seg = path.basename(key);
    let ext = '.thera';
    let base = if seg.ends_with(ext) { seg.slice(0, seg.len() - ext.len()) } else { seg };
    return '${dir}/${base}_test${ext}';
}

// The file's public surface, printed canonically — what the overlay gate compares.
// Everything an *importer's* check can observe is included: pub fn/interface
// signatures, pub type/enum shapes (fields and variants are public), pub const/let
// annotations, impl headers plus pub method signatures (conformance is cross-file
// even though `impl` carries no `pub`), and pub imports (re-exports). Bodies are
// excluded on purpose, and soundly: return types are always written (omitted means
// Void, never inferred), and a module-level binding is an annotated boundary — so a
// body can't leak into an importer-visible type. The one exception is an
// *unannotated* const/let, whose type comes from its initializer: those contribute
// their whole decl text, so an initializer edit reads as a surface change
// (conservative). Private decls are excluded: only the white-box test sibling sees
// them, and `invalidate_file` evicts that sibling unconditionally.
fn surface_signature(p: Program) -> String {
    let lines: List<String> = [];
    for decl in p.decls {
        match decl {
            Fn(x) => {
                if x.is_pub {
                    lines.push('fn ${fn_sig(x)}');
                }
            },
            Type(x) => {
                if x.is_pub {
                    let fields = x.fields.map((f) => field_sig(f));
                    lines.push(
                        'type ${x.name}${type_params_sig(x.type_params)} { ${fields.join('; ')} }'
                    );
                }
            },
            Enum(x) => {
                if x.is_pub {
                    let vs = x.variants.map((v) => variant_sig(v));
                    lines.push(
                        'enum ${x.name}${type_params_sig(x.type_params)} { ${vs.join(' | ')} }'
                    );
                }
            },
            Interface(x) => {
                if x.is_pub {
                    let ms = x.methods.map((m) => fn_sig(m));
                    lines.push(
                        'interface ${x.name}${type_params_sig(x.type_params)}: ${x.super_interfaces.map((s) => bound_text(s)).join('+')} { ${ms.join('; ')} }'
                    );
                }
            },
            Const(x) => {
                if x.is_pub {
                    lines.push('const ${x.name}: ${ann_or_decl_text(x.type_ann, x.span)}');
                }
            },
            Let(x) => {
                if x.is_pub {
                    lines.push('let ${x.name}: ${ann_or_decl_text(x.type_ann, x.span)}');
                }
            },
            Impl(x) => {
                let iface = match x.interface_name {
                    Some(n) => {
                        let ns = x.interface_namespace.map((s) => s + '.').unwrap_or('');
                        let args = x.interface_args.map((a) => describe_type(a));
                        '${ns}${n}<${args.join(', ')}> '
                    },
                    None => '',
                };
                let ms = x.methods.filter((m) => m.is_pub).map((m) => fn_sig(m));
                lines.push(
                    'impl${type_params_sig(x.type_params)} ${iface}for ${x.type_name} { ${ms.join('; ')} }'
                );
            },
            Import(x) => {
                if x.is_pub {
                    lines.push('pub import ${x.path}');
                }
            },
        }
    }
    // Sorted: declaration order is invisible to importers (names resolve by name),
    // so reordering decls is not a surface change.
    return lines.sorted_by((a, b) => a.compare(b) == Ordering.Less).join('\n');
}

// A function's importer-visible signature. The param's *external* label, type, and
// default-presence matter to callers; its internal name and default *value* don't.
fn fn_sig(x: FnDecl) -> String {
    let ps = x.params.map((p) => param_sig(p));
    let ret = match x.return_type {
        Some(t) => describe_type(t),
        None => 'Void',
    };
    return '${x.name}${type_params_sig(x.type_params)}(${ps.join(', ')}) -> ${ret}';
}

fn param_sig(p: Param) -> String {
    if p.is_self {
        return 'self';
    }
    let label = p.label.unwrap_or('_');
    let ty = match p.type_ann {
        Some(t) => describe_type(t),
        None => '?',
    };
    let dflt = match p.default_value {
        Some(_) => ' = _',
        None => '',
    };
    return '${label}: ${ty}${dflt}';
}

fn field_sig(f: FieldDef) -> String {
    let m = if f.is_mut { 'mut ' } else { '' };
    return '${m}${f.name}: ${describe_type(f.type_ann)}';
}

fn variant_sig(v: EnumVariant) -> String {
    let payload = v.fields.map((t) => describe_type(t));
    return '${v.name}(${payload.join(', ')})';
}

fn type_params_sig(tps: List<TypeParam>) -> String {
    if tps.len() == 0 {
        return '';
    }
    let parts = tps.map((tp) => '${tp.name}: ${tp.bounds.map((b) => bound_text(b)).join('+')}');
    return '<${parts.join(', ')}>';
}

// The written annotation, or — unannotated — the whole decl's source text (the
// initializer *is* the type's source then, so its edits must read as surface
// changes).
fn ann_or_decl_text(ann: Option<TypeRef>, span: SourceSpan) -> String {
    return match ann {
        Some(t) => describe_type(t),
        None => span.text(),
    };
}
