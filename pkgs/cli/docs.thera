//! Doc-comment attachment — re-associating `///` and `//!` comment runs with what
//! they document.
//!
//! Import as: `import 'docs'`; usage: `docs.attach(program, lex.comments)`.
//!
//! Comments ride a side channel the parser never sees ([Comment] in
//! `source.thera`), so the token stream and the AST stay pure functions of the
//! source. This pass is the other half of that bargain — gofmt's model,
//! re-associating by span — and it is what every doc consumer reads: LSP hover, the
//! doc generator, doc-example extraction, `[Symbol]` resolution. See
//! docs/documentation.md.
//!
//! **Attachment is by adjacency**, exactly as the doc model specifies: an item's
//! doc is the contiguous run of `///` lines directly above it, and a blank line or
//! an ordinary `//` line ends the run. Both fall out of the grouping rule — a blank
//! line breaks line adjacency, and a `//` line has a different [CommentKind].
//!
//! **The result is a side table, not a field on the AST.** A span offset is already
//! the AST's node identity, so a [DocMap] keyed by offset reaches every
//! documentable item — declaration, method, field, enum variant — without the
//! parser knowing comments exist, and without disturbing the structural equality
//! the parser tests compare trees with.
//!
//! One deliberate simplification: a `///` written *after* code on the same line
//! (`let x = 1; /// note`) still joins the run below it. Ruling that out costs a
//! scan of the token stream for the lines each token occupies, and no such comment
//! exists in the corpus — while the shapes that do occur (a blank line, an
//! interposed `//`) are handled exactly.

import std.char;

import 'lexer' as _; // Token, TokenKind, tokenize — the wrapper lexes, never parses
import 'ast' as _; // Program, Decl, decl_span — AST types are used pervasively
import 'source' as _; // Comment, CommentKind, SourceSpan

/// A documentation comment: one contiguous run of `///` or `//!` lines.
pub struct DocComment {
    /// `Doc` for a `///` item doc, `ModuleDoc` for a `//!` file doc. Never `Line`.
    let kind: CommentKind;
    /// The whole run — the first line's `//` through the end of the last line.
    let span: SourceSpan;
    /// One entry per line, with the marker and the single space after it removed
    /// and trailing whitespace trimmed. A bare `///` line is `''`.
    let lines: List<String>;
    /// The source span of each comment line, marker included — parallel to
    /// [DocComment.lines]. Kept so a doc example's diagnostics can point at real
    /// source rather than at an offset into a reconstructed string; reach it
    /// through [DocComment.line_span].
    let line_spans: List<SourceSpan>;
}

impl DocComment {
    /// The doc's content, lines rejoined with newlines and the markers gone.
    pub fn text(self) -> String {
        return self.lines.join('\n');
    }

    /// The **summary sentence**: the first sentence of the first paragraph, with
    /// the line breaks the author happened to wrap at joined out. `''` for an empty
    /// doc.
    ///
    /// A sentence ends at the first `.` followed by a space or the end of the
    /// paragraph, which leaves a period inside a name (`std.fs`) or a range
    /// (`[start, end)`) alone. An abbreviation that ends a word (`e.g. this`) does
    /// cut early — the price of a rule with no dictionary in it.
    pub fn summary(self) -> String {
        let para = first_paragraph(self.lines);
        return para.slice(0, sentence_end(para)).trim();
    }

    /// The last source line this run covers. Runs are line-contiguous by
    /// construction, so it is the first line plus the rest of them.
    pub fn end_line(self) -> Int {
        return self.span.line + self.lines.len() - 1;
    }

    /// The span of the run's line at `index` — the whole comment line, marker
    /// included. Out of range yields the run's own span, so a caller building a
    /// diagnostic always has somewhere to point.
    pub fn line_span(self, index: Int) -> SourceSpan {
        return self.line_spans.get(index).unwrap_or(self.span);
    }
}

/// Every doc comment in one file, attached to what it documents.
pub struct DocMap {
    /// The file's `//!` header — the first `//!` run in the file, which is the
    /// package doc when the file is a directory library's barrel.
    let file_doc: Option<DocComment>;
    /// Item docs, keyed by the code-point offset of the documented item's span.
    /// Reach it through [DocMap.at] rather than reading it directly.
    let by_offset: Map<Int, DocComment>;
}

impl DocMap {
    /// The doc attached to the item whose span starts at `span`, if any. The key is
    /// the offset, so any node's own span works — a declaration, an `impl` or
    /// `interface` method, a struct field, an enum variant.
    pub fn at(self, span: SourceSpan) -> Option<DocComment> {
        return self.by_offset.get(span.offset);
    }

    /// The doc attached to `d`, if any.
    pub fn for_decl(self, d: Decl) -> Option<DocComment> {
        return self.at(decl_span(d));
    }

    /// How many items carry a doc.
    pub fn len(self) -> Int {
        return self.by_offset.len();
    }
}

/// Attach `comments` to the items of `program`.
///
/// Pass the whole file's comments — `lex.comments`, unfiltered. Ordinary `//`
/// comments are never extracted, but they are load-bearing here: one interposed
/// between a doc run and a declaration ends the run, which is the disambiguation
/// the doc model buys by separating the three comment forms lexically.
pub fn attach(program: Program, comments: List<Comment>) -> DocMap {
    let runs = doc_runs(comments);
    let anchors = anchor_lines(program);

    let by_offset: Map<Int, DocComment> = [:];
    for run in runs {
        if run.kind != CommentKind.Doc {
            continue;
        }
        if let Some(offset) = anchors.get(run.end_line() + 1) {
            by_offset[offset] = run;
        }
    }
    let module_runs = runs.filter((r) => r.kind == CommentKind.ModuleDoc);
    return DocMap { file_doc: module_runs.first(), by_offset: by_offset };
}

/// Every `///` and `//!` run in `comments`, in source order.
///
/// A run is a maximal stack of doc comments of one kind on consecutive lines.
/// Ordinary `//` comments never join a run, and break any run they interrupt.
pub fn doc_runs(comments: List<Comment>) -> List<DocComment> {
    let out: List<DocComment> = [];
    let mut i = 0;
    while i < comments.len() {
        let head = comments[i];
        if head.kind == CommentKind.Line {
            i = i + 1;
            continue;
        }
        let mut j = i + 1;
        while j < comments.len() && continues(comments[j - 1], comments[j]) {
            j = j + 1;
        }
        let lines: List<String> = [];
        let line_spans: List<SourceSpan> = [];
        let mut k = i;
        while k < j {
            lines.push(content_of(comments[k]));
            line_spans.push(comments[k].span);
            k = k + 1;
        }
        out.push(DocComment {
            kind: head.kind,
            span: head.span.cover(comments[j - 1].span),
            lines: lines,
            line_spans: line_spans,
        });
        i = j;
    }
    return out;
}

// --- Code examples ---

/// A fenced code block inside a doc comment.
///
/// Every fence is returned, Thera or not — the non-Thera ones so a renderer can
/// show them and so [DocExample.problems] has one place to report from.
pub struct DocExample {
    /// The opening fence's source line — the example's identity (`path:line`) and
    /// where a diagnostic about the block as a whole points.
    let span: SourceSpan;
    /// The index of the opening fence within the doc run's lines. Body line `n` is
    /// therefore run line `fence_index + 1 + n`, which is how a diagnostic inside
    /// the block gets back to real source.
    let fence_index: Int;
    /// The block's content, fences excluded, exactly as written — any indentation
    /// inside the block is the author's and is preserved.
    let lines: List<String>;
    /// The info string's language tag; `''` for a bare fence.
    let lang: String;
    /// The attributes after the tag, in source order.
    let attrs: List<String>;
    /// Compile-check this block.
    let verified: Bool;
    /// ...and run it, when it carries an oracle.
    let runnable: Bool;
    /// Why this fence cannot be taken at face value — an unknown attribute, a
    /// separator that isn't a comma, an unterminated fence. Empty when it is
    /// well-formed. Never silently dropped: a fence that means to opt out of
    /// verification must do it in a way the reader can see, so a malformed attempt
    /// is reported rather than obeyed.
    let problems: List<String>;
}

impl DocExample {
    /// The block's content as one string.
    pub fn text(self) -> String {
        return self.lines.join('\n');
    }
}

/// Every fenced code block in `doc`, in source order.
///
/// **A bare fence is Thera.** Inside a `///` or `//!` comment the default is the
/// language the file is written in, so a new example is verified without anyone
/// remembering to ask; content that is *not* Thera takes an explicit tag (` ```text
/// `, ` ```sh `). Markdown files invert this — see docs/documentation.md — and get
/// their own entry point when phase 2 lands.
pub fn doc_examples(doc: DocComment) -> List<DocExample> {
    let out: List<DocExample> = [];
    let mut i = 0;
    while i < doc.lines.len() {
        let ticks = fence_ticks(doc.lines[i]);
        if ticks == 0 {
            i = i + 1;
            continue;
        }
        let info = doc.lines[i].trim().slice(ticks, doc.lines[i].trim().len()).trim();
        let body: List<String> = [];
        let mut j = i + 1;
        let mut closed = false;
        while j < doc.lines.len() {
            if is_closing_fence(doc.lines[j], ticks) {
                closed = true;
                j = j + 1;
                break;
            }
            body.push(doc.lines[j]);
            j = j + 1;
        }
        out.push(build_example(doc, i, info, body, closed));
        i = j;
    }
    return out;
}

// Assemble one example from its parsed pieces, applying the fence contract.
fn build_example(
    doc: DocComment,
    fence_index: Int,
    info: String,
    body: List<String>,
    closed: Bool,
) -> DocExample {
    let problems: List<String> = [];
    if !closed {
        problems.push('unterminated code fence');
    }
    let parts = split_info(info, problems);
    let lang = parts.lang;
    let is_thera = lang == '' || lang == 'thera';

    let mut no_check = false;
    let mut no_run = false;
    for a in parts.attrs {
        if a == 'no_check' {
            no_check = true;
        } else if a == 'no_run' {
            no_run = true;
        } else {
            problems.push('unknown fence attribute `${a}`; expected `no_check` or `no_run`');
        }
    }
    if parts.attrs.len() != 0 && lang == '' {
        problems.push('a fence attribute needs the explicit `thera` tag');
    }
    if parts.attrs.len() != 0 && !is_thera {
        problems.push('fence attributes apply to `thera` blocks; `${lang}` has none');
    }

    let verified = is_thera && !no_check;
    return DocExample {
        span: doc.line_span(fence_index),
        fence_index: fence_index,
        lines: body,
        lang: lang,
        attrs: parts.attrs,
        verified: verified,
        runnable: verified && !no_run,
        problems: problems,
    };
}

struct InfoString {
    let lang: String;
    let attrs: List<String>;
}

// Split an info string into its language tag and attributes. Attributes are
// comma-separated (`thera,no_run`), the spelling Rust's doctests use; a space after
// the comma is accepted. A space used *instead* of a comma is not silently taken as
// part of the tag — that would leave `thera no_run` looking like an unknown
// language and quietly skip verification — so it is split anyway and reported.
fn split_info(info: String, problems: List<String>) -> InfoString {
    let attrs: List<String> = [];
    let mut lang = '';
    for group in info.split(',').enumerate() {
        let words = group.value.split(' ').filter((w) => w != '');
        for word in words.enumerate() {
            if group.index == 0 && word.index == 0 {
                lang = word.value;
            } else {
                if word.index != 0 {
                    problems.push(
                        'fence attributes are comma-separated: `${lang},${word.value}`',
                    );
                }
                attrs.push(word.value);
            }
        }
    }
    return InfoString { lang: lang, attrs: attrs };
}

// The count of leading backticks on `line`, or 0 if it does not open or close a
// fence. CommonMark wants three or more.
fn fence_ticks(line: String) -> Int {
    let t = line.trim();
    let mut n = 0;
    while n < t.len() && t.slice(n, n + 1) == '`' {
        n = n + 1;
    }
    return if n >= 3 { n } else { 0 };
}

// A closing fence is backticks alone, at least as many as the opener's.
fn is_closing_fence(line: String, opener: Int) -> Bool {
    let n = fence_ticks(line);
    return n >= opener && line.trim().len() == n;
}

// The start line of every item a doc run can attach to, mapped to that item's span
// offset. A declaration's span starts at its first decorator (or `pub`, or the
// introducing keyword), so this is the line a doc must sit directly above.
//
// First writer wins: two items on one line (`pub fn a() {} pub fn b() {}`) is
// legal, and a doc above them documents the first.
fn anchor_lines(program: Program) -> Map<Int, Int> {
    let anchors: Map<Int, Int> = [:];
    for d in program.decls {
        note(anchors, decl_span(d));
        if let Impl(x) = d {
            for m in x.methods {
                note(anchors, m.span);
            }
        }
        if let Interface(x) = d {
            for m in x.methods {
                note(anchors, m.span);
            }
        }
        if let Type(x) = d {
            for f in x.fields {
                note(anchors, f.span);
            }
        }
        if let Enum(x) = d {
            for v in x.variants {
                note(anchors, v.span);
            }
        }
    }
    return anchors;
}

fn note(anchors: Map<Int, Int>, span: SourceSpan) -> Void {
    if !anchors.has(span.line) {
        anchors[span.line] = span.offset;
    }
}

// Whether `b` continues the run `a` is in: the very next line, and the same marker.
fn continues(a: Comment, b: Comment) -> Bool {
    return b.span.line == a.span.line + 1 && b.kind == a.kind;
}

// One comment's content: the text past the three-character marker (`///` and `//!`
// are both three), less one separating space and any trailing whitespace.
fn content_of(c: Comment) -> String {
    let text = c.span.text();
    let rest = text.slice(3, text.len());
    let body = if rest.starts_with(' ') { rest.slice(1, rest.len()) } else { rest };
    return body.trim_end();
}

// The doc's first paragraph as one line: everything up to the first blank line,
// with the author's wrapping joined out.
fn first_paragraph(lines: List<String>) -> String {
    let taken: List<String> = [];
    for line in lines {
        if line.trim() == '' {
            break;
        }
        taken.push(line.trim());
    }
    return taken.join(' ').trim();
}

// Where the first sentence of `para` ends: just past the first `.` followed by a
// space or nothing. The whole length when there is no such period, so a summary
// written without one is the paragraph itself.
fn sentence_end(para: String) -> Int {
    let cs = para.chars();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == char.DOT && (i + 1 == cs.len() || cs[i + 1] == char.SPACE) {
            return i + 1;
        }
        i = i + 1;
    }
    return cs.len();
}

// --- Wrapper synthesis ---

/// A doc example rendered as a compilable Thera source file, plus the line map back
/// to the block it came from.
pub struct ExampleProgram {
    /// The synthesized source.
    let source: String;
    /// For each 0-based line of [ExampleProgram.source], the 0-based line of the
    /// example's body it came from — or `-1` for a line the wrapper invented. This
    /// is what lets a diagnostic inside the synthesized program point at the real
    /// doc comment. Columns are carried through unchanged except on a line the
    /// wrapper prefixed, so a column is exact for the lines that matter and
    /// approximate for the handful that do not.
    let line_map: List<Int>;
}

/// Render `ex` as a source file, per docs/documentation.md § What compiles.
///
/// Top-level declarations stay at the top level and loose statements are collected,
/// in source order, into a synthesized `fn main() -> Result<Int, Error>` — the
/// `Result` return being why `?` works in a doc example, which the corpus leans on
/// heavily. A block that declares its own `main` is left alone. `library` is the
/// documented library, auto-imported under its own namespace unless the block
/// already imports it.
///
/// **REPL shape.** A loose statement that is a bare expression is emitted as
/// `let _ = <expr>;`, which is what makes the corpus's `'hello'.slice(1, 4)` line
/// compile — it covers both the missing terminator and the discarded `Result`
/// without any relaxation in the checker.
///
/// This is a **pure function of the example's text**: it lexes, but reads no file,
/// resolves no import, and touches no cache.
pub fn example_program(ex: DocExample, library: Option<String>) -> ExampleProgram {
    let body = dedent(ex.lines);
    let text = body.join('\n');
    let toks = tokenize(text).tokens;
    let chunks = top_level_chunks(body, toks);

    let out: List<String> = [];
    let map: List<Int> = [];
    if let Some(lib) = library {
        if !imports_library(toks, lib) {
            out.push('import std.${lib};');
            map.push(-1);
            out.push('');
            map.push(-1);
        }
    }

    // Declarations first, in source order, then the loose statements under one
    // synthesized `main`. Hoisting is what breaks the one-line-per-line
    // correspondence, which is exactly why the line map is explicit.
    for c in chunks {
        if !c.is_decl {
            continue;
        }
        emit_lines(out, map, body, c, Option.None);
    }
    if declares_main(toks) {
        return ExampleProgram { source: out.join('\n') + '\n', line_map: map };
    }

    out.push('fn main() -> Result<Int, Error> {');
    map.push(-1);
    for c in chunks {
        if c.is_decl {
            continue;
        }
        emit_lines(out, map, body, c, if c.needs_discard { Option.Some(c) } else { Option.None });
    }
    out.push('return Result.Ok(0);');
    map.push(-1);
    out.push('}');
    map.push(-1);
    return ExampleProgram { source: out.join('\n') + '\n', line_map: map };
}

// One top-level region of a doc example's body: a run of lines starting at a line
// that begins something at bracket depth 0.
struct Chunk {
    let start: Int; // 0-based line
    let end: Int; // 0-based, inclusive
    let is_decl: Bool;
    // A loose chunk whose last token is not `;` or `}` — a bare expression, which
    // becomes `let _ = …;`.
    let needs_discard: Bool;
    let last_line: Int; // the line the closing `;` goes on
    let last_col: Int; // 1-based column just past the last token
}

// Copy a chunk's lines into `out`, recording where each came from. `discard` marks
// the chunk that gets the `let _ = ` prefix and the trailing `;`.
fn emit_lines(
    out: List<String>,
    map: List<Int>,
    body: List<String>,
    c: Chunk,
    discard: Option<Chunk>,
) -> Void {
    let mut i = c.start;
    while i <= c.end && i < body.len() {
        let mut line = body[i];
        if let Some(d) = discard {
            // Insert the terminator after the last *token*, never at end of line: a
            // trailing `// comment` would otherwise swallow it.
            if i == d.last_line {
                line = line.slice(0, d.last_col - 1) + ';' + line.slice(d.last_col - 1, line.len());
            }
            if i == d.start {
                line = 'let _ = ' + line;
            }
        }
        out.push(line);
        map.push(i);
        i = i + 1;
    }
}

// Split a body into its top-level chunks — one per statement or declaration.
//
// Driven by **tokens**, not lines, for two reasons a line-based splitter cannot
// answer. A brace or a `//` inside a string literal is not punctuation
// (`path.components('a//b/')`), and a statement routinely spans several lines:
//
//     let evens = iter.range(0, 10)
//         .filter((n) => n % 2 == 0)
//         .to_list();
//
// A chunk therefore ends where a statement really ends — a `;` or a closing `}` at
// depth zero — or, for the REPL shape the corpus is full of, at a newline that no
// token wants to continue across. That last rule is what keeps two adjacent oracle
// lines (`xs.get(1)` / `xs.get(9)`) two examples rather than one syntax error,
// while keeping the chain above whole.
fn top_level_chunks(body: List<String>, toks: List<Token>) -> List<Chunk> {
    let out: List<Chunk> = [];
    let real = toks.filter((t) => t.kind != TokenKind.Eof);
    let mut depth = 0;
    let mut start = -1;
    for t in real.enumerate() {
        if start < 0 {
            start = t.index;
        }
        depth = depth + bracket_delta(t.value.kind);
        if depth < 0 {
            depth = 0;
        }
        if depth != 0 {
            continue;
        }
        let next = real.get(t.index + 1);
        if ends_chunk(t.value, next) {
            out.push(chunk_of(body, real, start, t.index, real.len()));
            start = -1;
        }
    }
    if start >= 0 {
        out.push(chunk_of(body, real, start, real.len() - 1, real.len()));
    }
    return out;
}

// Whether a depth-zero `t` closes the statement it is in, given what follows.
fn ends_chunk(t: Token, next: Option<Token>) -> Bool {
    let Some(n) = next else {
        return true; // end of block
    };
    if t.kind == TokenKind.Semi {
        return true;
    }
    // A `}` back at depth zero ends its statement unless an `else` picks it up.
    if t.kind == TokenKind.RBrace {
        return n.kind != TokenKind.KwElse;
    }
    // Otherwise only a line break can end it, and only when neither side wants to
    // carry on: a leading `.` or `?` continues a chain, and a trailing operator
    // continues an expression.
    if n.span.line == t.span.line {
        return false;
    }
    return can_end_expression(t.kind) && !can_continue_expression(n.kind);
}

// Whether a token can be the last one of an expression.
fn can_end_expression(k: TokenKind) -> Bool {
    return match k {
        Identifier => true,
        IntLiteral => true,
        FloatLiteral => true,
        StringLiteral => true,
        KwTrue => true,
        KwFalse => true,
        KwVoid => true,
        RParen => true,
        RBracket => true,
        RBrace => true,
        Question => true,
        _ => false,
    };
}

// Whether a token can carry the previous line's expression forward.
fn can_continue_expression(k: TokenKind) -> Bool {
    return match k {
        Dot => true,
        Question => true,
        LParen => true,
        LBracket => true,
        _ => is_infix_operator(k),
    };
}

fn is_infix_operator(k: TokenKind) -> Bool {
    return match k {
        Plus => true,
        Minus => true,
        Star => true,
        Slash => true,
        Percent => true,
        EqEq => true,
        BangEq => true,
        Lt => true,
        Gt => true,
        LtEq => true,
        GtEq => true,
        AmpAmp => true,
        PipePipe => true,
        Amp => true,
        Pipe => true,
        Caret => true,
        DotDot => true,
        _ => false,
    };
}

// Build the chunk spanning tokens `[first, last]`.
fn chunk_of(body: List<String>, real: List<Token>, first: Int, last: Int, total: Int) -> Chunk {
    let head = real[first];
    let tail = real[last];
    let is_decl = starts_declaration(head.kind);
    let terminated = tail.kind == TokenKind.Semi || tail.kind == TokenKind.RBrace;
    // Lines the chunk owns: from its first token's line to the line before the next
    // chunk starts, so a trailing comment stays with the statement it annotates.
    let end_line = if last + 1 < total { real[last + 1].span.line - 2 } else { body.len() - 1 };
    return Chunk {
        start: head.span.line - 1,
        end: if end_line < tail.span.line - 1 { tail.span.line - 1 } else { end_line },
        is_decl: is_decl,
        needs_discard: !is_decl && !terminated,
        last_line: tail.span.line - 1,
        last_col: tail.span.column + tail.span.length,
    };
}

// Whether a token can open a top-level declaration. `let` and `const` deliberately
// are not here: at the top of a doc example they are loose statements headed for
// `main`, not module-level bindings — the distinction a naive splitter gets wrong.
fn starts_declaration(k: TokenKind) -> Bool {
    return match k {
        KwImport => true,
        KwFn => true,
        KwStruct => true,
        KwEnum => true,
        KwInterface => true,
        KwImpl => true,
        KwNative => true,
        KwPub => true,
        At => true,
        _ => false,
    };
}

fn bracket_delta(k: TokenKind) -> Int {
    return match k {
        LBrace => 1,
        LParen => 1,
        LBracket => 1,
        RBrace => -1,
        RParen => -1,
        RBracket => -1,
        _ => 0,
    };
}

// Whether the block already imports `std.<lib>`, so the auto-import is not doubled.
fn imports_library(toks: List<Token>, lib: String) -> Bool {
    for t in toks.enumerate() {
        if t.value.kind == TokenKind.KwImport && t.index + 1 < toks.len() {
            if toks[t.index + 1].value == Option.Some('std') {
                if t.index + 3 < toks.len() && toks[t.index + 3].value == Option.Some(lib) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn declares_main(toks: List<Token>) -> Bool {
    for t in toks.enumerate() {
        if t.value.kind == TokenKind.KwFn && t.index + 1 < toks.len() {
            if toks[t.index + 1].value == Option.Some('main') {
                return true;
            }
        }
    }
    return false;
}

// Strip the block's common leading indentation; anything deeper is the author's.
fn dedent(lines: List<String>) -> List<String> {
    let mut common = -1;
    for l in lines {
        if l.trim() == '' {
            continue;
        }
        let n = l.len() - l.trim_start().len();
        if common < 0 || n < common {
            common = n;
        }
    }
    if common <= 0 {
        return lines;
    }
    return lines.map((l) => if l.len() >= common { l.slice(common, l.len()) } else { l });
}
