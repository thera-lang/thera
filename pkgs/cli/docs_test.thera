//! Tests for doc-comment attachment.
//!
//! The shapes worth pinning are the boundaries of a run — what joins one and what
//! ends one — and that an offset key reaches nested items (methods, fields,
//! variants), since that is the whole reason the map is keyed by span rather than
//! by declaration name.

import std.testing;

import 'docs' as _;
import 'lexer' as _;
import 'parser' as _;
import 'source' as _;

// Attach docs for a source string, the way a real caller would.
fn map_of(src: String) -> DocMap {
    let lex = tokenize(src);
    return attach(parse_tokens(lex.tokens).program, lex.comments);
}

// The doc text attached to the top-level decl at `index`, or `<none>`.
fn decl_doc(src: String, index: Int) -> String {
    let m = map_of(src);
    let program = parse_tokens(tokenize(src).tokens).program;
    return match m.for_decl(program.decls[index]) {
        Some(d) => d.text(),
        None => '<none>',
    };
}

@test
fn test_attaches_to_the_decl_below() -> Result<Void, Error> {
    let src = '/// The answer.\nfn f() -> Int { return 42; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'The answer.')?;
    return Result.Ok(void);
}

@test
fn test_multi_line_run_is_one_doc() -> Result<Void, Error> {
    let src = '/// One.\n/// Two.\n/// Three.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'One.\nTwo.\nThree.')?;
    return Result.Ok(void);
}

@test
fn test_bare_marker_line_is_an_empty_line() -> Result<Void, Error> {
    let src = '/// Summary.\n///\n/// Detail.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'Summary.\n\nDetail.')?;
    return Result.Ok(void);
}

@test
fn test_blank_line_ends_the_run() -> Result<Void, Error> {
    // The stray run above the blank line attaches to nothing; only the adjacent one
    // reaches the declaration.
    let src = '/// Stray.\n\n/// Real.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'Real.')?;
    testing.assert_eq(actual: map_of(src).len(), expected: 1)?;
    return Result.Ok(void);
}

@test
fn test_ordinary_comment_ends_the_run() -> Result<Void, Error> {
    // The disambiguation the three lexical forms buy: an internal note may sit
    // directly above a declaration without becoming its documentation.
    let src = '/// Not the doc.\n// internal note\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: '<none>')?;
    testing.assert_eq(actual: map_of(src).len(), expected: 0)?;
    return Result.Ok(void);
}

@test
fn test_slash_run_divider_is_not_a_doc() -> Result<Void, Error> {
    // `////`+ classifies as an ordinary comment (source.classify_comment), so a
    // divider never becomes documentation.
    let src = '//// ----\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: '<none>')?;
    return Result.Ok(void);
}

@test
fn test_doc_above_a_decorator_still_attaches() -> Result<Void, Error> {
    // A decl's span starts at its first decorator, which is what the doc sits above
    // in every `sdk/std` native binding.
    let src = '/// Reads a file.\n@extern(\'fs_read_text\')\npub native fn read_text(p: String) -> String\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'Reads a file.')?;
    return Result.Ok(void);
}

@test
fn test_module_doc_is_the_file_doc() -> Result<Void, Error> {
    let src = '//! A library.\n//!\n//! Import as: import x;\n\n/// An item.\nfn f() -> Int { return 0; }\n';
    let m = map_of(src);
    let Some(file) = m.file_doc else {
        return Result.Err(error('expected a file doc'));
    };
    testing.assert_eq(actual: file.text(), expected: 'A library.\n\nImport as: import x;')?;
    testing.assert_eq(actual: file.kind, expected: CommentKind.ModuleDoc)?;
    // The `//!` header is not also an item doc for the declaration under it.
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'An item.')?;
    return Result.Ok(void);
}

@test
fn test_no_module_doc_is_none() -> Result<Void, Error> {
    let m = map_of('/// An item.\nfn f() -> Int { return 0; }\n');
    testing.assert_eq(actual: m.file_doc, expected: Option.None)?;
    return Result.Ok(void);
}

@test
fn test_attaches_to_impl_methods() -> Result<Void, Error> {
    let src = 'struct S { let x: Int; }\n\nimpl S {\n    /// The x.\n    pub fn x_of(self) -> Int { return self.x; }\n}\n';
    let program = parse_tokens(tokenize(src).tokens).program;
    let m = map_of(src);
    let Impl(i) = program.decls[1] else {
        return Result.Err(error('expected an impl decl'));
    };
    let Some(doc) = m.at(i.methods[0].span) else {
        return Result.Err(error('expected a doc on the method'));
    };
    testing.assert_eq(actual: doc.text(), expected: 'The x.')?;
    return Result.Ok(void);
}

@test
fn test_attaches_to_interface_methods() -> Result<Void, Error> {
    let src = 'interface Show {\n    /// Renders it.\n    fn show(self) -> String;\n}\n';
    let program = parse_tokens(tokenize(src).tokens).program;
    let Interface(i) = program.decls[0] else {
        return Result.Err(error('expected an interface decl'));
    };
    let Some(doc) = map_of(src).at(i.methods[0].span) else {
        return Result.Err(error('expected a doc on the method'));
    };
    testing.assert_eq(actual: doc.text(), expected: 'Renders it.')?;
    return Result.Ok(void);
}

@test
fn test_attaches_to_struct_fields() -> Result<Void, Error> {
    let src = 'struct S {\n    /// Where it lives.\n    let path: String;\n}\n';
    let program = parse_tokens(tokenize(src).tokens).program;
    let Type(t) = program.decls[0] else {
        return Result.Err(error('expected a struct decl'));
    };
    let Some(doc) = map_of(src).at(t.fields[0].span) else {
        return Result.Err(error('expected a doc on the field'));
    };
    testing.assert_eq(actual: doc.text(), expected: 'Where it lives.')?;
    return Result.Ok(void);
}

@test
fn test_attaches_to_enum_variants() -> Result<Void, Error> {
    let src = 'enum E {\n    /// The empty one.\n    None,\n    Some(Int),\n}\n';
    let program = parse_tokens(tokenize(src).tokens).program;
    let Enum(e) = program.decls[0] else {
        return Result.Err(error('expected an enum decl'));
    };
    let m = map_of(src);
    let Some(doc) = m.at(e.variants[0].span) else {
        return Result.Err(error('expected a doc on the variant'));
    };
    testing.assert_eq(actual: doc.text(), expected: 'The empty one.')?;
    testing.assert_eq(actual: m.at(e.variants[1].span), expected: Option.None)?;
    return Result.Ok(void);
}

@test
fn test_doc_over_nothing_attaches_to_nothing() -> Result<Void, Error> {
    // A trailing run with no declaration under it is simply unattached. It is still
    // a run — a future lint can flag it — but nothing claims it.
    let m = map_of('fn f() -> Int { return 0; }\n\n/// Dangling.\n');
    testing.assert_eq(actual: m.len(), expected: 0)?;
    testing.assert_eq(
        actual: doc_runs(tokenize('fn f() -> Int { return 0; }\n\n/// Dangling.\n').comments).len(),
        expected: 1,
    )?;
    return Result.Ok(void);
}

@test
fn test_each_decl_gets_its_own_doc() -> Result<Void, Error> {
    let src = '/// First.\nfn a() -> Int { return 0; }\n\n/// Second.\nfn b() -> Int { return 1; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'First.')?;
    testing.assert_eq(actual: decl_doc(src, 1), expected: 'Second.')?;
    testing.assert_eq(actual: map_of(src).len(), expected: 2)?;
    return Result.Ok(void);
}

@test
fn test_span_covers_the_whole_run() -> Result<Void, Error> {
    let src = '/// One.\n/// Two.\nfn f() -> Int { return 0; }\n';
    let runs = doc_runs(tokenize(src).comments);
    testing.assert_eq(actual: runs.len(), expected: 1)?;
    testing.assert_eq(actual: runs[0].span.text(), expected: '/// One.\n/// Two.')?;
    testing.assert_eq(actual: runs[0].span.line, expected: 1)?;
    testing.assert_eq(actual: runs[0].end_line(), expected: 2)?;
    return Result.Ok(void);
}

@test
fn test_content_strips_one_space_only() -> Result<Void, Error> {
    // Indentation inside a doc is structure the author meant (a fenced block, an
    // indented list), so only the single separating space comes off.
    let src = '///   indented\n///no space\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: '  indented\nno space')?;
    return Result.Ok(void);
}

@test
fn test_trailing_whitespace_is_trimmed() -> Result<Void, Error> {
    let src = '/// Padded.   \nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: decl_doc(src, 0), expected: 'Padded.')?;
    return Result.Ok(void);
}

// --- The summary sentence ---

fn summary_of(src: String) -> String {
    let m = map_of(src);
    let program = parse_tokens(tokenize(src).tokens).program;
    return match m.for_decl(program.decls[0]) {
        Some(d) => d.summary(),
        None => '<none>',
    };
}

@test
fn test_summary_is_the_first_sentence() -> Result<Void, Error> {
    let src = '/// The answer. And more prose after it.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: summary_of(src), expected: 'The answer.')?;
    return Result.Ok(void);
}

@test
fn test_summary_joins_the_authors_wrapping() -> Result<Void, Error> {
    let src = '/// The substring of the code points\n/// in the range. More detail here.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(
        actual: summary_of(src),
        expected: 'The substring of the code points in the range.',
    )?;
    return Result.Ok(void);
}

@test
fn test_summary_stops_at_the_first_paragraph() -> Result<Void, Error> {
    // No terminating period, so the sentence rule falls through to the paragraph —
    // which must not run on into the second one.
    let src = '/// A summary with no period\n///\n/// A second paragraph.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: summary_of(src), expected: 'A summary with no period')?;
    return Result.Ok(void);
}

@test
fn test_summary_keeps_a_period_inside_a_word() -> Result<Void, Error> {
    // `std.fs` and `[start, end)` are the shapes the naive "first period" rule gets
    // wrong; a period only ends a sentence when a space or the end follows it.
    let src = '/// Reads via std.fs and returns it. Then stops.\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: summary_of(src), expected: 'Reads via std.fs and returns it.')?;
    return Result.Ok(void);
}

@test
fn test_summary_of_an_empty_doc_is_empty() -> Result<Void, Error> {
    let src = '///\nfn f() -> Int { return 0; }\n';
    testing.assert_eq(actual: summary_of(src), expected: '')?;
    return Result.Ok(void);
}

// --- Code examples ---

// The examples in a source string's first doc run.
fn examples_of(src: String) -> List<DocExample> {
    return doc_examples(doc_runs(tokenize(src).comments)[0]);
}

// A doc comment carrying one fence with the given info string and one body line.
fn one_fence(info: String) -> DocExample {
    return examples_of(
        '/// ```${info}\n/// let x = 1;\n/// ```\nfn f() -> Int { return 0; }\n',
    )[0];
}

@test
fn test_bare_fence_in_a_doc_comment_is_thera() -> Result<Void, Error> {
    // The default that makes a new example verified without anyone tagging it.
    let ex = one_fence('');
    testing.assert_eq(actual: ex.lang, expected: '')?;
    testing.assert(ex.verified, message: 'a bare fence is Thera and verified')?;
    testing.assert(ex.runnable, message: 'and runnable')?;
    testing.assert_eq(actual: ex.problems, expected: [])?;
    return Result.Ok(void);
}

@test
fn test_explicit_thera_tag_is_the_same() -> Result<Void, Error> {
    let ex = one_fence('thera');
    testing.assert_eq(actual: ex.lang, expected: 'thera')?;
    testing.assert(ex.verified, message: 'verified')?;
    testing.assert(ex.runnable, message: 'runnable')?;
    return Result.Ok(void);
}

@test
fn test_another_language_is_not_thera() -> Result<Void, Error> {
    // The escape now that bare means Thera: a flag table or a shell transcript.
    for tag in ['text', 'sh', 'json'] {
        let ex = one_fence(tag);
        testing.assert(!ex.verified, message: '`${tag}` is not checked')?;
        testing.assert(!ex.runnable, message: '`${tag}` is not run')?;
        testing.assert_eq(actual: ex.problems, expected: [])?;
    }
    return Result.Ok(void);
}

@test
fn test_no_run_compiles_but_does_not_run() -> Result<Void, Error> {
    let ex = one_fence('thera,no_run');
    testing.assert_eq(actual: ex.attrs, expected: ['no_run'])?;
    testing.assert(ex.verified, message: 'still compile-checked')?;
    testing.assert(!ex.runnable, message: 'never run')?;
    testing.assert_eq(actual: ex.problems, expected: [])?;
    return Result.Ok(void);
}

@test
fn test_no_check_disables_both() -> Result<Void, Error> {
    // The ladder: no_check turns off the stage no_run leaves on.
    let ex = one_fence('thera,no_check');
    testing.assert(!ex.verified, message: 'not compile-checked')?;
    testing.assert(!ex.runnable, message: 'and so not run either')?;
    return Result.Ok(void);
}

@test
fn test_a_space_after_the_comma_is_accepted() -> Result<Void, Error> {
    let ex = one_fence('thera, no_run');
    testing.assert_eq(actual: ex.lang, expected: 'thera')?;
    testing.assert_eq(actual: ex.attrs, expected: ['no_run'])?;
    testing.assert_eq(actual: ex.problems, expected: [])?;
    return Result.Ok(void);
}

@test
fn test_both_attributes_compose() -> Result<Void, Error> {
    let ex = one_fence('thera,no_check,no_run');
    testing.assert_eq(actual: ex.attrs, expected: ['no_check', 'no_run'])?;
    testing.assert(!ex.verified, message: 'no_check wins')?;
    return Result.Ok(void);
}

@test
fn test_unknown_attribute_is_reported_not_obeyed() -> Result<Void, Error> {
    // The point of the rule: a typo must not quietly switch verification off.
    let ex = one_fence('thera,norun');
    testing.assert(ex.verified, message: 'still verified despite the typo')?;
    testing.assert(ex.runnable, message: 'and still runnable')?;
    testing.assert_eq(actual: ex.problems.len(), expected: 1)?;
    testing.assert(
        ex.problems[0].contains('unknown fence attribute `norun`'),
        message: 'names the offending attribute, got: ${ex.problems[0]}',
    )?;
    return Result.Ok(void);
}

@test
fn test_space_separated_attributes_are_reported_not_ignored() -> Result<Void, Error> {
    // `thera no_run` would otherwise read as an unknown language and skip
    // verification silently — the one outcome the contract cannot allow.
    let ex = one_fence('thera no_run');
    testing.assert_eq(actual: ex.lang, expected: 'thera')?;
    testing.assert_eq(actual: ex.attrs, expected: ['no_run'])?;
    testing.assert(
        ex.problems[0].contains('comma-separated'),
        message: 'says how to spell it, got: ${ex.problems[0]}',
    )?;
    return Result.Ok(void);
}

@test
fn test_attribute_without_a_tag_is_reported() -> Result<Void, Error> {
    let ex = one_fence(',no_run');
    testing.assert(
        ex.problems.join(' ').contains('needs the explicit `thera` tag'),
        message: 'got: ${ex.problems.join(" | ")}',
    )?;
    return Result.Ok(void);
}

@test
fn test_attribute_on_a_non_thera_fence_is_reported() -> Result<Void, Error> {
    let ex = one_fence('text,no_run');
    testing.assert(!ex.verified, message: 'still not Thera')?;
    testing.assert(
        ex.problems.join(' ').contains('apply to `thera` blocks'),
        message: 'got: ${ex.problems.join(" | ")}',
    )?;
    return Result.Ok(void);
}

@test
fn test_body_excludes_the_fences_and_keeps_indentation() -> Result<Void, Error> {
    // Indentation inside a block is the author's structure, not ours to strip.
    let ex = examples_of(
        '/// ```\n/// if c {\n///     work();\n/// }\n/// ```\nfn f() -> Int { return 0; }\n',
    )[0];
    testing.assert_eq(actual: ex.lines, expected: ['if c {', '    work();', '}'])?;
    testing.assert_eq(actual: ex.text(), expected: 'if c {\n    work();\n}')?;
    return Result.Ok(void);
}

@test
fn test_fence_span_and_index_locate_the_block() -> Result<Void, Error> {
    // `path:line` identity, and the offset a diagnostic inside the block needs.
    let ex = examples_of(
        '/// Summary.\n///\n/// ```\n/// let x = 1;\n/// ```\nfn f() -> Int { return 0; }\n',
    )[0];
    testing.assert_eq(actual: ex.fence_index, expected: 2)?;
    testing.assert_eq(actual: ex.span.line, expected: 3)?;
    testing.assert_eq(actual: ex.span.text(), expected: '/// ```')?;
    return Result.Ok(void);
}

@test
fn test_several_fences_in_one_doc() -> Result<Void, Error> {
    let exs = examples_of(
        '/// ```\n/// let a = 1;\n/// ```\n/// prose\n/// ```text\n/// output\n/// ```\n'
        + 'fn f() -> Int { return 0; }\n',
    );
    testing.assert_eq(actual: exs.len(), expected: 2)?;
    testing.assert(exs[0].verified, message: 'the first is Thera')?;
    testing.assert(!exs[1].verified, message: 'the second is not')?;
    testing.assert_eq(actual: exs[1].lines, expected: ['output'])?;
    return Result.Ok(void);
}

@test
fn test_module_doc_fences_are_found_too() -> Result<Void, Error> {
    // A barrel's `//!` header is where a library's headline example lives.
    let exs = doc_examples(
        doc_runs(tokenize('//! A lib.\n//!\n//! ```\n//! go();\n//! ```\n').comments)[0]
    );
    testing.assert_eq(actual: exs.len(), expected: 1)?;
    testing.assert_eq(actual: exs[0].lines, expected: ['go();'])?;
    return Result.Ok(void);
}

@test
fn test_unterminated_fence_is_reported() -> Result<Void, Error> {
    // The run ends before the closing fence. Report it — dropping the block would
    // be a silent loss of verification.
    let exs = examples_of('/// ```\n/// let x = 1;\nfn f() -> Int { return 0; }\n');
    testing.assert_eq(actual: exs.len(), expected: 1)?;
    testing.assert_eq(actual: exs[0].lines, expected: ['let x = 1;'])?;
    testing.assert(
        exs[0].problems.join(' ').contains('unterminated'),
        message: 'got: ${exs[0].problems.join(" | ")}',
    )?;
    return Result.Ok(void);
}

@test
fn test_empty_block() -> Result<Void, Error> {
    let ex = examples_of('/// ```\n/// ```\nfn f() -> Int { return 0; }\n')[0];
    testing.assert_eq(actual: ex.lines, expected: [])?;
    testing.assert_eq(actual: ex.text(), expected: '')?;
    testing.assert_eq(actual: ex.problems, expected: [])?;
    return Result.Ok(void);
}

@test
fn test_a_doc_with_no_fence_has_no_examples() -> Result<Void, Error> {
    testing.assert_eq(
        actual: examples_of('/// Just prose.\nfn f() -> Int { return 0; }\n').len(),
        expected: 0,
    )?;
    return Result.Ok(void);
}

@test
fn test_four_backticks_nest_a_three_backtick_fence() -> Result<Void, Error> {
    // How documentation.md shows a doc comment that itself contains a fence.
    let ex = examples_of(
        '/// ````\n/// /// ```thera\n/// /// x\n/// /// ```\n/// ````\nfn f() -> Int { return 0; }\n',
    )[0];
    testing.assert_eq(actual: ex.lines.len(), expected: 3)?;
    testing.assert_eq(actual: ex.problems, expected: [])?;
    return Result.Ok(void);
}

// --- Wrapper synthesis ---

// The synthesized source for a doc comment's first example.
fn wrapped(src: String, lib: Option<String>) -> String {
    return example_program(examples_of(src)[0], lib).source;
}

// A one-fence doc whose body is `body`, on a `fn f` below it.
fn doc_with(body: String) -> String {
    return '/// ```\n' + body.split('\n').map((l) => '/// ${l}').join('\n')
        + '\n/// ```\nfn f() -> Int { return 0; }\n';
}

@test
fn test_bare_expression_becomes_a_discard() -> Result<Void, Error> {
    // The corpus's REPL shape: no terminator, and the value is dropped. Both are
    // errors in real Thera, and `let _ = …;` answers both at once.
    testing.assert_eq(
        actual: wrapped(doc_with("'hello'.slice(1, 4)"), Option.None),
        expected: 'fn main() -> Result<Int, Error> {\n'
        + "let _ = 'hello'.slice(1, 4);\n"
        + 'return Result.Ok(0);\n}\n',
    )?;
    return Result.Ok(void);
}

@test
fn test_the_terminator_lands_before_a_trailing_comment() -> Result<Void, Error> {
    // Appending `;` at end of line would put it inside the comment.
    testing.assert(
        wrapped(doc_with("'hi'.len()   // two"), Option.None)
        .contains("let _ = 'hi'.len();   // two"),
        message: 'got: ${wrapped(doc_with("\'hi\'.len()   // two"), Option.None)}',
    )?;
    return Result.Ok(void);
}

@test
fn test_a_slash_inside_a_string_is_not_a_comment() -> Result<Void, Error> {
    // The bug that sank the line-based prototype: `'a//b/'` was truncated at the
    // `//`. Lexing rather than regexing is the whole reason this holds.
    let out = wrapped(doc_with("path.components('a//b/')"), Option.None);
    testing.assert(out.contains("let _ = path.components('a//b/');"), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_a_terminated_statement_is_left_alone() -> Result<Void, Error> {
    let out = wrapped(doc_with('let xs = [1, 2];'), Option.None);
    testing.assert(out.contains('let xs = [1, 2];'), message: 'got: ${out}')?;
    testing.assert(!out.contains('let _ ='), message: 'no discard added: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_top_level_let_is_a_statement_not_a_declaration() -> Result<Void, Error> {
    // `let` is legal in both positions; in a doc example it belongs in `main`.
    // Sorting it into the declarations is what produced 41 false failures in the
    // prototype.
    let out = wrapped(doc_with('let n = 1;\nlet m = n + 1;'), Option.None);
    testing.assert(
        out.starts_with('fn main() -> Result<Int, Error> {\nlet n = 1;'),
        message: 'got: ${out}',
    )?;
    return Result.Ok(void);
}

@test
fn test_declarations_are_hoisted_above_main() -> Result<Void, Error> {
    let out = wrapped(doc_with('struct P { let x: Int; }\nlet p = P { x: 1 };'), Option.None);
    testing.assert(
        out.starts_with('struct P { let x: Int; }\nfn main()'),
        message: 'got: ${out}',
    )?;
    testing.assert(out.contains('let p = P { x: 1 };'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_a_multi_line_declaration_stays_whole() -> Result<Void, Error> {
    // Brace depth is tracked over tokens, so the body's lines are not mistaken for
    // new top-level chunks.
    let out = wrapped(doc_with('fn g() -> Int {\n    return 1;\n}\ng()'), Option.None);
    testing.assert(
        out.starts_with('fn g() -> Int {\n    return 1;\n}\nfn main()'),
        message: 'got: ${out}',
    )?;
    testing.assert(out.contains('let _ = g();'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_a_block_with_its_own_main_gets_no_wrapper() -> Result<Void, Error> {
    let body = 'fn main() -> Result<Int, Error> {\n    return Result.Ok(0);\n}';
    testing.assert_eq(actual: wrapped(doc_with(body), Option.None), expected: body + '\n')?;
    return Result.Ok(void);
}

@test
fn test_the_documented_library_is_auto_imported() -> Result<Void, Error> {
    let out = wrapped(doc_with("path.join('a', 'b')"), Option.Some('path'));
    testing.assert(out.starts_with('import std.path;\n'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_the_auto_import_is_not_doubled() -> Result<Void, Error> {
    let out = wrapped(doc_with("import std.path;\n\npath.join('a', 'b')"), Option.Some('path'));
    testing.assert_eq(actual: count_of(out, 'import std.path;'), expected: 1)?;
    return Result.Ok(void);
}

@test
fn test_another_library_import_is_kept() -> Result<Void, Error> {
    let out = wrapped(doc_with('import std.io;\n\nio.read_all(s)?;'), Option.Some('net'));
    testing.assert(out.contains('import std.net;'), message: 'got: ${out}')?;
    testing.assert(out.contains('import std.io;'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_the_block_is_dedented() -> Result<Void, Error> {
    // A block written inside an indented `impl` method's doc keeps its relative
    // shape but loses the common margin.
    let ex = examples_of(
        '/// ```\n///     let a = 1;\n///     let b = 2;\n/// ```\nfn f() -> Int { return 0; }\n'
    )[0];
    let out = example_program(ex, Option.None).source;
    testing.assert(out.contains('\nlet a = 1;\n'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_the_line_map_points_back_at_the_body() -> Result<Void, Error> {
    // What lets a diagnostic inside the synthesized program name a real doc line.
    let p = example_program(examples_of(doc_with('let a = 1;\nlet b = 2;'))[0], Option.None);
    let lines = p.source.split('\n');
    testing.assert_eq(actual: p.line_map.len(), expected: lines.len() - 1)?;
    testing.assert_eq(actual: p.line_map[0], expected: -1)?; // `fn main() … {`
    testing.assert_eq(actual: p.line_map[1], expected: 0)?;
    testing.assert_eq(actual: p.line_map[2], expected: 1)?;
    testing.assert_eq(actual: p.line_map[3], expected: -1)?; // `return Result.Ok(0);`
    return Result.Ok(void);
}

@test
fn test_the_line_map_survives_hoisting() -> Result<Void, Error> {
    // Declarations move above `main`, so the correspondence is not an offset — the
    // explicit map is the only thing that stays right.
    let p = example_program(
        examples_of(doc_with('let n = 1;\nstruct P { let x: Int; }'))[0],
        Option.None,
    );
    let lines = p.source.split('\n');
    testing.assert_eq(actual: lines[0], expected: 'struct P { let x: Int; }')?;
    testing.assert_eq(actual: p.line_map[0], expected: 1)?; // came from body line 1
    testing.assert_eq(actual: lines[2], expected: 'let n = 1;')?;
    testing.assert_eq(actual: p.line_map[2], expected: 0)?; // ...and this from line 0
    return Result.Ok(void);
}

@test
fn test_an_empty_block_still_yields_a_program() -> Result<Void, Error> {
    let out = wrapped(doc_with(''), Option.None);
    testing.assert(out.contains('fn main()'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

// Occurrences of `needle` in `s`.
fn count_of(s: String, needle: String) -> Int {
    return s.split(needle).len() - 1;
}

@test
fn test_a_multi_line_chain_is_one_statement() -> Result<Void, Error> {
    // Parens balance at each line end, so a per-line depth check would split this
    // into three chunks and prefix the first with `let _ = ` — which is how six
    // sdk/std blocks failed before the chunker became token-driven.
    let out = wrapped(
        doc_with('let evens = iter.range(0, 10)\n    .filter((n) => n % 2 == 0)\n    .to_list();'),
        Option.None,
    );
    testing.assert(!out.contains('let _ ='), message: 'no discard: ${out}')?;
    testing.assert(out.contains('let evens = iter.range(0, 10)\n'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_adjacent_bare_expressions_stay_separate() -> Result<Void, Error> {
    // The REPL shape: two oracle lines in a row are two statements, and joining
    // them would be a syntax error. A newline ends a statement when neither side
    // wants to continue.
    let out = wrapped(doc_with('xs.get(1)\nxs.get(9)'), Option.None);
    testing.assert(out.contains('let _ = xs.get(1);'), message: 'got: ${out}')?;
    testing.assert(out.contains('let _ = xs.get(9);'), message: 'got: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_a_trailing_operator_continues_the_statement() -> Result<Void, Error> {
    let out = wrapped(doc_with('let n = 1 +\n    2;'), Option.None);
    testing.assert(!out.contains('let _ ='), message: 'no discard: ${out}')?;
    return Result.Ok(void);
}

@test
fn test_a_terminator_sharing_a_line_with_its_brace_is_not_a_new_chunk() -> Result<Void, Error> {
    // `};` closing a multi-line struct literal: the `}` ends the expression and the
    // `;` ends the statement, one token apart on one line. A chunk is sliced by
    // line, so treating that as two chunks made both claim the line and the text
    // came out twice — closing `main` early and spilling the rest to top level.
    let out = wrapped(doc_with("let r = Req {\n    model: 'haiku',\n};\nsend(r)"), Option.None);
    testing.assert_eq(actual: count_of(out, '};'), expected: 1)?;
    testing.assert(out.contains('let _ = send(r);'), message: 'got: ${out}')?;
    testing.assert_eq(actual: count_of(out, 'fn main()'), expected: 1)?;
    return Result.Ok(void);
}

@test
fn test_if_else_is_one_statement() -> Result<Void, Error> {
    // The `}` that returns to depth zero does not end the statement when `else`
    // picks it up.
    let out = wrapped(doc_with('if c {\n    a();\n} else {\n    b();\n}'), Option.None);
    testing.assert(!out.contains('let _ ='), message: 'no discard: ${out}')?;
    testing.assert_eq(actual: count_of(out, 'fn main()'), expected: 1)?;
    return Result.Ok(void);
}
