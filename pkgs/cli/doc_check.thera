//! Compile-checking the code examples in a file's doc comments.
//!
//! Import as: `import 'doc_check'`; usage: `doc_check.check_file(path, src, root)`.
//!
//! Each verified fence (see `docs.thera`) is rendered as a source file and
//! type-checked against the documented file's own import closure; the diagnostics
//! come back mapped onto the doc comment's real lines.
//!
//! **This pass writes no analysis state.** That matters more than it looks: the
//! session's incrementality (scale.md item 2) rests on every layer being a pure
//! function of (file text, dependency surfaces) with a cache invalidated over the
//! reverse-import cone. A doc example is a *derived* artifact — synthetic source at
//! a path no one imports — so letting it into that machinery would corrupt it. In
//! particular this pass does **not** go through `Session.check`, which would:
//!
//! - write the synthetic file into `parse_cache`, and
//! - merge the synthetic file's import edges into `import_graph`, putting a phantom
//!   node in the invalidation cone of every library the example imports.
//!
//! Instead it calls `loader.load_imports` and `checker.check` directly. Those are
//! pure functions of their arguments; the caches they are *handed* are keyed by the
//! canonical path of real files, so sharing them across examples is what makes this
//! fast (one prelude parse for a whole corpus) without making it stateful. The
//! result is that doc-example diagnostics for a file are a pure function of (its
//! text, its dependency surfaces) — the very same key its check verdict already
//! has, so they can later be cached and evicted right alongside it.

import 'checker/checker';
import 'diagnostic';
import 'docs';
import 'lexer/lexer';
import 'loader';
import 'parser/parser';
import 'source';

import std.path;

/// The rule name every diagnostic from this pass carries.
///
/// It is **not** suppressable the usual way, and that is a property of the doc
/// model rather than an oversight: the standard `// ignore: <rule>` comment is a
/// `//` line, and a `//` line inside a doc comment ends the doc run it sits in. The
/// opt-out is the fence attribute — ` ```thera,no_check ` — which has the better
/// property anyway of being visible in the rendered doc, where the person deciding
/// whether to trust the example can see that nobody checked it.
pub let RULE: String = 'doc-example';

/// Compile-check every verified doc example in `source`, which lives at `path`.
///
/// Returns one **`doc-example` warning** per problem, attributed to `path` and
/// pointing at the doc-comment line the failure came from. Malformed fences (an
/// unknown attribute, an unterminated fence) are reported here too — one channel
/// for everything the reader of that doc comment should know.
///
/// **Warning, never error.** A doc comment is not the program, and a stale example
/// must not stop unrelated code from compiling or running — the failure mode where
/// an agent cannot build its project because a library's doc comment drifted is
/// worse than the drift. See docs/documentation.md § `thera check`.
///
/// The three caches mirror `loader.load_imports`: pass a session's to share the
/// import closure across a batch, or omit them for a self-contained run.
pub fn check_file(
    path: String,
    source: String,
    sdk_root: Option<String>,
    named parse_cache: Map<String, loader.ParsedFile> = [:],
    named overlays: Map<String, String> = [:],
    named surface_cache: Map<String, loader.FileSurface> = [:],
) -> List<diagnostic.Diagnostic> {
    let canon = loader.canonical_path(path);
    let lex = lexer.tokenize(source, file: canon);
    let runs = docs.doc_runs(lex.comments);
    // Most files in a tree hold no fenced example at all, and this pass runs over
    // every file `check` was pointed at — so answer the cheap question first and
    // leave before parsing anything. Lexing alone settles it.
    if !has_examples(runs) {
        return [];
    }
    // Only now is the primary parsed, and only to keep the pipeline honest about
    // broken files: a file that does not parse has no trustworthy doc comments
    // either, so it reports nothing rather than a list derived from a guess.
    if parser.parse_tokens(lex.tokens).errors.len() != 0 {
        return [];
    }

    let out: List<diagnostic.Diagnostic> = [];
    let library = documented_library(canon, sdk_root);
    for doc in runs {
        for ex in docs.doc_examples(doc) {
            for p in ex.problems {
                out.push(diagnostic.warning(p, ex.span, RULE));
            }
            if !ex.verified {
                continue;
            }
            for d in check_example(
                doc,
                ex,
                library,
                canon,
                sdk_root,
                parse_cache,
                overlays,
                surface_cache,
            ) {
                out.push(d);
            }
        }
    }
    return out;
}

// Whether any run holds a fence this pass has something to say about — a verified
// example, or a malformed one worth reporting.
fn has_examples(runs: List<docs.DocComment>) -> Bool {
    for doc in runs {
        for ex in docs.doc_examples(doc) {
            if ex.verified || ex.problems.len() != 0 {
                return true;
            }
        }
    }
    return false;
}

// Check one example and map its diagnostics back onto the doc comment.
fn check_example(
    doc: docs.DocComment,
    ex: docs.DocExample,
    library: Option<String>,
    host: String,
    sdk_root: Option<String>,
    parse_cache: Map<String, loader.ParsedFile>,
    overlays: Map<String, String>,
    surface_cache: Map<String, loader.FileSurface>,
) -> List<diagnostic.Diagnostic> {
    let prog = docs.example_program(ex, library);
    // A path beside the documented file, so `std.*` and relative imports resolve
    // exactly as they would for a real sibling.
    //
    // **Unique per example**, which is not cosmetic. `load_imports` derives a
    // surface for every file in the closure *including the primary* and stores it
    // in the cache it was handed, so a virtual path reused across the examples in
    // one directory would hand example two the namespaces of example one — a block
    // importing `std.iter` silently resolving against a block that did not. That is
    // the failure mode shared analysis state invites, and the reason the entry is
    // also evicted below.
    let virtual = path.join(
        path.dirname(host),
        '_doc_example.${path.stem(host)}.${ex.span.line}.thera',
    );
    let lex = lexer.tokenize(prog.source, file: virtual);
    let parsed = parser.parse_tokens(lex.tokens);
    let errors: List<diagnostic.Diagnostic> = [];
    for e in lex.errors {
        errors.push(e);
    }
    for e in parsed.errors {
        errors.push(e);
    }
    if errors.len() == 0 {
        let loaded = loader.load_imports(
            virtual,
            parsed.program,
            sdk_root,
            parse_cache: parse_cache,
            overlays: overlays,
            surface_cache: surface_cache,
        );
        // Leave the shared cache exactly as it was found: the synthetic file's own
        // surface is a derived artifact keyed by a path no file occupies, and
        // letting it accumulate is both a leak and a trap for a later lookup. The
        // real files it pulled in stay cached — that sharing is the point.
        match surface_cache.remove(loader.canonical_path(virtual)) {
            Some(_) => void,
            None => void,
        }
        let result = checker.check(
            parsed.program,
            loaded.programs,
            loaded.file_namespaces,
            loaded.file_bare_surface,
        );
        // Errors only. A doc example is a fragment, and warnings about fragments
        // (`unused-import` above all) are noise the author cannot act on without
        // making the example worse. The rot class this catches is compile failure.
        for e in result.errors {
            if diagnostic.is_error(e) {
                errors.push(e);
            }
        }
    }

    // **One diagnostic per example, not one per error.** A block that is not Thera
    // at all — the case the implicit-Thera default newly exposes — produces a
    // parse-error cascade twenty lines long, which buries every other block in the
    // report. The first failure is the actionable one and the rest follow from it;
    // this is the same anti-cascade contract the parser already keeps
    // (docs/frontend.md).
    let Some(first) = errors.first() else {
        return [];
    };
    return [
        diagnostic.warning(
            'doc example does not compile: ${first.message}',
            origin(doc, ex, prog, first.span.line),
            RULE,
        ),
    ];
}

// The doc-comment line a synthesized line came from. Falls back to the opening
// fence for a line the wrapper invented (its `fn main`, its trailing `return`) —
// those are ours, not the author's, so the fence is the honest thing to point at.
fn origin(
    doc: docs.DocComment,
    ex: docs.DocExample,
    prog: docs.ExampleProgram,
    synth_line: Int,
) -> source.SourceSpan {
    let body_line = prog.line_map.get(synth_line - 1).unwrap_or(-1);
    if body_line < 0 {
        return ex.span;
    }
    return doc.line_span(ex.fence_index + 1 + body_line);
}

// The library a file belongs to, spelled exactly as an import names it — `std.path`
// for `sdk/std/path/path.thera`, `std.http.server` for
// `sdk/std/http/server/server.thera`, `github` for `pkgs/github/client.thera`. It
// is auto-imported into that file's examples under its own namespace (the last
// dotted segment), so a block may write `path.join(…)`, `server.Router` or
// `github.from_env()` with no import line — which is what the corpus assumes
// throughout.
//
// Two spellings, because there are two kinds of library. Inside the SDK the import
// is absolute and the path under `std/` *is* the dotted name. Everywhere else a
// directory library is named by its own directory, which resolves relatively — and
// since the synthetic file is a sibling of the documented one, that is exactly the
// name its examples already write.
fn documented_library(canon: String, sdk_root: Option<String>) -> Option<String> {
    if let Some(std) = std_relative(canon, sdk_root) {
        return Option.Some(std);
    }
    // A directory library outside the SDK. `is_directory_library` is the loader's
    // own barrel test, so a directory that merely holds `.thera` files
    // (`examples/`, `tests/`) correctly answers None rather than synthesizing an
    // import that cannot resolve.
    let dir = path.dirname(canon);
    if loader.is_directory_library(dir) {
        return Option.Some(path.basename(dir));
    }
    return Option.None;
}

// The dotted `std.*` name for a file under the SDK's std root, if it is one.
fn std_relative(canon: String, sdk_root: Option<String>) -> Option<String> {
    let Some(root) = sdk_root else {
        return Option.None;
    };
    let Some(std) = loader.std_root(root) else {
        return Option.None;
    };
    let prefix = loader.canonical_path(std) + '/';
    if !canon.starts_with(prefix) {
        return Option.None;
    }
    let rest = canon.slice(prefix.len(), canon.len());
    let parts = rest.split('/');
    if parts.len() < 2 {
        return Option.None; // a loose file directly under `std/`
    }
    // **The whole directory chain, not its first segment.** A library that fronts
    // more than one public surface nests — `std.http` is `http/http.thera` plus
    // `http/server/`, `http/sse/` and `http/common/` — so a doc comment in
    // `http/server/server.thera` documents `std.http.server` and its examples write
    // `server.Router`. Taking only `http` left `server` undefined, and the
    // resulting diagnostics blamed whatever the block did next.
    let dirs = parts.slice(0, parts.len() - 1);
    // Never `std.core`: it is the prelude, already ambient and used unqualified, so
    // importing it would be both redundant and an unused import.
    if dirs[0] == 'core' {
        return Option.None;
    }
    return Option.Some('std.' + dirs.join('.'));
}

/// How many verified examples `source` holds — the denominator for a survey.
pub fn count_examples(source: String) -> Int {
    let mut n = 0;
    for doc in docs.doc_runs(lexer.tokenize(source).comments) {
        for ex in docs.doc_examples(doc) {
            if ex.verified {
                n = n + 1;
            }
        }
    }
    return n;
}
