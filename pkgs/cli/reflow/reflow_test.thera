// Tests for the line-breaking pass. These work on the *break-offset* level rather
// than on rendered text — the rendered shapes are pinned end to end in
// `fmt_test.thera`, so these pin the decisions behind them: which group is chosen,
// and when nothing should happen at all.

import std.testing;

import 'reflow' as _;

// The offsets `break_edits` picks for `src` at `width`.
fn breaks_for(_ src: String, _ width: Int) -> List<Int> {
    let out: List<Int> = [];
    for e in break_edits(src, width) {
        out.push(e.offset);
    }
    return out;
}

@test
fn no_breaks_when_every_line_fits() -> Result<Void, Error> {
    let src = 'fn f() {\n    g(a, b);\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 100).len(), expected: 0);
}

@test
fn no_breaks_without_a_splittable_group() -> Result<Void, Error> {
    // The only over-width line is a string literal with no bracket on it. The
    // enclosing block covers the line but its break points are already taken, so
    // there is nothing to give.
    let src = 'fn f() {\n    let s = \'aaaaaaaaaaaaaaaaaaaaaaaaaaaa\';\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 20).len(), expected: 0);
}

@test
fn no_breaks_for_an_empty_group() -> Result<Void, Error> {
    // `f()` has no content, so breaking it would add a line without shortening
    // anything — the long line is left alone.
    let src = 'fn f() {\n    let some_quite_long_name = h();\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 20).len(), expected: 0);
}

@test
fn breaks_an_over_width_call_at_every_separator() -> Result<Void, Error> {
    // `g(alpha, beta)` → after `(`, after the comma, and before `)`.
    let src = 'fn f() {\n    g(alpha, beta);\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 18).len(), expected: 3);
}

@test
fn offsets_are_ascending_and_unique() -> Result<Void, Error> {
    let src = 'fn f() {\n    g(alpha, beta, gamma, delta);\n}\n';
    let offs = breaks_for(src, 18);
    let mut prev = -1;
    let mut ok = offs.len() > 0;
    for o in offs {
        if o <= prev {
            ok = false;
        }
        prev = o;
    }
    return testing.assert(ok, message: 'break offsets must be ascending and unique');
}

@test
fn skips_a_break_that_already_exists() -> Result<Void, Error> {
    // The call is already fully split *and* carries its trailing comma, so there is
    // nothing left to add — this is what makes the reflow loop terminate.
    let src = 'fn f() {\n    g(\n        alpha,\n        beta,\n    );\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 10).len(), expected: 0);
}

@test
fn adds_the_trailing_comma_an_already_split_list_lacks() -> Result<Void, Error> {
    // Split by hand without a trailing comma: one edit, the comma alone — no new
    // line break, since the layout is already right.
    let src = 'fn f() {\n    g(\n        alpha,\n        beta\n    );\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 100).len(), expected: 1);
}

@test
fn skips_a_group_that_cannot_shorten_the_line() -> Result<Void, Error> {
    // The call's only break on the over-width line is the one before its closer, so
    // splitting it would leave the line all but as long — and one level further
    // indented. Nothing else on the line can break, so nothing does.
    let src = 'fn f() {\n    g(\n        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa + b);\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 20).len(), expected: 0);
}

@test
fn never_breaks_inside_a_generic_argument_list() -> Result<Void, Error> {
    // The comma in `Map<String, …>` sits in no bracket of its own — `<`/`>` are
    // ordinary operator tokens — so it would otherwise read as a separator of the
    // enclosing block, and `let m: Map<String,⏎List<Int>> = [:];` would look like a
    // legal split.
    let src = 'fn f() {\n    let m: Map<String, LongTypeNameeeeeeeeeee> = [:];\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 30).len(), expected: 0);
}

@test
fn ignores_source_that_does_not_lex() -> Result<Void, Error> {
    // An unterminated string: no tokens to trust, so no breaks are proposed and the
    // caller keeps the original text.
    let src = 'fn f() {\n    let s = \'unterminated;\n}\n';
    return testing.assert_eq(actual: breaks_for(src, 10).len(), expected: 0);
}
