//! Line breaking for `thera fmt` — the half of the formatter that decides where
//! the breaks go, driven by `fmt.thera`'s `format_source`.
//!
//! The unit of breaking is a **bracket group**: a matched `(`/`[`/`{` pair. Its
//! break points are the positions a newline may be inserted — after the opener,
//! after each top-level `,`/`;`, and before the closer — chosen
//! **all-or-nothing**, so a split list puts one element per line rather than
//! packing as many as fit (packing makes one added element rewrap its
//! neighbours, which is the diff churn this work exists to remove). The one
//! exception is a `[…]` of plain scalars, which is filled to the margin.
//!
//! Two directions. **Splitting** relieves a line over the margin, choosing
//! **outermost-first** — the widest group covering the line — so that a split
//! reveals structure rather than burying it. Only among the groups whose split
//! would *pay for itself*, though: one that would leave the line over the margin
//! anyway has relieved nothing, and taking it merely indents the line further.
//! That is what makes a call hug a multi-line argument instead of prying itself
//! apart around it. **Joining** ([join_spans]) collapses a multi-line group that
//! would fit, so layout follows the token stream rather than how the code was
//! typed — held back where the group holds a line comment or a multi-line
//! string.
//!
//! Nearly **token-only**: the parser desugars `if let` / `let … else` /
//! `else if` into `match` (docs/roadmap.md → Compiler & front-end), so a
//! syntax-driven formatter would have to reverse that, while tokens carry what
//! the user actually wrote. The AST is consulted for exactly two things, both
//! *classification* rather than rendering — whether a `{` opens a struct literal
//! (see groups.thera) and which `<`/`>` are generic delimiters. A break can only
//! land at a bracket or separator, so it can never split a string literal or
//! separate the adjacent `>` `>` the parser reads as a shift operator.
//!
//! A comma list gains a trailing comma when it splits and loses one when it
//! joins — the single place the formatter edits tokens rather than whitespace,
//! and safe because the grammar makes that comma optional everywhere.
import std.char;

import '../lexer' as _; // tokenize, Token, TokenKind
import '../source' as _; // Comment
import '../parser/parser';
import 'groups';

// The margin `thera fmt` targets. Provisional — see docs/roadmap.md.
pub const DEFAULT_WIDTH: Int = 100;

// A matched bracket pair and the offsets at which it may be broken.
struct Pair {
    let open: Int; // offset of the opening bracket
    let close: Int; // offset of the closing bracket
    let open_line: Int; // 1-based line of each end; equal iff the pair is
    let close_line: Int; // entirely on one line (i.e. not already broken)
    let kind: TokenKind; // the opening bracket's kind, which sets the default mode
    // Whether a `,` sits directly before the closer. A whitespace-only formatter
    // cannot delete it, and joining would yield `[a, b, ]`, so a trailing comma
    // reads as "keep this split" — the same meaning Prettier and Dart give it.
    let trailing_comma: Bool;
    // Whether the group holds at least one top-level `,` — i.e. it is a comma
    // list rather than a grouping paren or a statement block. Only such a group
    // may be given a trailing comma when it splits: `(a + b,)` is a parse error.
    let has_comma: Bool;
    let breaks: List<Int>; // newline-insertion offsets, ascending
}

// Text to insert at an offset: `'\n'` for a plain break, `',\n'` for a break that
// also closes a comma list, or `','` alone to give an already-split comma list
// the trailing comma it lacks.
//
// The comma is what makes adding an element later a one-line diff instead of
// two, and it is safe to add only where a top-level `,` already exists — a
// grouping paren rejects it (`(a + b,)` is a parse error), and a statement block
// is `;`-separated.
pub struct BreakEdit {
    let offset: Int;
    let text: String;
}

// A bracket pair whose interior line breaks should collapse to single spaces.
pub struct FlatSpan {
    let start: Int; // offset of the opening bracket
    let end: Int; // offset of the closing bracket
}

// The groups that should be joined onto one line: multi-line groups in `Fit`
// mode whose content fits within `width`. Disjoint and ascending — an outer
// group that joins subsumes its children, so only the outermost is returned.
//
// Empty when the source doesn't lex or parse: the join decision needs the AST to
// tell a struct literal's `{` from a block's (see groups.thera), and without it
// the safe answer is to change nothing.
//
// A group is held back — left split however well it would fit — when it contains
// a line comment (joining would swallow the code after it) or a multi-line string
// literal (whose newlines are content, not layout). A trailing comma is no longer
// a blocker: the join deletes it, since `g(a, b, )` is not an acceptable result
// and the grammar makes the comma optional in every list.
pub fn join_spans(_ source: String, _ width: Int) -> List<FlatSpan> {
    let lex = tokenize(source);
    if lex.errors.len() > 0 {
        return [];
    }
    let parsed = parser.parse_tokens(lex.tokens);
    if parsed.errors.len() > 0 {
        return [];
    }
    let fit_braces = groups.fit_brace_offsets(parsed.program, lex.tokens);
    let chars = source.chars();
    let starts = line_start_offsets(chars);

    let candidates: List<Pair> = [];
    for p in bracket_pairs(lex.tokens, parsed.generic_delims) {
        if p.open_line == p.close_line {
            continue; // already on one line
        }
        if !is_fit(p, fit_braces) {
            continue;
        }
        if spans_comment(lex.comments, p) || spans_multiline_string(lex.tokens, chars, p) {
            continue;
        }
        let from = line_start_at(starts, p.open_line);
        let to = line_end_at(starts, chars, p.close_line);
        if flat_width(chars, from, to) <= width {
            candidates.push(p);
        }
    }

    let out: List<FlatSpan> = [];
    for p in candidates {
        if !contained_in_another(p, candidates) {
            out.push(FlatSpan { start: p.open, end: p.close });
        }
    }
    return out;
}

// `(` and `[` join when they fit; `{` does not, unless it opens a struct
// literal. A statement block, `match` body, or declaration body stays expanded
// however short it is.
fn is_fit(_ p: Pair, _ fit_braces: List<Int>) -> Bool {
    return match p.kind {
        LParen => true,
        LBracket => true,
        LBrace => fit_braces.contains(p.open),
        _ => false,
    };
}

fn spans_comment(_ comments: List<Comment>, _ p: Pair) -> Bool {
    for c in comments {
        if c.span.offset > p.open && c.span.offset < p.close {
            return true;
        }
    }
    return false;
}

fn spans_multiline_string(_ tokens: List<Token>, _ chars: List<Int>, _ p: Pair) -> Bool {
    for t in tokens {
        if t.kind == TokenKind.StringLiteral && t.span.offset > p.open
            && t.span.offset < p.close {
            let stop = t.span.offset + t.span.length;
            let mut i = t.span.offset;
            while i < stop && i < chars.len() {
                if chars[i] == char.LF {
                    return true;
                }
                i = i + 1;
            }
        }
    }
    return false;
}

// The width of `[from, to)` once its interior line breaks collapse to single
// spaces — i.e. the width of the line joining would produce. Leading indentation
// counts; it survives the join.
fn flat_width(_ chars: List<Int>, _ from: Int, _ to: Int) -> Int {
    let mut w = 0;
    let mut pending_space = false;
    let mut started = false;
    let mut i = from;
    while i < to && i < chars.len() {
        let c = chars[i];
        if c == char.LF || c == char.SPACE || c == char.TAB || c == char.CR {
            if started {
                pending_space = true;
            } else {
                w = w + 1; // the opening line's indentation
            }
        } else {
            if pending_space {
                w = w + 1;
                pending_space = false;
            }
            w = w + 1;
            started = true;
        }
        i = i + 1;
    }
    return w;
}

// Offsets at which each 1-based line starts; index 0 is unused.
fn line_start_offsets(_ chars: List<Int>) -> List<Int> {
    let out: List<Int> = [];
    out.push(0);
    out.push(0);
    let mut i = 0;
    while i < chars.len() {
        if chars[i] == char.LF {
            out.push(i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn line_start_at(_ starts: List<Int>, _ line: Int) -> Int {
    return starts.get(line).unwrap_or(0);
}

fn line_end_at(_ starts: List<Int>, _ chars: List<Int>, _ line: Int) -> Int {
    return starts.get(line + 1).unwrap_or(chars.len() + 1) - 1;
}

// The offsets in `source` at which inserting a newline would relieve an
// over-width line, ascending. Empty when nothing can be improved — a line with
// no splittable group on it (one long string literal, a long trailing comment)
// is left alone, as is a source that doesn't lex.
//
// One round: each over-width line contributes at most one group. The caller
// re-formats and calls again until this returns empty, so a line needing two
// levels of splitting gets them on successive rounds.
pub fn break_edits(_ source: String, _ width: Int) -> List<BreakEdit> {
    let lex = tokenize(source);
    if lex.errors.len() > 0 {
        return [];
    }
    // The parse is needed only for its generic-delimiter side channel: a comma
    // inside `Map<String, Site>` is not a top-level comma of the enclosing group,
    // and mistaking it for one puts a stray `,` in a statement block.
    let parsed = parser.parse_tokens(lex.tokens);
    if parsed.errors.len() > 0 {
        return [];
    }
    let pairs = bracket_pairs(lex.tokens, parsed.generic_delims);
    let chars = source.chars();
    let fixed = verbatim_lines(lex.tokens, chars, width);
    let starts = line_start_offsets(chars);
    let out: List<BreakEdit> = [];
    for line in over_width_lines(source, width) {
        if fixed.has(line) {
            continue;
        }
        let from = line_start_at(starts, line);
        let to = line_end_at(starts, chars, line);
        for e in group_breaks_for_line(pairs, line, from, to, chars, width) {
            out.push(e);
        }
    }
    // Independently of width: a comma list broken at *some* of its break points
    // is broken at all of them, and ends in a trailing comma. All-or-nothing was
    // already how a group splits when the margin selects it; stating it as an
    // invariant is what makes the split form a function of the tokens rather than
    // of how the code arrived. Without it a hand-wrapped
    // `add_error(errors,⏎ '…',⏎ span);` whose message is too long to ever fit
    // keeps that shape forever, while the same call with a shorter message comes
    // out one argument per line — layout depending on how long an argument
    // happens to be, which is author-dependent layout in another guise.
    //
    // "Some of its *own* breaks taken", not "spans several lines": a group is
    // also multi-line when an element is, and there none of its own breaks are
    // taken. That distinction is what lets a call hug a multi-line argument —
    // `.subcommand(cli.Command.new('test')⏎ .about(…))` and `f(a, g(⏎ x,⏎ ))`
    // leave every break of the outer group untaken, and both stay as written.
    //
    // Two exemptions. A group holding a line comment is left exactly as it is: a
    // break inserted before the comment would swallow the code after it. And a
    // scalar `[…]` is packed to the margin by design ([fill_breaks]), so its
    // half-taken breaks are the intended layout, not a half-finished split.
    for p in pairs {
        if !p.has_comma {
            continue; // a grouping paren or a `;` block, not a comma list
        }
        let left = usable_breaks(p, chars);
        if left.len() == p.breaks.len() {
            continue; // none of its own breaks taken: flat, or hugging
        }
        if is_scalar_list(p, chars) || spans_comment(lex.comments, p) {
            continue;
        }
        // With no break left this contributes the trailing comma alone, which is
        // how an already-split list that lacks one acquires it.
        for e in to_edits(p, left, chars) {
            out.push(e);
        }
    }
    // A partially-broken group's later break points lie on lines below the one
    // that selected it, so two over-width lines can contribute interleaved
    // offsets. The caller inserts left to right, so normalize here.
    return sorted_unique(out);
}

// Ascending, duplicates removed.
// Ascending, with edits at the same offset **merged** rather than one dropped.
// A trailing comma and the closer's own line break routinely coincide — `gamma)`
// has no space between them — and the result must be `,\n`, not one or the other.
fn sorted_unique(_ xs: List<BreakEdit>) -> List<BreakEdit> {
    let out: List<BreakEdit> = [];
    for x in xs.sort((a, b) => a.offset < b.offset) {
        if out.len() > 0 && out[out.len() - 1].offset == x.offset {
            let merged = merge_text(out[out.len() - 1].text, x.text);
            out[out.len() - 1] = BreakEdit { offset: x.offset, text: merged };
        } else {
            out.push(x);
        }
    }
    return out;
}

// The comma always precedes the break.
fn merge_text(_ a: String, _ b: String) -> String {
    let mut t = '';
    if a.contains(',') || b.contains(',') {
        t = ',';
    }
    if a.contains('\n') || b.contains('\n') {
        t = t + '\n';
    }
    return t;
}

// Match every bracket in the token stream, recording each pair's break points.
// An unbalanced stream (which a clean lex shouldn't produce) yields the pairs
// matched so far rather than failing.
fn bracket_pairs(_ tokens: List<Token>, _ delims: parser.GenericDelims) -> List<Pair> {
    let out: List<Pair> = [];
    // Parallel stacks: the open token, and the break offsets accumulated for it.
    let open_toks: List<Token> = [];
    let open_breaks: List<List<Int>> = [];
    let open_commas: List<Bool> = []; // did this group see a top-level `,`?
    let mut prev_kind = TokenKind.Eof; // the kind before the current token
    let mut angle = 0; // nesting depth inside generic `<…>`
    for t in tokens {
        if delims.opens.has(t.span.offset) {
            angle = angle + 1;
        } else if delims.closes.has(t.span.offset) {
            angle = angle - 1;
        }
        if is_opener(t.kind) {
            open_toks.push(t);
            // A newline may follow the opener itself.
            let bs: List<Int> = [];
            bs.push(t.span.offset + 1);
            open_breaks.push(bs);
            open_commas.push(false);
        } else if is_closer(t.kind) {
            // The stacks are maintained in step, so the breaks pop succeeds
            // whenever the token pop does.
            if let Some(ot) = open_toks.pop() {
                let bs = open_breaks.pop().unwrap_or([]);
                let had_comma = open_commas.pop().unwrap_or(false);
                if matches(ot.kind, t.kind) {
                    // …and one before the closer, so it lands on its own line.
                    bs.push(t.span.offset);
                    out.push(Pair {
                        open: ot.span.offset,
                        close: t.span.offset,
                        open_line: ot.span.line,
                        close_line: t.span.line,
                        kind: ot.kind,
                        trailing_comma: prev_kind == TokenKind.Comma,
                        has_comma: had_comma,
                        breaks: bs,
                    });
                }
            }
        } else if t.kind == TokenKind.Comma || t.kind == TokenKind.Semi {
            // A separator breaks the group it sits *directly* in, so it is
            // recorded against the innermost open bracket only — and only when
            // it is outside any generic argument list. `Map<String, Site>` has
            // no bracket of its own here (`<`/`>` are ordinary operator tokens),
            // so its comma would otherwise be read as the enclosing block's:
            // enough to mark the block a comma list and earn it a stray `,`, and
            // enough to make `let names: Map<String,⏎List<NameSite>> = [:];` a
            // legal-looking split.
            if open_breaks.len() > 0 && angle == 0 {
                open_breaks[open_breaks.len() - 1].push(t.span.offset + 1);
                if t.kind == TokenKind.Comma {
                    open_commas[open_commas.len() - 1] = true;
                }
            }
        }
        prev_kind = t.kind;
    }
    return out;
}

// The 1-based lines a break cannot bring under the margin, because a multi-line
// string literal fixes their content: every line one touches is emitted verbatim
// (see fmt.thera's `LineInfo.verbatim`), so its interior and closing lines are
// untouchable. Its *opening* line can still shed the code before the quote — the
// break leaves the literal starting at column 0 — so that line counts as fixed
// only when the literal's own first line already exceeds the margin.
//
// Excluding these matters more than the line count suggests. An unrelievable
// line is covered by *every* enclosing group, so the outermost one is picked and
// split each round, and the line stays over-width regardless: a `.details('…')`
// argument spanning twenty lines used to pry apart the entire builder chain
// around it, one group per round, without ever shortening the line it was
// chasing.
fn verbatim_lines(_ tokens: List<Token>, _ chars: List<Int>, _ width: Int) -> Set<Int> {
    let out: Set<Int> = Set.new();
    for t in tokens {
        if t.kind != TokenKind.StringLiteral {
            continue;
        }
        let stop = t.span.offset + t.span.length;
        let mut line = t.span.line;
        let mut first = 0; // width of the literal from its quote to its first LF
        let mut i = t.span.offset;
        while i < stop && i < chars.len() {
            if chars[i] == char.LF {
                line = line + 1;
                out.add(line);
            } else if line == t.span.line {
                first = first + 1;
            }
            i = i + 1;
        }
        if line > t.span.line && first > width {
            out.add(t.span.line);
        }
    }
    return out;
}

// The 1-based line numbers whose rendered width exceeds `width`.
fn over_width_lines(_ source: String, _ width: Int) -> List<Int> {
    let out: List<Int> = [];
    let mut line = 1;
    for text in source.lines() {
        if text.len() > width {
            out.push(line);
        }
        line = line + 1;
    }
    return out;
}

// The breaks to take for an over-width `line`, whose text is `chars[from..to)`:
// those of the widest group covering it that is contained in no other candidate
// — outermost first, so the split reveals structure rather than burying it, and
// widest because that is the split most likely to bring the line under the
// margin.
//
// A group already broken across lines is still a candidate: its opening line can
// be over-width because only *some* of its elements were split off (a parameter
// list with two params on line one and the third below). Taking all of its
// remaining break points is what makes splitting all-or-nothing rather than
// leaving a half-packed list.
//
// Empty when the line holds no usable group — one long string literal, a long
// trailing comment, or only groups already fully broken. Those lines are left
// alone; no line breaking can shorten them.
fn group_breaks_for_line(
    _ pairs: List<Pair>,
    _ line: Int,
    _ from: Int,
    _ to: Int,
    _ chars: List<Int>,
    _ width: Int,
) -> List<BreakEdit> {
    let on_line: List<Pair> = [];
    for p in pairs {
        // Any group covering the line is a candidate, not just one opening on
        // it: an over-width line is often a *continuation* of a group broken
        // further up (the tail of a split argument list), whose remaining
        // separators are the breaks that relieve it. `close > open + 1` skips an
        // empty pair — breaking `f()` adds a line without shortening anything.
        if p.open_line <= line && p.close_line >= line && p.close > p.open + 1 {
            on_line.push(p);
        }
    }
    // Rank the groups before asking which is outermost, because outermost-first
    // would otherwise hand the line to one that cannot help it. A split cuts the
    // line at the group's first break on it and pushes the rest down, so the head
    // left behind is the width the line actually ends up with — and a group whose
    // head is still over the margin has relieved nothing.
    //
    // Preferring the groups that clear the margin is what makes a call hug its
    // last argument instead of prying itself apart around it. In a builder chain
    // an over-width `.positional('target', help: '…')` is covered both by its own
    // parentheses and by the enclosing `.subcommand(…)`, whose only break on that
    // line is the one before its closer — splitting it sheds a `)` and nothing
    // else, while `.positional` breaks where it counts. Preferring the latter
    // leaves the chain's shape intact.
    //
    // When no group can clear the margin the line is irreducible — a long
    // single-line string literal is the usual reason — and nothing is split for
    // it. That costs no canonicity: a comma list that is already broken is
    // completed by the all-or-nothing pass in [break_edits] regardless of width,
    // so what is declined here is only the *pointless* split of a group that
    // cannot help.
    let usable: List<Pair> = [];
    for p in on_line {
        // The group still splits all-or-nothing once chosen — every remaining
        // break is taken, not just the ones on this line.
        let breaks = usable_breaks(p, chars);
        let head = head_width(breaks, from, to);
        if head >= 0 && head <= width {
            usable.push(Pair {
                open: p.open,
                close: p.close,
                open_line: p.open_line,
                close_line: p.close_line,
                kind: p.kind,
                trailing_comma: p.trailing_comma,
                has_comma: p.has_comma,
                breaks: breaks,
            });
        }
    }

    // Outermost first, widest among those.
    let mut best: List<BreakEdit> = [];
    let mut best_width = -1;
    for p in usable {
        if contained_in_another(p, usable) {
            continue;
        }
        if p.close - p.open > best_width {
            let offsets = if is_scalar_list(p, chars) {
                fill_breaks(p, chars, width)
            } else {
                p.breaks
            };
            best = to_edits(p, offsets, chars);
            best_width = p.close - p.open;
        }
    }
    return best;
}

// Turn chosen break offsets into edits. The break that puts the closer on its own
// line also carries the trailing comma, where the group is a comma list that
// doesn't already end in one.
fn to_edits(_ p: Pair, _ offsets: List<Int>, _ chars: List<Int>) -> List<BreakEdit> {
    let out: List<BreakEdit> = [];
    if p.has_comma && !p.trailing_comma {
        out.push(BreakEdit { offset: end_of_last_element(chars, p), text: ',' });
    }
    for o in offsets {
        out.push(BreakEdit { offset: o, text: '\n' });
    }
    return out;
}

// Whether this is a `[…]` of plain scalars — every element a single bare token,
// no call, no nested collection, no operator. Such a list is packed rather than
// split one-per-line: a byte fixture of 90 numbers does not want 90 lines.
fn is_scalar_list(_ p: Pair, _ chars: List<Int>) -> Bool {
    if p.kind != TokenKind.LBracket || p.breaks.len() < 4 {
        return false; // not a list, or too short for packing to matter
    }
    let mut i = 0;
    while i + 1 < p.breaks.len() {
        if !is_scalar_element(chars, p.breaks[i], p.breaks[i + 1]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// An element is scalar when its text is one unbroken run — no bracket (so no
// call or nested literal) and no interior space (so no operator or `key: value`).
//
// A blank segment passes. The only way to get one is a trailing comma, whose
// segment runs from the comma to the closer with nothing in between, and that is
// punctuation rather than an element — rejecting it would make every scalar list
// that had already been given its trailing comma look non-scalar, which is to
// say every one the reflow pass has already touched.
fn is_scalar_element(_ chars: List<Int>, _ from: Int, _ to: Int) -> Bool {
    let mut seen = false;
    let mut i = from;
    while i < to && i < chars.len() {
        let c = chars[i];
        if c == LPAREN || c == LBRACKET || c == LBRACE || c == COLON {
            return false;
        }
        if is_layout(c) {
            if seen {
                return false; // a space *inside* the element
            }
        } else if c != COMMA {
            seen = true;
        }
        i = i + 1;
    }
    return true;
}

// Break points that pack a scalar list into rows within `width`, rather than one
// element per line: after the opener, before each element that would overflow the
// current row, and before the closer.
fn fill_breaks(_ p: Pair, _ chars: List<Int>, _ width: Int) -> List<Int> {
    let indent = line_indent_of(chars, p.open) + 4;
    let out: List<Int> = [];
    out.push(p.breaks[0]);
    let mut col = indent;
    let mut i = 0;
    while i + 1 < p.breaks.len() {
        let w = trimmed_width(chars, p.breaks[i], p.breaks[i + 1]);
        if col > indent && col + w > width {
            out.push(p.breaks[i]);
            col = indent;
        }
        col = col + w + 1; // the element, plus the space after its comma
        i = i + 1;
    }
    out.push(p.breaks[p.breaks.len() - 1]);
    return out;
}

// The width of `[from, to)` ignoring surrounding whitespace.
fn trimmed_width(_ chars: List<Int>, _ from: Int, _ to: Int) -> Int {
    let mut a = from;
    while a < to && a < chars.len() && is_layout(chars[a]) {
        a = a + 1;
    }
    let mut b = to;
    while b > a && b - 1 < chars.len() && is_layout(chars[b - 1]) {
        b = b - 1;
    }
    return b - a;
}

// The number of leading spaces on the line containing `off`.
fn line_indent_of(_ chars: List<Int>, _ off: Int) -> Int {
    let mut start = off;
    while start > 0 && chars[start - 1] != char.LF {
        start = start - 1;
    }
    let mut n = 0;
    while start + n < chars.len() && chars[start + n] == char.SPACE {
        n = n + 1;
    }
    return n;
}

fn is_layout(_ c: Int) -> Bool {
    return c == char.SPACE || c == char.TAB || c == char.CR || c == char.LF;
}

const LPAREN: Int = 40;
const LBRACKET: Int = 91;
const LBRACE: Int = 123;
const COMMA: Int = 44;
const COLON: Int = 58;

// The width the line spanning `[from, to)` would keep if it were cut at the
// first of `breaks` falling on it — everything past that break moves down, so
// this is what the line is left with. `-1` when no break falls on the line, i.e.
// the group has nothing to offer it.
fn head_width(_ breaks: List<Int>, _ from: Int, _ to: Int) -> Int {
    for o in breaks {
        if o >= from && o <= to {
            return o - from;
        }
    }
    return -1;
}

// A group's break points minus the ones already taken — inserting a newline
// where the author (or an earlier round) already put one would open a blank line.
fn usable_breaks(_ p: Pair, _ chars: List<Int>) -> List<Int> {
    let out: List<Int> = [];
    for b in p.breaks {
        if !at_line_boundary(chars, b) {
            out.push(b);
        }
    }
    return out;
}

// Whether offset `off` already sits at a line boundary — a newline immediately
// follows it (`,⏎`, the "after" break points) or immediately precedes it
// (`⏎    )`, the "before the closer" point), ignoring horizontal whitespace.
fn at_line_boundary(_ chars: List<Int>, _ off: Int) -> Bool {
    let mut i = off;
    while i < chars.len() {
        let c = chars[i];
        if c == char.LF {
            return true;
        }
        if c != char.SPACE && c != char.TAB && c != char.CR {
            i = chars.len();
        } else {
            i = i + 1;
        }
    }
    let mut j = off - 1;
    while j >= 0 {
        let c = chars[j];
        if c == char.LF {
            return true;
        }
        if c != char.SPACE && c != char.TAB && c != char.CR {
            return false;
        }
        j = j - 1;
    }
    return false;
}

// The offset just past the last content character before the closer — where a
// trailing comma belongs. Inserting at the closer itself would land *after* the
// indentation, giving `\n    ,)`.
fn end_of_last_element(_ chars: List<Int>, _ p: Pair) -> Int {
    let mut i = p.close;
    while i > p.open + 1 && is_layout(chars[i - 1]) {
        i = i - 1;
    }
    return i;
}

fn contained_in_another(_ p: Pair, _ others: List<Pair>) -> Bool {
    for o in others {
        if o.open < p.open && o.close > p.close {
            return true;
        }
    }
    return false;
}

fn is_opener(_ k: TokenKind) -> Bool {
    return match k {
        LParen => true,
        LBracket => true,
        LBrace => true,
        _ => false,
    };
}

fn is_closer(_ k: TokenKind) -> Bool {
    return match k {
        RParen => true,
        RBracket => true,
        RBrace => true,
        _ => false,
    };
}

fn matches(_ open: TokenKind, _ close: TokenKind) -> Bool {
    return match open {
        LParen => close == TokenKind.RParen,
        LBracket => close == TokenKind.RBracket,
        LBrace => close == TokenKind.RBrace,
        _ => false,
    };
}
