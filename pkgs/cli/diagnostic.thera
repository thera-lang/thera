// The single diagnostic model (audit LD15). Every phase — lex, parse, check,
// codegen, load — produces `Diagnostic` directly; the CLI, the compiler, and the
// LSP are pure renderers over a `List<Diagnostic>` with no per-phase conversion.
//
// `file` is the diagnostic's owning file — the span's `file` (LD7), so an error in
// an imported file is attributed to *that* file, not the entrypoint. None (a
// file-less span, e.g. the hermetic pipeline's) falls back to the path the CLI
// prints against.

import 'source'; // SourceSpan
import 'edit/edit'; // TextEdit — a fixable diagnostic carries its own edit

// How loud a diagnostic is. An `Error` is invalid code and blocks compile/run; a
// `Warning` is legal-but-probably-a-bug — reported by `thera check` (and the LSP)
// without gating anything. `Info` is reserved for lint-style suggestions riding the
// same model later.
pub enum Severity {
    Error,
    Warning,
    Info,
}

// A uniform diagnostic across the phases (each phase's message is structurally a
// message + a span; this is the common currency the front-end reports).
pub struct Diagnostic {
    let message: String;
    let span: source.SourceSpan;
    let file: Option<String>;
    let severity: Severity;
    // The kebab-case rule name, for suppressable diagnostics (warnings): the key a
    // `// ignore: <rule>` comment names. Errors carry None — they are not
    // suppressable and not configurable.
    let rule: Option<String>;
    // The mechanical fix, when the diagnostic has exactly one — the edit
    // `thera check --fix` applies (and an LSP quickfix would offer). It edits the
    // diagnostic's own file, so a batch is grouped by `file` before applying. Most
    // diagnostics carry None: a fix earns its place only when the rewrite is
    // unambiguous and behavior-preserving.
    //
    // Independent of severity: a fix is about *repair*, a rule is about
    // suppressability, and an error may well be mechanically fixable (a missing
    // argument label is). So `fix` may be Some on either severity, while `rule`
    // stays warning-only.
    let fix: Option<edit.TextEdit>;
}

impl Display for Diagnostic {
    pub fn to_string(self) -> String {
        return '${self.span}: ${self.message}';
    }
}

// An `Error` diagnostic whose owning file is derived from the span (the span knows
// its file; a file-less hermetic span yields None).
pub fn at(message: String, span: source.SourceSpan) -> Diagnostic {
    return at_fix(message, span, Option.None);
}

// An `Error` carrying a mechanical fix — the edit that resolves it, applied by
// `thera check --fix`. Still carries no rule: an error is not suppressable, and
// being fixable does not change that. `fix` is None for the plain case (`at` above
// delegates here), so one constructor covers both.
pub fn at_fix(
    message: String,
    span: source.SourceSpan,
    fix: Option<edit.TextEdit>,
) -> Diagnostic {
    let file = if span.file == '' { Option.None } else { Option.Some(span.file) };
    return Diagnostic {
        message: message,
        span: span,
        file: file,
        severity: Severity.Error,
        rule: Option.None,
        fix: fix,
    };
}

// An `Error` diagnostic attributed to an explicit owning file — used by the loader,
// which stamps each import-closure error with the file it came from regardless of
// the span's own key.
pub fn in_file(message: String, span: source.SourceSpan, file: String) -> Diagnostic {
    return Diagnostic {
        message: message,
        span: span,
        file: Option.Some(file),
        severity: Severity.Error,
        rule: Option.None,
        fix: Option.None,
    };
}

// A `Warning` diagnostic: a named, suppressable rule (`// ignore: <rule>` on the
// offending line, or the line above, silences it at that site).
pub fn warning(message: String, span: source.SourceSpan, rule: String) -> Diagnostic {
    return warning_fix(message, span, rule, Option.None);
}

// A `Warning` carrying a mechanical fix — the edit that resolves it, applied by
// `thera check --fix`. `fix` is None for the plain case (`warning` above delegates
// here), so one constructor covers both.
pub fn warning_fix(
    message: String,
    span: source.SourceSpan,
    rule: String,
    fix: Option<edit.TextEdit>,
) -> Diagnostic {
    let file = if span.file == '' { Option.None } else { Option.Some(span.file) };
    return Diagnostic {
        message: message,
        span: span,
        file: file,
        severity: Severity.Warning,
        rule: Option.Some(rule),
        fix: fix,
    };
}

// Whether `d` is an error (the severity that gates compile/run/exit codes) — the
// filter every gate uses now that warnings share the diagnostics list.
pub fn is_error(d: Diagnostic) -> Bool {
    return match d.severity {
        Error => true,
        _ => false,
    };
}

// How many entries are errors (gates key on this, not `len()`).
pub fn error_count(diags: List<Diagnostic>) -> Int {
    return diags.filter((d) => is_error(d)).len();
}
