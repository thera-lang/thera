// End-to-end tests for comment-prose reflow: whole source in, whole source out.
//
// The per-piece behavior is pinned in blocks_test / wrap_test / runs_test; these
// cases are about the join — rendering, the guard, and idempotency.
//
// Widths here are small but not tiny: a run whose prose budget falls under
// [MIN_CONTENT] is skipped outright, so a fixture at width 20 would test nothing.
// `//` at indent 0 needs width 27 before anything happens at all.

import std.testing;

import 'prose' as _;

// Reflow at `width`, asserting the result *and* that reflowing it again changes
// nothing. Every case is therefore an idempotency assertion.
fn check(src: String, want: String, width: Int) -> Result<Void, Error> {
    let once = reflow_prose(src, width);
    testing.assert_eq(actual: once.text, expected: want)?;
    testing.assert_eq(actual: reflow_prose(once.text, width).text, expected: want)?;
    testing.assert(!once.fell_back)?;
    return Result.Ok(void);
}

@test
fn refills_a_paragraph_to_the_margin() -> Result<Void, Error> {
    return check(
        '// alpha beta\n// gamma delta epsilon zeta eta theta\nfn f() {}\n',
        '// alpha beta gamma delta epsilon zeta\n// eta theta\nfn f() {}\n',
        40,
    );
}

@test
fn the_budget_pays_for_the_indent_and_the_marker() -> Result<Void, Error> {
    // Same margin as above, but four columns of indent and a three-character marker
    // come out of the prose: 32 columns of words instead of 37.
    return check(
        'fn f() {\n    /// alpha beta gamma delta epsilon zeta eta\n}\n',
        'fn f() {\n    /// alpha beta gamma delta epsilon\n    /// zeta eta\n}\n',
        40,
    );
}

@test
fn paragraphs_stay_separated() -> Result<Void, Error> {
    return check('/// one two\n///\n/// three four\n', '/// one two\n///\n/// three four\n', 40);
}

@test
fn a_separator_line_renders_as_a_bare_marker() -> Result<Void, Error> {
    // Never `'/// '` — a trailing space would survive to disk and be trimmed by the
    // *next* run's line layout, so `fmt --check` would never settle.
    let src = '/// a b c d e f g h i j k l m n o p q r s t u v w x y z\n///\n/// tail\n';
    let out = reflow_prose(src, 30).text;
    testing.assert(out.contains('\n///\n'))?;
    return testing.assert(!out.contains('/// \n'));
}

@test
fn a_fenced_block_is_untouched() -> Result<Void, Error> {
    // The prose above it refills; the fence keeps its own line structure and its
    // deliberately odd interior spacing.
    return check(
        '/// intro words here that go on for a good while longer\n'
        + '/// ```thera\n/// let x =    1;\n/// ```\n',
        '/// intro words here that go on for a\n/// good while longer\n'
        + '/// ```thera\n/// let x =    1;\n/// ```\n',
        40,
    );
}

@test
fn a_list_is_untouched() -> Result<Void, Error> {
    return check(
        '/// lead in words that run on for a good long while here\n'
        + '/// - first item that is long\n///   hanging under it\n',
        '/// lead in words that run on for a good\n/// long while here\n'
        + '/// - first item that is long\n///   hanging under it\n',
        40,
    );
}

@test
fn a_trailing_comment_is_never_rewrapped() -> Result<Void, Error> {
    // It cannot be — moving it would move code.
    return check(
        'let x = 1; // a very long trailing note indeed that runs on\n',
        'let x = 1; // a very long trailing note indeed that runs on\n',
        30,
    );
}

@test
fn an_unbalanced_span_leaves_its_block_alone() -> Result<Void, Error> {
    // The scanner cannot tell where the span was meant to end, so the paragraph is
    // copied rather than guessed at.
    return check(
        '// an odd ` backtick here and more words that go on\n',
        '// an odd ` backtick here and more words that go on\n',
        30,
    );
}

@test
fn a_wrap_never_manufactures_a_list_item() -> Result<Void, Error> {
    // `- built-ins` at line start would re-read as a bullet, and the next run would
    // refuse to rejoin it. The `-` stays put, over-width.
    let out = reflow_prose('// same-file names plus these - built-ins go here\n', 30).text;
    testing.assert(!out.contains('\n// - '))?;
    return testing.assert_eq(actual: reflow_prose(out, 30).text, expected: out);
}

@test
fn an_over_long_atom_is_left_over_width() -> Result<Void, Error> {
    // The same answer the code side gives a long string literal: the margin is a
    // target, not a guarantee.
    return check(
        '// see `a-single-unbreakable-code-span-here-indeed` now\n',
        '// see\n// `a-single-unbreakable-code-span-here-indeed`\n// now\n',
        40,
    );
}

@test
fn a_deeply_indented_run_is_left_alone() -> Result<Void, Error> {
    // Below `MIN_CONTENT` the wrap would be a column of one-word lines, which is
    // worse than the input whatever the input was.
    let src = 'fn f() {\n' + ' '.repeat(20) + '// some words that will not be touched\n}\n';
    return check(src, src, 30);
}

@test
fn code_and_strings_are_untouched() -> Result<Void, Error> {
    // The pass edits comment spans and nothing else; a `//` inside a string is not
    // a comment.
    let src = 'fn f() -> String {\n    return \'not // a comment at all here ok\';\n}\n';
    return check(src, src, 30);
}
