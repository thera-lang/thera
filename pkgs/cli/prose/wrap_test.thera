// Tests for atom scanning and greedy filling.
//
// The atom cases carry more weight than they look: the guard normalizes whitespace
// before comparing prose, so it cannot see a code span whose interior spacing was
// mangled. These are the only check on that.

import std.testing;

import 'wrap' as _;

// The atoms of `text`, joined with `|` so a case reads as one string. `?` on the
// `None` case is deliberate — a test that expected atoms and got none should fail
// loudly.
fn atoms(text: String) -> Result<String, Error> {
    let Some(xs) = atoms_of(text) else {
        throw error('unbalanced delimiter in: ${text}');
    };
    return xs.join('|');
}

@test
fn plain_words_split_on_spaces() -> Result<Void, Error> {
    return testing.assert_eq(actual: atoms('one two three')?, expected: 'one|two|three');
}

@test
fn a_code_span_is_one_atom_with_its_punctuation() -> Result<Void, Error> {
    // The whole point: no split on punctuation, so the span keeps the parens and
    // commas that touch it and cannot be rejoined with stray spaces.
    return testing.assert_eq(
        actual: atoms('handlers (`hover`, `definition`, …) run')?,
        expected: 'handlers|(`hover`,|`definition`,|…)|run',
    );
}

@test
fn spacing_inside_a_code_span_survives() -> Result<Void, Error> {
    // `fn  foo( a:Int )` shows squished-and-loose spacing on purpose; a wrap that
    // normalized it would silently rewrite the example the prose is about.
    return testing.assert_eq(
        actual: atoms('spacing like `fn  foo( a:Int )` collapses')?,
        expected: 'spacing|like|`fn  foo( a:Int )`|collapses',
    );
}

@test
fn a_symbol_reference_is_one_atom() -> Result<Void, Error> {
    return testing.assert_eq(
        actual: atoms('see [String.slice] and [fs.read_text] now')?,
        expected: 'see|[String.slice]|and|[fs.read_text]|now',
    );
}

@test
fn a_link_keeps_its_destination() -> Result<Void, Error> {
    // Breaking between `]` and `(` would break the link outright; breaking inside a
    // destination that holds a space would too.
    return testing.assert_eq(
        actual: atoms('read [the docs](../a b.md) first')?,
        expected: 'read|[the docs](../a b.md)|first',
    );
}

@test
fn a_space_between_bracket_and_paren_is_not_a_link() -> Result<Void, Error> {
    return testing.assert_eq(actual: atoms('[Foo] (aside)')?, expected: '[Foo]|(aside)');
}

@test
fn an_unbalanced_delimiter_yields_none() -> Result<Void, Error> {
    // The caller emits the block untouched rather than guessing where the span was
    // meant to end.
    testing.assert(atoms_of('an odd ` backtick').is_none())?;
    testing.assert(atoms_of('an open [ bracket').is_none())?;
    return Result.Ok(void);
}

@test
fn atoms_are_measured_in_code_points() -> Result<Void, Error> {
    // `⏎` is one atom of length 1, not its byte length — the corpus uses it inline
    // to show a line break.
    let Some(xs) = atoms_of('a ⏎ b') else {
        throw error('unexpected None');
    };
    return testing.assert_eq(actual: xs[1].len(), expected: 1);
}

// --- filling ---

fn filled(text: String, avail: Int) -> Result<String, Error> {
    let Some(xs) = atoms_of(text) else {
        throw error('unbalanced delimiter in: ${text}');
    };
    return wrap_atoms(xs, avail).join('/');
}

@test
fn fills_greedily_to_the_margin() -> Result<Void, Error> {
    return testing.assert_eq(
        actual: filled('aaa bbb ccc ddd eee', 11)?,
        expected: 'aaa bbb ccc/ddd eee',
    );
}

@test
fn an_atom_wider_than_the_margin_gets_its_own_line() -> Result<Void, Error> {
    // Unavoidable, and the same answer the code side gives a long string literal:
    // the margin is a target, not a guarantee.
    return testing.assert_eq(
        actual: filled('a `a-very-long-span-indeed` b', 10)?,
        expected: 'a/`a-very-long-span-indeed`/b',
    );
}

@test
fn never_breaks_before_a_bullet_atom() -> Result<Void, Error> {
    // `- built-ins` at line start would re-read as a list item, and the next
    // `thera fmt` would refuse to rejoin it. The `-` stays on the long line.
    return testing.assert_eq(
        actual: filled('names plus these - built-ins here', 16)?,
        expected: 'names plus these -/built-ins here',
    );
}

@test
fn never_breaks_before_an_ordered_item_atom() -> Result<Void, Error> {
    // The real corpus case: `…an empty body on a / 304. The status…`.
    return testing.assert_eq(
        actual: filled('empty body on a 304. The status', 16)?,
        expected: 'empty body on a 304./The status',
    );
}

@test
fn never_leaves_a_lone_bold_label_on_a_line() -> Result<Void, Error> {
    // A line holding only `**Note:**` would re-read as a label paragraph, so it
    // keeps the following atom even though that overflows. Only reachable when the
    // label leads the block — nothing ever breaks *before* it.
    return testing.assert_eq(
        actual: filled('**Note:** wideish-word-here and more', 12)?,
        expected: '**Note:** wideish-word-here/and more',
    );
}

@test
fn wrapping_is_idempotent() -> Result<Void, Error> {
    // Filling the result again must not move anything — the property the whole pass
    // rests on.
    let once = filled('names plus these - built-ins here and more words', 16)?;
    let again = filled(once.replace('/', ' '), 16)?;
    return testing.assert_eq(actual: again, expected: once);
}

@test
fn never_starts_a_line_with_a_commonmark_construct() -> Result<Void, Error> {
    // Segmentation reads only Thera's documented subset, so `*`, `+`, `#`, `>` and
    // `|` are prose to *this* pass — but a doc renderer is likely to be a full
    // CommonMark one, so the wrapper still refuses to create such a line.
    testing.assert_eq(
        actual: filled('names and these + built-ins here', 16)?,
        expected: 'names and these +/built-ins here',
    )?;
    testing.assert_eq(
        actual: filled('the value is # hash here', 12)?,
        expected: 'the value is #/hash here',
    )?;
    return testing.assert_eq(
        actual: filled('a table row | cell two', 11)?,
        expected: 'a table row |/cell two',
    );
}

@test
fn never_starts_a_line_with_a_rule() -> Result<Void, Error> {
    // `---` under a paragraph is a setext heading; alone it is a thematic break.
    return testing.assert_eq(
        actual: filled('some words --- more words', 10)?,
        expected: 'some words ---/more words',
    );
}
