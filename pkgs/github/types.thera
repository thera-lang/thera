// The schemas these three operations return, and the decoders that read them.
//
// **Every type here is a documented subset.** `pull-request-simple` has 37
// properties and `issue` has 40; `head.repo` is a whole `repository`, which is most
// of why the three-operation closure is 28 schemas. Modeling them completely would
// be a generator's job and would teach us nothing this file cannot. What is *not*
// truncated is the set of constructs: every row of docs/api-access.md § Typed
// JSON's mapping table that Anthropic could not reach is exercised here on a field
// GitHub really sends.
//
// Four things the real description does that are worth naming, because each one is
// a decision a generator has to make and none of them is visible from the mapping
// table:
//
//  1. **Nullability hides behind a `$ref`.** OpenAPI 3.0 cannot say "a nullable
//     `$ref`", so GitHub ships a byte-identical duplicate schema — `nullable-simple-user`
//     beside `simple-user` — and points at that. `user` is *required* and still
//     `Option<User>`, and the only way to know is to resolve the ref. A generator that
//     maps schemas to types one-for-one emits `User` and `NullableUser`; collapsing
//     them is a manifest rule, not something the spec asks for.
//  2. **The same concept has three shapes.** A label is `components/schemas/label`, or
//     `pull-request-simple`'s inline object (same fields, different nullability), or
//     `issue`'s untagged `oneOf` of string-or-object. One `Label` struct covers the
//     object forms here; a generator faithful to the spec would emit three types, two
//     of them anonymous and needing invented names.
//  3. **`required` is not the same question as nullable, and both land on `Option`.**
//     `body` is required-and-nullable; `draft` is simply absent from `required`. Both
//     decode to `Option`, which is right for reading and loses a distinction that
//     matters for writing — see `requests.thera`'s note on clearing a field.
//  4. **`type` is a Thera keyword.** `simple-user.type` cannot be a field name, so it
//     is `type_` here. A generator needs a mechanical, stable escape for the keyword
//     set, and appending `_` is the one that never collides with a real GitHub key.

import std.json;
import std.time;

// --- reading the formats ---

/// A `format: date-time` string as a `time.DateTime`.
///
/// The first reader whose failure does not come from `std.json`: `parse_rfc3339`
/// returns a plain `Error`, and what a caller needs is a `DecodeError` naming the
/// path. `Cursor.unexpected` is exactly that hole, which is a small vindication of
/// having put it in the library rather than making each decoder invent its own
/// message.
///
/// This is also the case that `Option.map` cannot express — the conversion can fail
/// — so the nested `match` below is what the absence of a `try_map` costs. Note
/// where that cost lands: **once per format**, in a helper, not once per field.
/// Twelve thousand `format` occurrences in GitHub's description reduce to a handful
/// of functions like this one.
pub fn date_time_at(_ at: json.Cursor) -> Result<time.DateTime, json.DecodeError> {
    let text = at.string()?;
    return match time.DateTime.parse_rfc3339(text) {
        Ok(when) => Result.Ok(when),
        Err(_) => at.unexpected('an RFC 3339 date-time'),
    };
}

/// `date_time_at` for a field that may be `null` or absent.
pub fn opt_date_time_at(_ at: json.Cursor) -> Result<Option<time.DateTime>, json.DecodeError> {
    return match at.opt_string()? {
        Some(text) => match time.DateTime.parse_rfc3339(text) {
            Ok(when) => Result.Ok(Option.Some(when)),
            Err(_) => at.unexpected('an RFC 3339 date-time'),
        },
        None => Result.Ok(Option.None),
    };
}

/// `decode` applied to a value that may be `null` or absent — the reader for every
/// nullable `$ref` in the description, of which there are a great many.
pub fn optional<T>(
    _ at: json.Cursor,
    _ decode: (json.Cursor) -> Result<T, json.DecodeError>,
) -> Result<Option<T>, json.DecodeError> {
    return match at.opt_object()? {
        Some(inner) => Result.Ok(Option.Some(decode(inner)?)),
        None => Result.Ok(Option.None),
    };
}

/// `decode` applied to each element of an array.
///
/// The three lines this replaces (`let mut xs = []; for … { xs.push(…) }`) are what
/// every array field in `pkgs/anthropic` costs, and there is one array field per
/// list-shaped response in the whole of GitHub. Both this and `optional` want to be
/// `Cursor` methods in `std.json`; see docs/typed-json.md § The delta.
pub fn each<T>(
    _ at: json.Cursor,
    _ decode: (json.Cursor) -> Result<T, json.DecodeError>,
) -> Result<List<T>, json.DecodeError> {
    let items: List<T> = [];
    for element in at.list()? {
        items.push(decode(element)?);
    }
    return Result.Ok(items);
}

// --- users ---

/// A GitHub account, from `simple-user` — or from `nullable-simple-user`, which is
/// the same schema with `nullable: true` and is what every `user` field actually
/// points at.
pub struct User {
    let login: String;
    let id: Int;
    /// `'User'`, `'Organization'`, or `'Bot'`. Spelled `type_` because `type` is a
    /// Thera keyword — see the note at the top of this file.
    let type_: String;
    let site_admin: Bool;
    let html_url: String;
}

pub fn user_from_json(_ at: json.Cursor) -> Result<User, json.DecodeError> {
    let root = at.object()?;
    return Result.Ok(User {
        login: root.field('login').string()?,
        id: root.field('id').int()?,
        type_: root.field('type').string()?,
        site_admin: root.field('site_admin').bool()?,
        html_url: root.field('html_url').string()?,
    });
}

// --- labels ---

/// A label in its object form. `description` is nullable in
/// `components/schemas/label` and non-nullable in the copy inlined into
/// `pull-request-simple`; `Option` is the honest reading of the union, and the
/// stricter of two shapes is never the safe one to assume.
pub struct Label {
    let id: Int;
    let name: String;
    let color: String;
    let description: Option<String>;
}

pub fn label_from_json(_ at: json.Cursor) -> Result<Label, json.DecodeError> {
    let root = at.object()?;
    return Result.Ok(Label {
        id: root.field('id').int()?,
        name: root.field('name').string()?,
        color: root.field('color').string()?,
        description: root.field('description').opt_string()?,
    });
}

/// A label as an issue reports it:
/// `{"oneOf": [{"type": "string"}, {"type": "object"…}]}` — an **untagged
/// `oneOf`**, and the mapping-table row nothing on the slate had exercised until
/// now.
///
/// It decodes cleanly, and the reason is worth stating: an untagged union is only
/// decodable when the branches differ by JSON *kind*, and then `Json.kind()` is the
/// discriminator the spec failed to declare. That is the general rule a generator
/// can apply — one variant per branch, dispatch on `kind()`, and refuse to emit
/// anything at all when two branches share a kind, because at that point the
/// document is genuinely ambiguous and guessing is worse than failing.
pub enum IssueLabel {
    /// The string form: just the label's name.
    Name(String),
    /// The object form.
    Full(Label),
}

impl IssueLabel {
    /// The label's name, whichever form it arrived in — which is what a caller
    /// almost always wants, and the reason the union is not a leaky abstraction
    /// here.
    pub fn name(self) -> String {
        return match self {
            Name(n) => n,
            Full(l) => l.name,
        };
    }
}

pub fn issue_label_from_json(_ at: json.Cursor) -> Result<IssueLabel, json.DecodeError> {
    return match at.raw()?.kind() {
        'string' => Result.Ok(IssueLabel.Name(at.string()?)),
        'object' => Result.Ok(IssueLabel.Full(label_from_json(at)?)),
        _ => at.unexpected('a label name or object'),
    };
}

// --- branch endpoints ---

/// One end of a pull request. The spec's `head`/`base` are inline objects carrying
/// a whole `repository` and a `nullable-simple-user`; this keeps the three fields
/// that identify the branch, which is what a client that is not a repository
/// browser needs.
pub struct Ref {
    /// `owner:branch` — qualified, so a fork's branch is unambiguous.
    let label: String;
    let ref: String;
    let sha: String;
}

pub fn ref_from_json(_ at: json.Cursor) -> Result<Ref, json.DecodeError> {
    let root = at.object()?;
    return Result.Ok(Ref {
        label: root.field('label').string()?,
        ref: root.field('ref').string()?,
        sha: root.field('sha').string()?,
    });
}

// --- pull requests ---

/// A pull request as the list endpoint returns it (`pull-request-simple`).
///
/// **Not the same type `create` returns.** `pulls/list` answers with
/// `pull-request-simple` and `pulls/create` with `pull-request` — a wider schema
/// with the merge state, review counts, and diff statistics. Two types, and no
/// caller can pass one where the other belongs. That is the spec's decision, not
/// ours, and it is worth knowing before a generator makes it 1220 times: the reflex
/// to "return the resource type" is wrong, because operations on one resource
/// return *different* resource types.
pub struct PullRequest {
    let number: Int;
    let title: String;
    /// `'open'` or `'closed'` — declared as a bare `string`, not an `enum`, so
    /// there is nothing here for a generator to turn into a Thera enum. (Compare
    /// Anthropic's `stop_reason`, which *is* declared as one.)
    let state: String;
    /// Required and nullable: an empty description sends `null`, not `""`.
    let body: Option<String>;
    /// **Absent** from the schema's `required` list, so `Option<Bool>` — three
    /// states for a two-state fact, and a caller that wants a `Bool` writes
    /// `.unwrap_or(false)`. GitHub does send it; the description does not promise
    /// to.
    let draft: Option<Bool>;
    /// Required, and still optional: the field points at `nullable-simple-user`. A
    /// deleted account is how it comes back `null`.
    let user: Option<User>;
    let head: Ref;
    let base: Ref;
    let labels: List<Label>;
    let created_at: time.DateTime;
    let updated_at: time.DateTime;
    let closed_at: Option<time.DateTime>;
    /// `Some` only if it was merged — the field that makes `closed_at`
    /// insufficient.
    let merged_at: Option<time.DateTime>;
    let merge_commit_sha: Option<String>;
    let html_url: String;
}

impl PullRequest {
    /// Whether the pull request has been merged, as opposed to merely closed.
    pub fn is_merged(self) -> Bool {
        return self.merged_at.is_some();
    }
}

pub fn pull_request_from_json(_ at: json.Cursor) -> Result<PullRequest, json.DecodeError> {
    let root = at.object()?;
    return Result.Ok(PullRequest {
        number: root.field('number').int()?,
        title: root.field('title').string()?,
        state: root.field('state').string()?,
        body: root.field('body').opt_string()?,
        draft: root.field('draft').opt_bool()?,
        user: optional(root.field('user'), user_from_json)?,
        head: ref_from_json(root.field('head'))?,
        base: ref_from_json(root.field('base'))?,
        labels: each(root.field('labels'), label_from_json)?,
        created_at: date_time_at(root.field('created_at'))?,
        updated_at: date_time_at(root.field('updated_at'))?,
        closed_at: opt_date_time_at(root.field('closed_at'))?,
        merged_at: opt_date_time_at(root.field('merged_at'))?,
        merge_commit_sha: root.field('merge_commit_sha').opt_string()?,
        html_url: root.field('html_url').string()?,
    });
}

// --- issues ---

/// An issue (`issue`), as `issues/create` returns it.
pub struct Issue {
    let number: Int;
    let title: String;
    let state: String;
    let body: Option<String>;
    let user: Option<User>;
    let assignee: Option<User>;
    /// The untagged union — see `IssueLabel`.
    let labels: List<IssueLabel>;
    let created_at: time.DateTime;
    let updated_at: time.DateTime;
    let closed_at: Option<time.DateTime>;
    let html_url: String;
    /// True when this "issue" is really a pull request.
    ///
    /// GitHub's issues endpoints return both, and the way to tell them apart is the
    /// **presence of a `pull_request` key** — not a type field, not a status, and
    /// nothing the description marks as significant (it is just an optional
    /// object). A generator emits `pull_request: Option<IssuePullRequest>` and is
    /// not wrong; it simply cannot know that the *only* thing most callers want
    /// from that field is whether it was there. Filtering pull requests out of an
    /// issue list is the single most common thing anyone does with this endpoint,
    /// and it is invisible from the spec — manifest territory, again.
    let is_pull_request: Bool;
}

pub fn issue_from_json(_ at: json.Cursor) -> Result<Issue, json.DecodeError> {
    let root = at.object()?;
    return Result.Ok(Issue {
        number: root.field('number').int()?,
        title: root.field('title').string()?,
        state: root.field('state').string()?,
        body: root.field('body').opt_string()?,
        user: optional(root.field('user'), user_from_json)?,
        assignee: optional(root.field('assignee'), user_from_json)?,
        labels: each(root.field('labels'), issue_label_from_json)?,
        created_at: date_time_at(root.field('created_at'))?,
        updated_at: date_time_at(root.field('updated_at'))?,
        closed_at: opt_date_time_at(root.field('closed_at'))?,
        html_url: root.field('html_url').string()?,
        is_pull_request: root.field('pull_request').opt_object()?.is_some(),
    });
}
